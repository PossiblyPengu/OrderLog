<helpers:AnimatedWindow x:Class="OrderLog.Windows.OrderLogWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OrderLog.Helpers"
        xmlns:views="clr-namespace:OrderLog.Features.Views"
        Title="Orders" 
        Width="380" Height="700"
        MinWidth="340" MinHeight="400"
        MaxWidth="600"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Theme will be applied via code-behind based on ThemeService -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Marathon 2026 — Tactical HUD Window Chrome -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="0"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="22" ShadowDepth="0" Opacity="0.65" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2"/>
                <!-- accent stripe -->
                <RowDefinition Height="36"/>
                <!-- title bar -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top accent stripe — Marathon 2026 viridian -->
            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

            <!-- Title bar -->
            <Border Grid.Row="1"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: tactical label -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                Margin="10,0,0,0" VerticalAlignment="Center">
                        <!-- green indicator bracket -->
                        <Border Width="3" Height="16" Background="{DynamicResource AccentBrush}" Margin="0,0,7,0"/>
                        <TextBlock Text="ORDER LOG"
                                   FontFamily="JetBrains Mono, Cascadia Code, Consolas, Courier New"
                                   FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource TitleBarTextBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Right: window controls -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                Margin="0,0,4,0" VerticalAlignment="Center">

                        <!-- Dock left -->
                        <Button x:Name="DockLeftButton" Click="DockLeft_Click" ToolTip="Dock left"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                                        <TextBlock Text="◀" FontSize="10"
                                                   Foreground="{DynamicResource TitleBarTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Dock right -->
                        <Button x:Name="DockRightButton" Click="DockRight_Click" ToolTip="Dock right"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                                        <TextBlock Text="▶" FontSize="10"
                                                   Foreground="{DynamicResource TitleBarTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Minimize -->
                        <Button Click="MinimizeButton_Click" ToolTip="Minimize"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand" Margin="0,0,2,0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                                        <TextBlock Text="─" FontSize="10"
                                                   Foreground="{DynamicResource TitleBarTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-1,0,0"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Close -->
                        <Button Click="CloseButton_Click" ToolTip="Close"
                                Width="28" Height="28" Background="Transparent" BorderThickness="0"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="0">
                                        <TextBlock Text="✕" FontSize="10"
                                                   Foreground="{DynamicResource TitleBarTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButtonHoverSubtleBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Content -->
            <views:OrderLogWidgetView x:Name="WidgetView" Grid.Row="2"/>
        </Grid>
    </Border>
</helpers:AnimatedWindow>

<helpers:AnimatedWindow x:Class="OrderLog.Windows.OrderLogSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helpers="clr-namespace:OrderLog.Helpers"
        xmlns:views="clr-namespace:OrderLog.Features.Views"
        Title="SS Command Centre Settings"
        Width="480" Height="620"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        Icon="pack://application:,,,/Assets/orderlog.ico">

    <Border x:Name="RootBorder"
            Background="{DynamicResource BackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="{DynamicResource WindowCornerRadius}"
            RenderTransformOrigin="0.5,0.5">
        <Border.RenderTransform>
            <ScaleTransform/>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitleBarBackgroundBrush}"
                    CornerRadius="{DynamicResource TitleBarCornerRadius}"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TitleBarTextBrush}"/>
                    </StackPanel>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="CloseButton_Click" ToolTip="Close"
                            Width="32" Height="32" Background="Transparent"
                            BorderThickness="0" Cursor="Hand" Margin="0,0,4,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSm}">
                                    <TextBlock Text="✕" FontSize="14"
                                               Foreground="{DynamicResource TitleBarTextBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseButtonHoverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Settings Content -->
            <views:OrderLogSettingsView x:Name="SettingsView" Grid.Row="1"/>
        </Grid>
    </Border>
</helpers:AnimatedWindow>

<UserControl x:Class="OrderLog.Features.Views.OrderLogSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OrderLog.Features.Views"
             xmlns:vm="clr-namespace:OrderLog.Features.ViewModels"
             xmlns:converters="clr-namespace:OrderLog.Features.Converters"
             MinHeight="400" MinWidth="400">

    <UserControl.Resources>
        <converters:HexToBrushConverter x:Key="HexToBrush"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Theme option button style -->
        <Style x:Key="ThemeOptionButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Padding="10,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Section Header Style -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,20,0,12"/>
        </Style>

        <!-- Setting Label Style -->
        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Setting Description Style -->
        <Style x:Key="SettingDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <!-- Modern Toggle Style -->
        <Style x:Key="ModernToggle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Background="Transparent" Width="44" Height="24">
                            <Grid>
                                <Border x:Name="Track" CornerRadius="12"
                                        Background="{DynamicResource SurfaceHoverBrush}"/>
                                <Border x:Name="Thumb" Width="18" Height="18" CornerRadius="9"
                                        Background="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left"
                                        Margin="3,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Background" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="23,0,0,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Slider Style -->
        <Style x:Key="ModernSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SurfaceHoverBrush}" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Cursor="Hand">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.3"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Action Button Style -->
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Stat Card Style -->
        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
            <Setter Property="CornerRadius" Value="{DynamicResource CardCornerRadius}"/>
            <Setter Property="Padding" Value="16,12"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer Background="{DynamicResource BackgroundBrush}" VerticalScrollBarVisibility="Auto" Padding="24">
        <StackPanel MaxWidth="420">

            <!-- Header -->
            <TextBlock Text="Order Log Settings" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
            <TextBlock Text="Configure the appearance and behavior of Order Log"
                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>

            <!-- Statistics Row -->
            <UniformGrid Columns="3" Margin="0,16,0,0">
                <Border Style="{StaticResource StatCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="{Binding Items.Count}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Active Orders" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="3,0,3,0">
                    <StackPanel>
                        <TextBlock Text="{Binding ArchivedItems.Count}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="Archived" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StatCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <TextBlock Text="{Binding DisplayItems.Count}" FontSize="24" FontWeight="Bold"
                                   Foreground="{DynamicResource SuccessBrush}"/>
                        <TextBlock Text="Groups" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Appearance Section -->
            <TextBlock Text="APPEARANCE" Style="{StaticResource SectionHeader}"/>

            <!-- ─── Colour Mode ────────────────────────────────────────────── -->
            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dark Mode" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Switch between dark and light interface" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding IsDarkMode, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <!-- ─── Shape Profile ──────────────────────────────────────────── -->
            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Shape Profile" Style="{StaticResource SettingLabel}" Margin="0,0,0,4"/>
                    <TextBlock Text="Controls the corner roundness of UI elements" Style="{StaticResource SettingDescription}" Margin="0,0,0,12"/>
                    <UniformGrid Columns="3">

                        <!-- Angular -->
                        <Button x:Name="ShapeAngularBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="0,0,4,0"
                                Click="ShapeAngular_Click"
                                ToolTip="Angular — small radii, tactical feel">
                            <StackPanel>
                                <Border Width="48" Height="28" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="3" HorizontalAlignment="Center">
                                    <Grid Margin="4">
                                        <Border Width="14" Height="8" Background="{DynamicResource AccentBrush}"
                                                CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Height="3" Background="{DynamicResource BorderBrush}"
                                                CornerRadius="0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Angular" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Rounded -->
                        <Button x:Name="ShapeRoundedBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="2,0,2,0"
                                Click="ShapeRounded_Click"
                                ToolTip="Rounded — generous radii, Fluent/WinUI feel">
                            <StackPanel>
                                <Border Width="48" Height="28" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" HorizontalAlignment="Center">
                                    <Grid Margin="5">
                                        <Border Width="14" Height="8" Background="{DynamicResource AccentBrush}"
                                                CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Height="3" Background="{DynamicResource BorderBrush}"
                                                CornerRadius="2" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Rounded" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Sharp -->
                        <Button x:Name="ShapeSharpBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="4,0,0,0"
                                Click="ShapeSharp_Click"
                                ToolTip="Sharp — zero radii, brutalist feel">
                            <StackPanel>
                                <Border Width="48" Height="28" Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="0" HorizontalAlignment="Center">
                                    <Grid Margin="4">
                                        <Border Width="14" Height="8" Background="{DynamicResource AccentBrush}"
                                                CornerRadius="0" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                        <Border Height="3" Background="{DynamicResource BorderBrush}"
                                                CornerRadius="0" VerticalAlignment="Bottom"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="Sharp" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Colour Palette -->
            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <StackPanel>
                    <TextBlock Text="Colour Palette" Style="{StaticResource SettingLabel}"/>
                    <TextBlock Text="Choose the accent colour used across the app" Style="{StaticResource SettingDescription}" Margin="0,2,0,12"/>
                    <UniformGrid Rows="1" HorizontalAlignment="Left">

                        <!-- Neon -->
                        <Button x:Name="ColourNeonBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="0,0,4,0"
                                Click="ColourNeon_Click"
                                ToolTip="Neon — default Marathon green">
                            <StackPanel>
                                <Ellipse Width="28" Height="28" Fill="#00FF88" HorizontalAlignment="Center"/>
                                <TextBlock Text="Neon" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Blue -->
                        <Button x:Name="ColourBlueBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="4,0,4,0"
                                Click="ColourBlue_Click"
                                ToolTip="Blue — electric WinUI accent">
                            <StackPanel>
                                <Ellipse Width="28" Height="28" Fill="#60CDFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Blue" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Amber -->
                        <Button x:Name="ColourAmberBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="4,0,4,0"
                                Click="ColourAmber_Click"
                                ToolTip="Amber — solar scanner yellow">
                            <StackPanel>
                                <Ellipse Width="28" Height="28" Fill="#FFD000" HorizontalAlignment="Center"/>
                                <TextBlock Text="Amber" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Red -->
                        <Button x:Name="ColourRedBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="4,0,4,0"
                                Click="ColourRed_Click"
                                ToolTip="Red — critical alert accent">
                            <StackPanel>
                                <Ellipse Width="28" Height="28" Fill="#FF1050" HorizontalAlignment="Center"/>
                                <TextBlock Text="Red" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Purple -->
                        <Button x:Name="ColourPurpleBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="4,0,4,0"
                                Click="ColourPurple_Click"
                                ToolTip="Purple — aeon violet plasma">
                            <StackPanel>
                                <Ellipse Width="28" Height="28" Fill="#C060FF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Purple" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                        <!-- Cyan -->
                        <Button x:Name="ColourCyanBtn"
                                Style="{StaticResource ThemeOptionButton}"
                                Margin="4,0,0,0"
                                Click="ColourCyan_Click"
                                ToolTip="Cyan — cryo ice scanner">
                            <StackPanel>
                                <Ellipse Width="28" Height="28" Fill="#00E5FF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Cyan" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>

                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Card Font Size -->
            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Card Font Size" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Adjust the text size on order cards" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Minimum="10" Maximum="20" Width="120" Style="{StaticResource ModernSlider}"
                                Value="{Binding CardFontSize, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusLg}"
                                Padding="10,4" Margin="12,0,0,0" MinWidth="36">
                            <TextBlock Text="{Binding CardFontSize, StringFormat='{}{0:0}'}"
                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Behavior Section -->
            <TextBlock Text="BEHAVIOR" Style="{StaticResource SectionHeader}"/>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Auto Color by Vendor" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Automatically assign consistent colors based on vendor name" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding AutoColorByVendor, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Show Now Playing" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Display the Now Playing media panel at the bottom" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding ShowNowPlaying, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Show Archived Tab" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Display the archived orders tab in the widget" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding ShowArchived, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Undo Timeout" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Seconds the undo action is available after changes" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Slider Minimum="2" Maximum="15" Width="100" Style="{StaticResource ModernSlider}"
                                Value="{Binding UndoTimeoutSeconds, Mode=TwoWay}"
                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusLg}"
                                Padding="10,4" Margin="12,0,0,0" MinWidth="36">
                            <TextBlock Text="{Binding UndoTimeoutSeconds, StringFormat='{}{0}s'}"
                                       FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Notes Only Mode" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Hide order functionality, use widget for sticky notes only" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding NotesOnlyMode, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Sort Status Descending" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Reverse order of status groups (In Progress at bottom)" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding SortStatusDescending, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <!-- Default Colors Section -->
            <TextBlock Text="DEFAULT COLORS" Style="{StaticResource SectionHeader}"/>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Order Color" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Color used for new order cards" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{Binding DefaultOrderColor, Converter={StaticResource HexToBrush}}"
                            Cursor="Hand" MouseLeftButtonDown="PickOrderColor_Click" ToolTip="Click to change"/>
                </Grid>
            </Border>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Default Sticky Note Color" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Color used for new sticky notes" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="32" Height="32" CornerRadius="{DynamicResource RadiusMd}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            Background="{Binding DefaultNoteColor, Converter={StaticResource HexToBrush}}"
                            Cursor="Hand" MouseLeftButtonDown="PickNoteColor_Click" ToolTip="Click to change"/>
                </Grid>
            </Border>

            <!-- System Section -->
            <TextBlock Text="SYSTEM" Style="{StaticResource SectionHeader}"/>

            <Border Background="{DynamicResource SurfaceHoverBrush}" CornerRadius="{DynamicResource CardCornerRadius}" Padding="16" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Run at Startup" Style="{StaticResource SettingLabel}"/>
                        <TextBlock Text="Automatically launch OrderLog when Windows starts" Style="{StaticResource SettingDescription}"/>
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource ModernToggle}" VerticalAlignment="Center"
                              IsChecked="{Binding RunAtStartup, Mode=TwoWay}"/>
                </Grid>
            </Border>

            <!-- Data Management Section -->
            <TextBlock Text="DATA MANAGEMENT" Style="{StaticResource SectionHeader}"/>

            <Button Click="ClearArchived_Click" Style="{StaticResource ActionButton}" Margin="0,0,0,24">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#x1F5D1;" FontSize="16" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="Clear All Archived" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource DangerBrush}"/>
                        <TextBlock Text="Permanently delete all archived orders" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Button>

        </StackPanel>
    </ScrollViewer>
</UserControl>

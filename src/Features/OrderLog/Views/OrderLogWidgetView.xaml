<UserControl x:Class="OrderLog.Features.Views.OrderLogWidgetView"
             x:Name="WidgetRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:OrderLog.Features.Models"
             xmlns:converters="clr-namespace:OrderLog.Features.Converters"
             xmlns:commonConverters="clr-namespace:OrderLog.Converters"
             xmlns:vm="clr-namespace:OrderLog.Features.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:OrderLog.Features.Behaviors"
             KeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Marathon Design System — deep space neon HUD -->
            <ResourceDictionary.MergedDictionaries>
                <!-- Base theme, shape, and colour overlays come from Application.Resources (ThemeService). -->
                <ResourceDictionary Source="../Themes/OrderLogWidgetTheme.xaml"/>
                <ResourceDictionary Source="../Themes/ModernHeaderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <commonConverters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <commonConverters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <commonConverters:LessThanConverter x:Key="LessThanConverter"/>
        <commonConverters:MultiplyConverter x:Key="MultiplyConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToCardBrushConverter x:Key="StatusToCardBrushConverter"/>
        <converters:ShowForOrdersConverter x:Key="ShowForOrdersConverter"/>
        <converters:ShowForNotesConverter x:Key="ShowForNotesConverter"/>
        <converters:LinkedGroupToVisibilityConverter x:Key="LinkedGroupToVisibilityConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <converters:HexToColorConverter x:Key="HexToColorConverter"/>
        <converters:XamlToPlainTextConverter x:Key="XamlToPlainTextConverter"/>
        <converters:IsLinkSourceToBrushConverter x:Key="IsLinkSourceToBrushConverter"/>
        <converters:IsLinkSourceToThicknessConverter x:Key="IsLinkSourceToThicknessConverter"/>

        <!-- Status-coloured ComboBox item style: tinted hover background per status -->
        <Style x:Key="StatusComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MarathonComboBoxItemStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.NotReady}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource WidgetStatusNotReadyBgBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.OnDeck}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource WidgetStatusOnDeckBgBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.InProgress}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource WidgetStatusInProgressBgBrush}"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.Done}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource WidgetStatusDoneBgBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Modern Editable Field Style - Clean inline editing with focus indicator -->
        <Style x:Key="ModernEditableFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusIndicator"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Opacity="0"
                                    SnapsToDevicePixels="True"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusIndicator"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.6" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusIndicator"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Copy Button Style - Enhanced for better UX -->
        <Style x:Key="FieldCopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Copy to clipboard"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Shadow"
                                                  Color="#000000"
                                                  BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                            <Path x:Name="Icon"
                                  Data="M16,1H4C2.9,1,2,1.9,2,3v14h2V3h12V1z M19,5H8C6.9,5,6,5.9,6,7v14c0,1.1,0.9,2,2,2h11c1.1,0,2-0.9,2-2V7C21,5.9,20.1,5,19,5z M19,21H8V7h11V21z"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform"
                                  Width="13"
                                  Height="13"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="4" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.95" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.95" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Note Toolbar Button Style -->
        <Style x:Key="NoteToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource RadiusMd}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <DataTemplate x:Key="OrderItemTemplate" DataType="{x:Type models:OrderItem}">
                    <!-- Outer border for link mode highlighting -->
                    <Border x:Name="LinkHighlightBorder" Margin="6" CornerRadius="{DynamicResource RadiusMd}" Padding="2"
                            Opacity="0"
                            MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="CardLoadSlide"/>
                        </Border.RenderTransform>
                        <Border.BorderBrush>
                            <MultiBinding Converter="{StaticResource IsLinkSourceToBrushConverter}">
                                <Binding Path="."/>
                                <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <MultiBinding Converter="{StaticResource IsLinkSourceToThicknessConverter}">
                                <Binding Path="."/>
                                <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Border.BorderThickness>
                    <Border Style="{StaticResource OrderLogWidgetElevatedCardStyle}" ClipToBounds="True"
                            MouseLeftButtonDown="Card_MouseLeftButtonDown" KeyDown="Card_KeyDown" Focusable="True">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Set Status">
                                    <MenuItem Header="Not Ready" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}"/>
                                    <MenuItem Header="On Deck" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}"/>
                                    <MenuItem Header="In Progress" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}"/>
                                </MenuItem>
                                <MenuItem Header="Reset Timer">
                                    <MenuItem Header="Reset In Progress Timer" Click="ResetInProgressTimer_Click"/>
                                    <MenuItem Header="Reset On Deck Timer" Click="ResetOnDeckTimer_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Reset All Timers" Click="ResetAllTimers_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Change Color..." Click="ChangeColor_Click" CommandParameter="{Binding}"/>
                                <MenuItem Header="Unlink" Click="Unlink_Click" ToolTip="Remove this order from its linked group"/>
                                <Separator/>
                                <MenuItem Header="Archive" Click="QuickArchive_Click" InputGestureText="Del"/>
                                <MenuItem Header="Delete" Click="DeleteNote_Click" Foreground="{DynamicResource DangerBrush}" InputGestureText="Ctrl+Del"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left status stripe -->
                    <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="{DynamicResource CardStripeMdCornerRadius}"
                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                            MouseLeftButtonDown="ColorBar_Click"/>

                    <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10" Margin="0" MinHeight="36" Panel.ZIndex="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Multi-select checkbox (visible when multi-select mode is active) -->
                            <CheckBox Grid.Column="0"
                                      Tag="{Binding}"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                            <!-- Link Count Badge -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="{DynamicResource RadiusSm}"
                                    Padding="8,4"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="This order is linked with other orders"
                                    Visibility="{Binding LinkedItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LinkedItemCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Vendor Name Display -->
                            <Grid Grid.Column="2">
                                <TextBlock Text="Vendor name..."
                                           FontSize="{DynamicResource CardFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextTrimming="None">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VendorName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding VendorName}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding VendorName, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernEditableFieldStyle}"
                                         FontSize="{DynamicResource CardFontSize}"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"
                                         TextWrapping="Wrap"
                                         TabIndex="0"
                                         GotFocus="EditableField_GotFocus"
                                         LostFocus="EditableField_LostFocus"
                                         PreviewKeyDown="EditableField_PreviewKeyDown">
                                    <i:Interaction.Behaviors>
                                        <behaviors:VendorAutocompleteBehavior/>
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </Grid>

                            <!-- Status Selectors -->
                            <Grid Grid.Column="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Responsive ComboBox with stoplight visuals -->
                                <ComboBox x:Name="StatusComboBox"
                                          HorizontalAlignment="Right"
                                          SelectedValue="{Binding Status, Mode=TwoWay}"
                                          SelectedValuePath="Tag"
                                          SelectionChanged="StatusComboBox_SelectionChanged"
                                          TabIndex="1"
                                          FontSize="11"
                                          FontWeight="SemiBold"
                                          MinHeight="26"
                                          Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBoxStyle}">
                                            <Setter Property="Width" Value="110"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Padding" Value="5,3"/>
                                            <Setter Property="MinWidth" Value="56"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <Binding ElementName="WidgetRoot"
                                                                 Path="ActualWidth"
                                                                 Converter="{StaticResource LessThanConverter}"
                                                                 ConverterParameter="350"/>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Width" Value="52"/>
                                                    <Setter Property="Padding" Value="2,0"/>
                                                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                    <ComboBox.Resources>
                                        <!-- Hide text when the control is constrained -->
                                        <Style x:Key="CompactStatusTextStyle" TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Setter Property="Margin" Value="6,0,0,0"/>
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <Binding ElementName="WidgetRoot"
                                                                 Path="ActualWidth"
                                                                 Converter="{StaticResource LessThanConverter}"
                                                                 ConverterParameter="350"/>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Resources>

                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" Style="{StaticResource StatusComboBoxItemStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource WidgetStatusNotReadyBrush}"/>
                                            <TextBlock Text="Not Ready" Style="{StaticResource CompactStatusTextStyle}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}" Style="{StaticResource StatusComboBoxItemStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource WidgetStatusOnDeckBrush}"/>
                                            <TextBlock Text="On Deck" Style="{StaticResource CompactStatusTextStyle}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.InProgress}" Style="{StaticResource StatusComboBoxItemStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource WidgetStatusInProgressBrush}"/>
                                            <TextBlock Text="In Progress" Style="{StaticResource CompactStatusTextStyle}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.Done}" Style="{StaticResource StatusComboBoxItemStyle}">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Ellipse Width="10" Height="10" Fill="{DynamicResource WidgetStatusDoneBrush}"/>
                                            <TextBlock Text="Done" Style="{StaticResource CompactStatusTextStyle}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                            </Grid>

                            <!-- Link Button -->
                            <Button Grid.Column="4" Click="LinkButton_Click" ToolTip="Link with another order" IsTabStop="False"
                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="🔗" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="1" Grid.Row="1" Margin="16,12">
                        <!-- Editable Transfer Numbers -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                    Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}" IsTabStop="False"/>
                            <TextBlock Grid.Column="1" Text="Transfer #s..."
                                       FontSize="{DynamicResource CardFontSize}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TransferNumbers, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernEditableFieldStyle}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="{DynamicResource CardFontSize}"
                                     TabIndex="2"
                                     GotFocus="EditableField_GotFocus"
                                     LostFocus="EditableField_LostFocus"
                                     PreviewKeyDown="EditableField_PreviewKeyDown"/>
                        </Grid>

                        <!-- Editable WHS Shipment Numbers -->
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                    Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}" IsTabStop="False"/>
                            <TextBlock Grid.Column="1" Text="WHS #s..."
                                       FontSize="{DynamicResource CardFontSize}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Text="{Binding WhsShipmentNumbers, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernEditableFieldStyle}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="{DynamicResource CardFontSize}"
                                     TabIndex="3"
                                     GotFocus="EditableField_GotFocus"
                                     LostFocus="EditableField_LostFocus"
                                     PreviewKeyDown="EditableField_PreviewKeyDown"/>
                        </Grid>

                        <!-- TimeInProgress Display -->
                        <TextBlock Text="{Binding TimeInProgressDisplay}"
                                   Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   Margin="0,6,0,0"/>

                        <!-- TimeOnDeck Display -->
                        <TextBlock Text="{Binding TimeOnDeckDisplay}"
                                   Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>

                        <!-- Created timestamp -->
                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            </Border>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="LinkHighlightBorder">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="LinkHighlightBorder"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="CardLoadSlide"
                                             Storyboard.TargetProperty="Y"
                                             From="10" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Modern Sticky Note Template - Clean, minimal design with inline toolbar -->
        <DataTemplate x:Key="StickyNoteTemplate" DataType="{x:Type models:OrderItem}">
            <Border x:Name="StickyNoteBorder" CornerRadius="{DynamicResource RadiusLg}" ClipToBounds="True" Margin="8,0,8,0"
                    BorderThickness="1" Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NoteLoadSlide"/>
                </Border.RenderTransform>
                <Border.Background>
                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" Opacity="0.07"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" Opacity="0.25"/>
                </Border.BorderBrush>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Change Color..." Click="ChangeColor_Click" CommandParameter="{Binding}"/>
                        <MenuItem Header="Category">
                            <MenuItem Header="General" Click="SetNoteCategory_Click" Tag="General"/>
                            <MenuItem Header="To-Do" Click="SetNoteCategory_Click" Tag="Todo"/>
                            <MenuItem Header="Reminder" Click="SetNoteCategory_Click" Tag="Reminder"/>
                            <MenuItem Header="Log" Click="SetNoteCategory_Click" Tag="Log"/>
                            <MenuItem Header="Idea" Click="SetNoteCategory_Click" Tag="Idea"/>
                        </MenuItem>
                        <Separator/>
                        <MenuItem Header="Delete" Click="DeleteNote_Click" Foreground="{DynamicResource DangerBrush}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Left stripe — clickable to change color -->
                    <Button Grid.Column="0" Grid.RowSpan="3"
                            Click="ChangeColor_Click" CommandParameter="{Binding}"
                            ToolTip="Change note color"
                            Cursor="Hand" Focusable="False"
                            IsTabStop="False" Padding="0" BorderThickness="0">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Stripe" CornerRadius="{DynamicResource CardStripeLgCornerRadius}"
                                                    Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                    Opacity="0.7"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Stripe" Property="Opacity" Value="1"/>
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Stripe" Property="Opacity" Value="0.5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Header: title + category badge + actions -->
                    <Grid Grid.Column="1" Grid.Row="0" Margin="12,10,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Title + category -->
                        <StackPanel Grid.Column="0">
                            <!-- Editable note title -->
                            <Grid>
                                <TextBlock Text="Untitled note..."
                                           FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}" FontStyle="Italic"
                                           IsHitTestVisible="False" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoteTitle}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NoteTitle}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding NoteTitle, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernEditableFieldStyle}"
                                         FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         GotFocus="EditableField_GotFocus"
                                         LostFocus="EditableField_LostFocus"
                                         PreviewKeyDown="EditableField_PreviewKeyDown"/>
                            </Grid>

                            <!-- Category badge -->
                            <Border CornerRadius="{DynamicResource RadiusSm}" Padding="5,2" HorizontalAlignment="Left" Margin="0,5,0,0"
                                    BorderThickness="1">
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" Opacity="0.4"/>
                                </Border.BorderBrush>
                                <Border.Background>
                                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" Opacity="0.15"/>
                                </Border.Background>
                                <TextBlock FontSize="9" FontWeight="SemiBold"
                                           Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="GENERAL"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Todo}">
                                                    <Setter Property="Text" Value="TODO"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Reminder}">
                                                    <Setter Property="Text" Value="REMINDER"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Log}">
                                                    <Setter Property="Text" Value="LOG"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Idea}">
                                                    <Setter Property="Text" Value="IDEA"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Archive button (top-right of header) -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <!-- Archive button -->
                            <Button Click="QuickArchive_Click" ToolTip="Delete note"
                                    IsTabStop="False" Focusable="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="5"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Note body -->
                    <Grid Grid.Column="1" Grid.Row="1" Margin="12,0,12,10">
                        <!-- Placeholder -->
                        <TextBlock Text="Write your note..."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontStyle="Italic"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top"
                                   TextWrapping="Wrap"
                                   Margin="2,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoteContent}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoteContent}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Rich text editor -->
                        <RichTextBox x:Name="NoteRichTextBox"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                     FontSize="13"
                                     Padding="0"
                                     MinHeight="64"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Focusable="True"
                                     IsReadOnly="False"
                                     IsUndoEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="True"
                                     PreviewMouseLeftButtonDown="NoteContent_PreviewMouseLeftButtonDown"
                                     PreviewKeyDown="NoteContent_PreviewKeyDown"
                                     Loaded="NoteContent_Loaded"
                                     LostFocus="NoteContent_LostFocus"
                                     GotFocus="EditableField_GotFocus"
                                     Cursor="IBeam">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0,1,0,1"/>
                                    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
                                </Style>
                            </RichTextBox.Resources>
                            <RichTextBox.InputBindings>
                                <KeyBinding Key="B" Modifiers="Control" Command="EditingCommands.ToggleBold"/>
                                <KeyBinding Key="I" Modifiers="Control" Command="EditingCommands.ToggleItalic"/>
                                <KeyBinding Key="U" Modifiers="Control" Command="EditingCommands.ToggleUnderline"/>
                                <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo"/>
                                <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo"/>
                            </RichTextBox.InputBindings>
                        </RichTextBox>
                    </Grid>

                    <!-- Footer: format toolbar + timestamp -->
                    <Border Grid.Column="1" Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            Padding="8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Format buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Click="FormatBold_Click" Tag="{Binding}" ToolTip="Bold (Ctrl+B)" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Click="FormatItalic_Click" Tag="{Binding}" ToolTip="Italic (Ctrl+I)" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="I" FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Click="FormatUnderline_Click" Tag="{Binding}" ToolTip="Underline (Ctrl+U)" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Border Width="1" Height="12" Background="{DynamicResource BorderBrush}" Margin="5,0" VerticalAlignment="Center"/>
                                <Button Click="InsertBullet_Click" Tag="{Binding}" ToolTip="Bullet" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,0"/>
                                </Button>
                                <Button Click="InsertCheckbox_Click" Tag="{Binding}" ToolTip="Checkbox" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="☐" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <Button Click="InsertTimestamp_Click" Tag="{Binding}" ToolTip="Timestamp" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="⏱" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                            </StackPanel>

                            <!-- Created timestamp -->
                            <TextBlock Grid.Column="1"
                                       Text="{Binding CreatedAtDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded" SourceName="StickyNoteBorder">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="StickyNoteBorder"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0" To="1" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="NoteLoadSlide"
                                             Storyboard.TargetProperty="Y"
                                             From="10" To="0" Duration="0:0:0.22">
                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Template for archived Order cards -->
        <DataTemplate x:Key="ArchivedOrderItemTemplate" DataType="{x:Type models:OrderItem}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Restore" Click="UnarchiveNote_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="DeleteArchivedNote_Click" Foreground="{DynamicResource DangerBrush}" InputGestureText="Ctrl+Del"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Color Bar (Done status = muted gray) -->
                    <Border Grid.Row="0" CornerRadius="{DynamicResource CardTopCornerRadius}" Height="{StaticResource CardColorBarHeight}"
                            Background="{DynamicResource TextTertiaryBrush}"/>

                    <!-- Header -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10" Margin="0" MinHeight="36" Panel.ZIndex="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBox Text="{Binding VendorName}" FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam"
                                         Padding="0" Margin="0"/>
                            </StackPanel>

                            <!-- Restore Button -->
                            <Button Grid.Column="1" Click="QuickArchive_Click" ToolTip="Restore" Cursor="Hand" Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="↩️ Restore" FontSize="{DynamicResource CardFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Row="2" Margin="16,14">
                        <TextBox Text="{Binding TransferNumbers}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource CardFontSize}" Margin="0,0,0,4"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        <TextBox Text="{Binding WhsShipmentNumbers}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource CardFontSize}" Margin="0,0,0,4"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        <TextBox Text="{Binding TimeInProgressDisplay}" Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}" FontSize="{DynamicResource CardFontSize}" FontFamily="{DynamicResource FontMono}"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        <TextBox Text="{Binding TimeOnDeckDisplay}" Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}" FontSize="{DynamicResource CardFontSize}" FontFamily="{DynamicResource FontMono}" FontWeight="SemiBold" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                    </StackPanel>
                    
                    <!-- Footer with timestamp -->
                    <TextBlock Grid.Row="3" Text="{Binding CreatedAtDisplay}" FontSize="10"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Right" Margin="0,4,16,8"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for archived Sticky Note cards -->
        <DataTemplate x:Key="ArchivedStickyNoteTemplate" DataType="{x:Type models:OrderItem}">
            <Border Background="{DynamicResource SurfaceHoverBrush}"
                    BorderBrush="{DynamicResource TextDisabledBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Margin="8,0,8,0"
                    ClipToBounds="True">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Restore" Click="UnarchiveNote_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="DeleteArchivedNote_Click" Foreground="{DynamicResource DangerBrush}" InputGestureText="Ctrl+Del"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left stripe: note color (muted) -->
                    <Border Grid.Column="0" CornerRadius="{DynamicResource CardStripeLgCornerRadius}"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" Opacity="0.55"/>

                    <!-- Content -->
                    <StackPanel Grid.Column="1" Margin="12,9,8,9">
                        <!-- Title or content preview -->
                        <TextBlock FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold"
                                   Margin="0,0,0,3">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding NoteTitle}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoteTitle}" Value="">
                                            <Setter Property="Text" Value="{Binding NoteContent, Converter={StaticResource XamlToPlainTextConverter}}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoteTitle}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{Binding NoteContent, Converter={StaticResource XamlToPlainTextConverter}}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Category + timestamp row -->
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontSize="9" FontWeight="SemiBold"
                                       Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                       Opacity="0.7" Margin="0,0,8,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="GENERAL"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Todo}">
                                                <Setter Property="Text" Value="TODO"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Reminder}">
                                                <Setter Property="Text" Value="REMINDER"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Log}">
                                                <Setter Property="Text" Value="LOG"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding NoteCategory}" Value="{x:Static models:NoteCategory.Idea}">
                                                <Setter Property="Text" Value="IDEA"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding CreatedAtDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Restore button (fade in on hover) -->
                    <Button Grid.Column="2" Click="QuickArchive_Click"
                            ToolTip="Restore" Cursor="Hand" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="Restore" FontSize="10"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}, Path=IsMouseOver}" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for merged order cards in widget view (vertical stacking) -->
        <DataTemplate x:Key="OrderItemGroupMergedTemplate" DataType="{x:Type vm:OrderItemGroup}">
            <!-- Outer border for link mode highlighting -->
            <Border x:Name="LinkHighlightBorder" Margin="0" CornerRadius="{DynamicResource RadiusMd}" Padding="2"
                    MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource IsLinkSourceToBrushConverter}">
                        <Binding Path="."/>
                        <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <MultiBinding Converter="{StaticResource IsLinkSourceToThicknessConverter}">
                        <Binding Path="."/>
                        <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Border.BorderThickness>
            <Border Style="{DynamicResource OrderLogWidgetElevatedCardStyle}" ClipToBounds="True"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown" KeyDown="Card_KeyDown" Focusable="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Left status stripe -->
                    <Border Grid.Column="0" Grid.RowSpan="2" CornerRadius="{DynamicResource CardStripeMdCornerRadius}"
                            Background="{Binding First.Status, Converter={StaticResource StatusToColorConverter}}"/>

                    <!-- Unified Header Section -->
                    <Border Grid.Column="1" Grid.Row="0" Background="{DynamicResource SurfaceHoverBrush}"
                            Padding="14,10" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="{DynamicResource CardFontSize}" Margin="0,0,6,0"/>
                                <TextBlock Text="Merged"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="{DynamicResource RadiusSm}"
                                        Padding="5,2"
                                        Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} orders'}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Unified Status ComboBox -->
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding First.Status, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="UnifiedStatusComboBox_SelectionChanged"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Padding="8,6"
                                      MinHeight="28"
                                      MinWidth="120"
                                      Margin="0,0,8,0"
                                      Foreground="{Binding First.Status, Converter={StaticResource StatusToColorConverter}}"
                                      Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="Not Ready" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="On Deck" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="In Progress" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="Done" Tag="{x:Static models:OrderItem+OrderStatus.Done}" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Order Sections (Vertical Stack) -->
                    <ItemsControl Grid.Column="1" Grid.Row="1" ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        Padding="14,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <!-- Remove bottom border on last section -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- Section Header with unlink button -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding VendorName, TargetNullValue='Order'}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       VerticalAlignment="Center"/>
                                            <!-- Unlink this item button -->
                                            <Button Grid.Column="1" Click="UnlinkSingleItem_Click" ToolTip="Remove from group" IsTabStop="False"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="4"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSm}" Padding="{TemplateBinding Padding}">
                                                                        <TextBlock Text="🔗" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Editable VendorName -->
                                        <Grid>
                                            <TextBlock Text="Vendor name..."
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="None">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VendorName}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VendorName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding VendorName, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource ModernEditableFieldStyle}"
                                                     FontSize="{DynamicResource CardFontSize}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     TextWrapping="Wrap"
                                                     GotFocus="EditableField_GotFocus"
                                                     LostFocus="EditableField_LostFocus">
                                                <i:Interaction.Behaviors>
                                                    <behaviors:VendorAutocompleteBehavior/>
                                                </i:Interaction.Behaviors>
                                            </TextBox>
                                        </Grid>

                                        <!-- Editable Transfer Numbers -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                    Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}"/>
                                            <TextBlock Grid.Column="1" Text="Transfer #s..."
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding TransferNumbers, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource ModernEditableFieldStyle}"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="{DynamicResource CardFontSize}"
                                                     GotFocus="EditableField_GotFocus"
                                                     LostFocus="EditableField_LostFocus"/>
                                        </Grid>

                                        <!-- Editable WHS Shipment Numbers -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}" 
                                                    Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}"/>
                                            <TextBlock Grid.Column="1" Text="WHS #s..."
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding WhsShipmentNumbers, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource ModernEditableFieldStyle}"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="{DynamicResource CardFontSize}"
                                                     GotFocus="EditableField_GotFocus"
                                                     LostFocus="EditableField_LostFocus"/>
                                        </Grid>

                                        <!-- TimeInProgress Display -->
                                        <TextBlock Text="{Binding TimeInProgressDisplay}"
                                                   Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="{DynamicResource CardFontSize}"
                                                   Margin="0,6,0,0"/>

                                        <!-- TimeOnDeck Display -->
                                        <TextBlock Text="{Binding TimeOnDeckDisplay}"
                                                   Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="{DynamicResource CardFontSize}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>

                                        <!-- Created timestamp -->
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            </Border>
        </DataTemplate>

        <!-- Template for ARCHIVED merged order cards - compact row design -->
        <DataTemplate x:Key="ArchivedOrderItemGroupMergedTemplate" DataType="{x:Type vm:OrderItemGroup}">
            <Border Background="{DynamicResource SurfaceHoverBrush}"
                    BorderBrush="{DynamicResource TextDisabledBrush}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLg}"
                    Margin="8,0,8,0"
                    ClipToBounds="True">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Restore All" Click="UnarchiveGroup_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete All" Click="DeleteArchivedGroup_Click" Foreground="{DynamicResource DangerBrush}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left accent stripe (muted — no status colour in archive) -->
                    <Border Grid.Column="0" CornerRadius="{DynamicResource CardStripeLgCornerRadius}"
                            Background="{DynamicResource TextTertiaryBrush}" Opacity="0.55"/>

                    <!-- Content: group header + all member rows -->
                    <StackPanel Grid.Column="1" Margin="12,9,8,9">

                        <!-- Group header row -->
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,7">
                            <TextBlock Text="🔗" FontSize="10" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="4,1" Margin="0,0,7,0">
                                <TextBlock Text="{Binding Count, StringFormat='{}{0}×'}"
                                           FontSize="9" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding First.CreatedAtDisplay}"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Member rows -->
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" Padding="0,5,0,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="BorderThickness" Value="0,1,0,0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <!-- Vendor name -->
                                            <TextBlock Text="{Binding VendorName, FallbackValue='—'}"
                                                       FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold"
                                                       Margin="0,0,0,5"
                                                       TextWrapping="Wrap"/>

                                            <!-- Transfer numbers with copy button -->
                                            <Grid Margin="0,0,0,3"
                                                  Visibility="{Binding TransferNumbers, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                        Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}" IsTabStop="False"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TransferNumbers}"
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- WHS numbers with copy button -->
                                            <Grid Margin="0,0,0,5"
                                                  Visibility="{Binding WhsShipmentNumbers, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                        Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}" IsTabStop="False"/>
                                                <TextBlock Grid.Column="1" Text="{Binding WhsShipmentNumbers}"
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Timer (muted, no status colour) -->
                                            <TextBlock Text="{Binding TimeInProgressDisplay}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       Visibility="{Binding TimeInProgressDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>

                    <!-- Restore All button (fade on hover) -->
                    <Button Grid.Column="2" Click="RestoreGroup_Click" ToolTip="Restore All" Cursor="Hand"
                            Margin="0,8,10,0" VerticalAlignment="Top">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Padding" Value="6,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                <TextBlock Text="↩ Restore All" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLinkMode}" Value="True">
                        <Setter Property="Cursor" Value="Cross"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Marathon Toolbar — frosted dark header with neon accent border -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource BorderAccentColor}" Opacity="0.6"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Marathon Tabs (only show when ShowArchived is true) -->
                <Border Grid.Row="0" Margin="16,14,16,0"
                        Visibility="{Binding ShowArchived, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusSm}"
                            Padding="3"
                            Height="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Active Tab —  Marathon angular style -->
                            <Button x:Name="ActiveTabButton"
                                    Click="ActiveTab_Click"
                                    Style="{StaticResource WidgetTabButtonActiveStyle}"
                                    Height="32"
                                    Margin="0,0,2,0">
                                <TextBlock Text="ACTIVE"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>

                            <!-- Archived Tab -->
                            <Button x:Name="ArchivedTabButton"
                                    Grid.Column="1"
                                    Click="ArchivedTab_Click"
                                    Style="{StaticResource WidgetTabButtonStyle}"
                                    Height="32"
                                    Margin="2,0,0,0">
                                <TextBlock Text="ARCHIVED"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- Row 1.5: Marathon Search Bar -->
                <Border Grid.Row="1" Padding="16,12,16,6"
                        Visibility="{Binding NotesOnlyMode, Converter={StaticResource InverseBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Angular Marathon Search Box -->
                        <Border Grid.Column="0"
                                CornerRadius="{DynamicResource RadiusSm}"
                                Height="36"
                                Margin="0,0,8,0"
                                BorderThickness="1"
                                Cursor="IBeam"
                                MouseLeftButtonDown="SearchBorder_MouseLeftButtonDown">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" Opacity="0.92"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource BorderColor}"/>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Icon -->
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Margin="10,0,8,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          IsHitTestVisible="False"/>

                                <!-- Search Input -->
                                <TextBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,8"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        CaretBrush="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        IsEnabled="True"
                                        Focusable="True"
                                        KeyboardNavigation.IsTabStop="True"
                                        Panel.ZIndex="10">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock Text="Search orders..."
                                                                      FontStyle="Italic"
                                                                      Foreground="{DynamicResource TextDisabledBrush}"
                                                                      IsHitTestVisible="False"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                                          Margin="0" 
                                                                          VerticalAlignment="Center"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Clear Search Button -->
                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}"
                                        Width="24" Height="24" Margin="4,0,6,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Clear search">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusSm}">
                                                            <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Modern Filter Button - Hidden -->
                        <Button Grid.Column="1"
                                Width="48" Height="48"
                                ToolTip="Advanced Filters"
                                Click="ShowFilters_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource ModernIconButtonStyle}">
                            <Border CornerRadius="{DynamicResource RadiusMd}"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    Width="48" Height="48">
                                <Border.Effect>
                                    <DropShadowEffect Color="#20000000" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 2: Action Bar (only show on Active tab) -->
                <Grid Grid.Row="2" x:Name="AddButtonsPanel" Margin="16,6,16,14">
                    <!-- Marathon: Add Order button — full width now that notes has its own edge tab -->
                    <Button Click="AddBlankOrder_Click"
                            Visibility="{Binding NotesOnlyMode, Converter={StaticResource InverseBoolToVis}}"
                            Style="{StaticResource ModernPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="ORDER"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </Grid>

            </Grid>
        </Border>

        <!-- Notes List with bottom fade overlay -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="MainScrollViewer" Padding="0,4,0,4" Style="{StaticResource WidgetScrollViewerStyle}">
                <Grid>
                    <!-- Active Notes Panel -->
                    <StackPanel x:Name="ActiveItemsPanel">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="ActiveItemsTransform"/>
                        </StackPanel.RenderTransform>

                    <!-- Add Order Card (Inline) -->
                    <Border x:Name="AddOrderCard"
                            Visibility="Collapsed"
                            Style="{StaticResource OrderLogWidgetStaticCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    Padding="14,10"
                                    CornerRadius="{DynamicResource CardTopCornerRadius}">
                                <Grid>
                                    <TextBlock Text="Add New Order"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            HorizontalAlignment="Right"
                                            Click="CancelAddOrder_Click"
                                            Style="{DynamicResource MarathonBtnIcon}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Width="28"
                                            Height="28"
                                            FontSize="12"
                                            Padding="0"/>
                                </Grid>
                            </Border>

                            <!-- Form -->
                            <StackPanel Grid.Row="1" Margin="14,14,14,16" KeyDown="AddOrderForm_KeyDown">
                                <!-- Vendor Name -->
                                <TextBlock Text="Vendor Name"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="InlineVendorNameBox"
                                         Background="{DynamicResource SurfaceActiveBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderAccentBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         Margin="0,0,0,10"
                                         TextWrapping="Wrap"
                                         TabIndex="10">
                                    <i:Interaction.Behaviors>
                                        <behaviors:VendorAutocompleteBehavior/>
                                    </i:Interaction.Behaviors>
                                </TextBox>

                                <!-- Transfer Numbers -->
                                <TextBlock Text="Transfer Numbers (Optional)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="InlineTransferNumbersBox"
                                         Background="{DynamicResource SurfaceActiveBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderAccentBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         TabIndex="11"
                                         Margin="0,0,0,10"/>

                                <!-- Warehouse Shipment Numbers -->
                                <TextBlock Text="Warehouse Shipment Numbers (Optional)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="InlineWhsShipmentNumbersBox"
                                         Background="{DynamicResource SurfaceActiveBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderAccentBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         TabIndex="12"
                                         Margin="0,0,0,10"/>

                                <!-- Status -->
                                <TextBlock Text="Status"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="InlineStatusComboBox"
                                          Style="{DynamicResource ModernComboBoxStyle}"
                                          Background="{DynamicResource SurfaceActiveBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderAccentBrush}"
                                          BorderThickness="1"
                                          Padding="10,6"
                                          FontSize="13"
                                          Margin="0,0,0,14"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{x:Static models:OrderItem+OrderStatus.NotReady}">
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" IsSelected="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WidgetStatusNotReadyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Not Ready" Foreground="{DynamicResource WidgetStatusNotReadyBrush}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WidgetStatusOnDeckBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="On Deck" Foreground="{DynamicResource WidgetStatusOnDeckBrush}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.InProgress}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WidgetStatusInProgressBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="In Progress" Foreground="{DynamicResource WidgetStatusInProgressBrush}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>

                                <!-- Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="Cancel"
                                            Click="CancelAddOrder_Click"
                                            Style="{DynamicResource MarathonBtn}"
                                            Padding="0,8"/>

                                    <Button Grid.Column="2"
                                            Content="Add Order"
                                            Click="ConfirmAddOrder_Click"
                                            Style="{DynamicResource MarathonBtnPrimary}"
                                            Padding="0,8"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notes Section relocated to NotesDrawerOverlay (side drawer) -->

                    <!-- Flat List View (hidden - status headers always visible) -->
                    <ListBox x:Name="ActiveItemsListBox" ItemsSource="{Binding DisplayItems}" BorderThickness="0" Background="Transparent"
                             Visibility="Collapsed"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             VirtualizingStackPanel.VirtualizationMode="Standard"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,14"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <!-- Replace the default template to eliminate selection visuals entirely -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <!-- Default: Display single item -->
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding First}">
                                                        <ContentControl.ContentTemplate>
                                                                <DataTemplate>
                                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <!-- ORDER MENU ITEMS -->
                                        <MenuItem Header="Set Status" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                            <MenuItem Header="Not Ready" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}"/>
                                            <MenuItem Header="On Deck" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}"/>
                                            <MenuItem Header="In Progress" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}"/>
                                        </MenuItem>
                                        <MenuItem Header="Reset Timer" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                            <MenuItem Header="Reset In Progress Timer" Click="ResetInProgressTimer_Click"/>
                                            <MenuItem Header="Reset On Deck Timer" Click="ResetOnDeckTimer_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Reset All Timers" Click="ResetAllTimers_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Move Up" Click="MoveUp_Click" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <MenuItem Header="Move Down" Click="MoveDown_Click" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <Separator Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <MenuItem Header="Unlink" Click="Unlink_Click" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <!-- NOTE MENU ITEMS -->
                                        <MenuItem Header="Change Color..." Click="ChangeColor_Click" CommandParameter="{Binding}" Visibility="{Binding NoteType, Converter={StaticResource ShowForNotesConverter}}"/>
                                        <!-- COMMON MENU ITEMS -->
                                        <Separator/>
                                        <MenuItem Header="Done (Archive)" Click="ArchiveNote_Click" FontWeight="SemiBold"/>
                                        <MenuItem Header="Delete" Click="DeleteNote_Click" Foreground="{DynamicResource DangerBrush}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Color Bar -->
                                    <Border Grid.Row="0" CornerRadius="{DynamicResource CardTopCornerRadius}"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ColorBar_Click"
                                            Height="{StaticResource CardColorBarHeight}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NoteType}" Value="{x:Static models:NoteType.StickyNote}">
                                                        <Setter Property="Background" Value="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Header (Vendor/Note title on left, Status + Drag handle on right) - HIDDEN FOR NOTES -->
                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10" Margin="0" MinHeight="36" Panel.ZIndex="50"
                                            Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Vendor name (orders) or Note title (notes) -->
                                            <StackPanel Orientation="Vertical">
                                                <Grid Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                                    <TextBlock Text="Vendor name..."
                                                               FontSize="{DynamicResource CardFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextDisabledBrush}"
                                                               FontStyle="Italic"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="None">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding VendorName}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding VendorName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding VendorName, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             FontSize="{DynamicResource CardFontSize}"
                                                             FontWeight="SemiBold"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             SelectionBrush="{DynamicResource AccentBrush}"
                                                             Padding="0"
                                                             TextWrapping="Wrap"
                                                             TabIndex="10">
                                                        <i:Interaction.Behaviors>
                                                            <behaviors:VendorAutocompleteBehavior/>
                                                        </i:Interaction.Behaviors>
                                                    </TextBox>
                                                </Grid>

                                                <Grid Visibility="{Binding NoteType, Converter={StaticResource ShowForNotesConverter}}">
                                                    <TextBlock Text="Note title..."
                                                               FontSize="{DynamicResource CardFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextDisabledBrush}"
                                                               FontStyle="Italic"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               TextTrimming="None">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NoteTitle}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding NoteTitle}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="NoteTitleBoxHeader"
                                                             Text="{Binding NoteTitle, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource ModernEditableFieldStyle}"
                                                             FontSize="{DynamicResource CardFontSize}"
                                                             FontWeight="SemiBold"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Right: Status (col 1) and Drag Handle (col 2) -->
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,8,0"
                                                      SelectedValue="{Binding Status, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="StatusComboBox_SelectionChanged"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Padding="8,6"
                                                      MinHeight="28"
                                                      MinWidth="120"
                                                      Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"
                                                      Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                      Style="{DynamicResource ModernComboBoxStyle}">
                                                <ComboBoxItem Content="Not Ready" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                                <ComboBoxItem Content="On Deck" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                                <ComboBoxItem Content="In Progress" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                                <ComboBoxItem Content="Done" Tag="{x:Static models:OrderItem+OrderStatus.Done}" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Row="2" Margin="16,14">
                                        <TextBlock Text="🔗" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding LinkedItemCount, Converter={StaticResource IntToVisibilityConverter}}"/>
                                        <!-- Vendor/title moved into header; remove duplicate fields from body -->

                                        <!-- ORDER FIELDS (hidden for sticky notes) -->
                                        <StackPanel Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                            
                                            <!-- Editable Transfer Numbers with inline drag handle (moved here for single-item cards) -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}" 
                                                        Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}"/>

                                                <TextBlock Grid.Column="1" Text="Transfer #s..." 
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TransferNumbers}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TransferNumbers}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding TransferNumbers, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource ModernEditableFieldStyle}"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="{DynamicResource CardFontSize}"
                                                         GotFocus="EditableField_GotFocus"
                                                         LostFocus="EditableField_LostFocus"
                                                         TextWrapping="Wrap"/>
                                            </Grid>

                                            <!-- Editable WHS Shipment Numbers -->
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}" 
                                                        Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}"/>
                                                <TextBlock Grid.Column="1" Text="WHS #s..." 
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding WhsShipmentNumbers, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource ModernEditableFieldStyle}"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="{DynamicResource CardFontSize}"
                                                         GotFocus="EditableField_GotFocus"
                                                         LostFocus="EditableField_LostFocus"
                                                         TextWrapping="Wrap"/>
                                            </Grid>

                                            <TextBlock Text="{Binding TimeInProgressDisplay}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       Margin="0,6,0,0"/>

                                            <TextBlock Text="{Binding TimeOnDeckDisplay}"
                                                       Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       FontWeight="SemiBold"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- STICKY NOTE CONTENT (visible only for sticky notes, with placeholder) -->
                                        <Grid Margin="0,-6,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoteType}" Value="{x:Static models:NoteType.StickyNote}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <!-- Note content -->
                                            <Grid MinHeight="60">
                                                <TextBlock Text="Write your note..."
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Top"
                                                           Margin="4,4,0,0"
                                                           TextWrapping="Wrap"
                                                           TextTrimming="None">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NoteContent}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding NoteContent}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <RichTextBox Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             FontSize="{DynamicResource CardFontSize}"
                                                             Padding="4"
                                                             MinHeight="40"
                                                             MinWidth="200"
                                                             HorizontalAlignment="Stretch"
                                                             AcceptsReturn="True"
                                                             IsDocumentEnabled="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             PreviewKeyDown="NoteContent_PreviewKeyDown"
                                                             Loaded="NoteContent_Loaded"
                                                             LostFocus="NoteContent_LostFocus"
                                                             GotFocus="EditableField_GotFocus"
                                                             Cursor="IBeam"/>
                                                
                                                <!-- Floating action buttons (always visible with good contrast) -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                                    <Button Click="QuickArchive_Click" ToolTip="Archive" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="6"/>
                                                                <Setter Property="Opacity" Value="0.7"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                                                <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Footer with timestamp -->
                                    <TextBlock Grid.Row="3" 
                                               Text="{Binding CreatedAtDisplay}" 
                                               FontSize="10" 
                                               Foreground="{DynamicResource TextTertiaryBrush}" 
                                               HorizontalAlignment="Right" 
                                               Margin="0,4,16,8"/>
                                </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- When IsGroup is true, use merged template -->
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- Grouped Status View (always visible) -->
                    <StackPanel x:Name="GroupedStatusPanel" Visibility="Visible">

                        <!-- In Progress Section -->
                        <Expander x:Name="InProgressExpander" IsExpanded="{Binding InProgressGroupExpanded, Mode=TwoWay}" Margin="0,0,0,8">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="{TemplateBinding Background}">
                                                    <DockPanel>
                                                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeaderBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="6,0"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Status accent stripe -->
                                                                            <Border Width="3" Height="16" Background="{DynamicResource WidgetStatusInProgressBrush}" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="IN PROGRESS" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <!-- Count badge -->
                                                                            <Border Grid.Column="2" Background="{DynamicResource WidgetStatusInProgressBgBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="8,3" Margin="8,0,10,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DataContext.InProgressCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetStatusInProgressBrush}" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="3" x:Name="Arrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding InProgressItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="0,0,0,8">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                                            <Setter Property="Content" Value="{Binding First}"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OrderItemTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- On Deck Section -->
                        <Expander x:Name="OnDeckExpander" IsExpanded="{Binding OnDeckGroupExpanded, Mode=TwoWay}" Margin="0,0,0,8">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="{TemplateBinding Background}">
                                                    <DockPanel>
                                                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeaderBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="6,0"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Status accent stripe -->
                                                                            <Border Width="3" Height="16" Background="{DynamicResource WidgetStatusOnDeckBrush}" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="ON DECK" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <!-- Count badge -->
                                                                            <Border Grid.Column="2" Background="{DynamicResource WidgetStatusOnDeckBgBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="8,3" Margin="8,0,10,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DataContext.OnDeckCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetStatusOnDeckBrush}" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="3" x:Name="Arrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding OnDeckItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="0,0,0,8">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                                            <Setter Property="Content" Value="{Binding First}"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OrderItemTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Not Ready Section -->
                        <Expander x:Name="NotReadyExpander" IsExpanded="{Binding NotReadyGroupExpanded, Mode=TwoWay}" Margin="0,0,0,48">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="{TemplateBinding Background}">
                                                    <DockPanel>
                                                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeaderBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="12,10" Margin="6,0"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Status accent stripe -->
                                                                            <Border Width="3" Height="16" Background="{DynamicResource WidgetStatusNotReadyBrush}" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="NOT READY" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                            <!-- Count badge -->
                                                                            <Border Grid.Column="2" Background="{DynamicResource WidgetStatusNotReadyBgBrush}" CornerRadius="{DynamicResource RadiusSm}" Padding="8,3" Margin="8,0,10,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DataContext.NotReadyCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetStatusNotReadyBrush}" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="3" x:Name="Arrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding NotReadyItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="0,0,0,8">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                                            <Setter Property="Content" Value="{Binding First}"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OrderItemTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Empty State: No Active Orders -->
                        <Border Margin="6,40,6,40" Padding="32,24"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource RadiusMd}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding InProgressCount}" Value="0"/>
                                                <Condition Binding="{Binding OnDeckCount}" Value="0"/>
                                                <Condition Binding="{Binding NotReadyCount}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="No Orders Yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Create your first order to get started"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Archived Notes Panel (separate tab) -->
                <StackPanel x:Name="ArchivedItemsPanel" Visibility="Collapsed">
                    <StackPanel.RenderTransform>
                        <TranslateTransform x:Name="ArchivedItemsTransform"/>
                    </StackPanel.RenderTransform>
                    <!-- Archived Panel Header -->
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="16,10,16,10"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Title + count badge -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="ARCHIVED"
                                           FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <Border Background="{DynamicResource SurfaceSunkenBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="{DynamicResource RadiusSm}" Padding="6,2">
                                    <TextBlock Text="{Binding ArchivedItems.Count}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Border>
                            </StackPanel>
                            <!-- Sort toggle -->
                            <Button Grid.Column="1" Click="ArchivedSortToggle_Click" ToolTip="Cycle sort mode"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⇅" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                                <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Date"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ArchivedSortModeEnum}" Value="VendorName">
                                                                    <Setter Property="Text" Value="Vendor"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ListBox x:Name="ArchivedListBox"
                             ItemsSource="{Binding DisplayArchivedItems}"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,10"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!-- Default: single archived item -->
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                <!-- Archived item card - compact row -->
                                <Border Background="{DynamicResource SurfaceHoverBrush}"
                                        BorderBrush="{DynamicResource TextDisabledBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusLg}"
                                        Margin="8,0,8,0"
                                        ClipToBounds="True">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" Click="Copy_Click" DataContext="{Binding First}" InputGestureText="Ctrl+C"/>
                                            <MenuItem Header="Paste" Click="Paste_Click" DataContext="{Binding First}" InputGestureText="Ctrl+V"/>
                                            <MenuItem Header="Duplicate" Click="Duplicate_Click" DataContext="{Binding First}" InputGestureText="Ctrl+D"/>
                                            <Separator/>
                                            <MenuItem Header="Restore" Click="QuickArchive_Click" DataContext="{Binding First}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="DeleteArchivedNote_Click" DataContext="{Binding First}" Foreground="{DynamicResource DangerBrush}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left colour stripe (muted — no status colour in archive) -->
                                        <Border Grid.Column="0" CornerRadius="{DynamicResource CardStripeLgCornerRadius}"
                                                Background="{DynamicResource TextTertiaryBrush}"
                                                Opacity="0.55"/>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" Margin="12,9,8,9">
                                            <!-- Vendor name (orders) or note preview (sticky) -->
                                            <TextBlock Text="{Binding First.VendorName, FallbackValue='—'}"
                                                       FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold"
                                                       Margin="0,0,0,5"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding First.NoteContent}"
                                                       FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"
                                                       Margin="0,0,0,5"
                                                       Visibility="{Binding First.IsStickyNote, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                            <!-- Transfer numbers with copy button -->
                                            <Grid Margin="0,0,0,3"
                                                  Visibility="{Binding First.TransferNumbers, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                        Click="CopyTransferNumbers_Click" Tag="{Binding First.TransferNumbers}" IsTabStop="False"/>
                                                <TextBlock Grid.Column="1" Text="{Binding First.TransferNumbers}"
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- WHS numbers with copy button -->
                                            <Grid Margin="0,0,0,5"
                                                  Visibility="{Binding First.WhsShipmentNumbers, Converter={StaticResource StringToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                        Click="CopyWhsNumbers_Click" Tag="{Binding First.WhsShipmentNumbers}" IsTabStop="False"/>
                                                <TextBlock Grid.Column="1" Text="{Binding First.WhsShipmentNumbers}"
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap" VerticalAlignment="Center"/>
                                            </Grid>

                                            <!-- Timer + timestamp -->
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding First.TimeInProgressDisplay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Margin="0,0,8,0"
                                                           Visibility="{Binding First.TimeInProgressDisplay, Converter={StaticResource StringToVisibilityConverter}}"/>
                                                <TextBlock Text="{Binding First.CreatedAtDisplay}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Restore button (fade in on hover) -->
                                        <Button Grid.Column="2" Click="QuickArchive_Click" DataContext="{Binding First}"
                                                ToolTip="Restore" Cursor="Hand" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Opacity" Value="0"/>
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="6,4"/>
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusMd}" Padding="{TemplateBinding Padding}">
                                                                    <TextBlock Text="↩ Restore" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                                                                </Border>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=IsMouseOver}" Value="True">
                                                            <DataTrigger.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.EnterActions>
                                                            <DataTrigger.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </DataTrigger.ExitActions>
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- When IsGroup is true, use archived merged template -->
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ArchivedOrderItemGroupMergedTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State: No Archived Orders -->
                    <Border Margin="6,40,6,40" Padding="32,24"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{DynamicResource RadiusMd}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArchivedItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="No Archived Orders"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Archived orders will appear here"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
            
            <!-- Top fade overlay — thin hairline only, toolbar border provides the real separation -->
            <Border VerticalAlignment="Top" Height="12" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#880A0A0A" Offset="0"/>
                        <GradientStop Color="#000A0A0A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            
            <!-- Bottom fade overlay — deeper taper to hint at more content -->
            <Border VerticalAlignment="Bottom" Height="44" IsHitTestVisible="False" Panel.ZIndex="49">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#000A0A0A" Offset="0"/>
                        <GradientStop Color="#AA0A0A0A" Offset="0.6"/>
                        <GradientStop Color="#FF0A0A0A" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            
            <!-- Edge hint for hidden handles -->
            <StackPanel x:Name="SideHandleEdgeHints"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Panel.ZIndex="145"
                        Margin="0,0,1,0"
                        Opacity="0.95">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Opacity" Value="0.95"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=SideHandlePanel, Path=IsHitTestVisible}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation To="0.25" Duration="0:0:0.18" Storyboard.TargetProperty="Opacity"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation To="0.95" Duration="0:0:0.24" Storyboard.TargetProperty="Opacity"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <Border Width="3" Height="40" CornerRadius="1.5" Background="{DynamicResource WarningBrush}" Opacity="0.85"/>
                <StackPanel Margin="0,6,0,0">
                    <Border Width="3" Height="8" CornerRadius="1" Background="{DynamicResource WidgetStatusInProgressBrush}" Margin="0,1,0,0"/>
                    <Border Width="3" Height="8" CornerRadius="1" Background="{DynamicResource WidgetStatusOnDeckBrush}" Margin="0,1,0,0"/>
                    <Border Width="3" Height="8" CornerRadius="1" Background="{DynamicResource WidgetStatusNotReadyBrush}" Margin="0,1,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Hover activation zone for side handle -->
            <Border x:Name="SideHandleHoverZone"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Width="16"
                    Height="{Binding ElementName=SideHandlePanel, Path=ActualHeight}"
                    Background="Transparent"
                    Panel.ZIndex="140"
                    MouseEnter="SideHandleHoverZone_MouseEnter"
                    MouseLeave="SideHandleHoverZone_MouseLeave"/>

            <!-- Unified Side Handle Rail: Notes trigger (top) + Status jump (bottom) -->
            <Grid x:Name="SideHandlePanel"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Panel.ZIndex="150"
                  MouseLeave="SideHandlePanel_MouseLeave"
                  Opacity="0"
                  IsHitTestVisible="False">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SideHandleSlideTransform" X="20"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>  <!-- QuickJump expandable panel -->
                    <ColumnDefinition Width="Auto"/>  <!-- Combined handle strip -->
                </Grid.ColumnDefinitions>

                <!-- Collapsible jump buttons panel (flies out from behind handle) -->
                <Border x:Name="QuickJumpContent"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,0,1"
                        CornerRadius="{DynamicResource CardStripeSmCornerRadius}"
                        Padding="6,8"
                        RenderTransformOrigin="1,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="QuickJumpSlideTransform" ScaleX="0.75"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <!-- In Progress Jump -->
                        <Button x:Name="JumpInProgressBtn" Click="JumpToInProgress_Click"
                                ToolTip="Jump to In Progress"
                                Height="26" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusXs}" Padding="6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusInProgressBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="IN PROG" FontSize="9"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding InProgressCount}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource WidgetStatusInProgressBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- On Deck Jump -->
                        <Button x:Name="JumpOnDeckBtn" Click="JumpToOnDeck_Click"
                                ToolTip="Jump to On Deck"
                                Height="26" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusXs}" Padding="6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusOnDeckBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="ON DECK" FontSize="9"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding OnDeckCount}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource WidgetStatusOnDeckBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Not Ready Jump -->
                        <Button x:Name="JumpNotReadyBtn" Click="JumpToNotReady_Click"
                                ToolTip="Jump to Not Ready"
                                Height="26" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{DynamicResource RadiusXs}" Padding="6,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusNotReadyBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="NOT RDY" FontSize="9"
                                                       FontFamily="{DynamicResource FontMono}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" Margin="6,0,8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding NotReadyCount}" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource WidgetStatusNotReadyBrush}"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Combined handle strip: notes trigger (amber) + jump dots (surface) -->
                <Border x:Name="SideHandleStrip"
                        Grid.Column="1"
                        CornerRadius="{DynamicResource CardStripeMdCornerRadius}"
                        ClipToBounds="True"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="180" Opacity="0.4" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical">

                        <!-- Notes section (amber) -->
                        <Button x:Name="NotesEdgeTab"
                                Click="NotesToggle_Click"
                                Padding="4,8" Background="{DynamicResource WarningBrush}"
                                BorderThickness="0" Cursor="Hand"
                                Width="38">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="ToolTip" Value="Open notes"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NotesExpanded}" Value="True">
                                            <Setter Property="ToolTip" Value="Close notes"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="NotesBd"
                                            Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}"
                                            CornerRadius="3"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border x:Name="NotesOverlay"
                                                    CornerRadius="6"
                                                    Opacity="0.55"
                                                    IsHitTestVisible="False">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Color="#BBFFFFFF" Offset="0"/>
                                                        <GradientStop Color="#33FFFFFF" Offset="0.45"/>
                                                        <GradientStop Color="#22000000" Offset="1"/>
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>

                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0">
                                                <Grid Width="20" Height="20">
                                                    <Ellipse Fill="#2CFFFFFF" Stroke="#66FFFFFF" StrokeThickness="1"/>
                                                    <TextBlock Text="✎"
                                                               FontSize="12" FontWeight="SemiBold"
                                                               Foreground="#1A1A1A"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               IsHitTestVisible="False"/>
                                                </Grid>

                                                <Border x:Name="NotesCountPill"
                                                        CornerRadius="8"
                                                        Background="#1A1A1A"
                                                        Padding="5,1"
                                                        Margin="0,6,0,4"
                                                        HorizontalAlignment="Center"
                                                        Visibility="{Binding StickyNotes.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                        <Ellipse Width="3" Height="3" Fill="{DynamicResource WarningBrush}" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding StickyNotes.Count}"
                                                                   FontSize="8" FontWeight="Bold"
                                                                   Foreground="{DynamicResource WarningBrush}"/>
                                                    </StackPanel>
                                                </Border>

                                                <Rectangle Height="1" RadiusX="0.5" RadiusY="0.5" Width="14" Fill="#4D1A1A1A" HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="NotesChevron"
                                                           Text="◀"
                                                           FontSize="7" FontWeight="Bold"
                                                           Foreground="#881A1A1A"
                                                           HorizontalAlignment="Center"
                                                           Margin="0,5,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding NotesExpanded}" Value="True">
                                            <Setter TargetName="NotesChevron" Property="Text" Value="▶"/>
                                            <Setter TargetName="NotesBd" Property="Opacity" Value="0.82"/>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="NotesOverlay"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.75" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="NotesOverlay"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.55" Duration="0:0:0.22"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="NotesOverlay"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.4" Duration="0:0:0.12"/>
                                                        <DoubleAnimation Storyboard.TargetName="NotesBd"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.9" Duration="0:0:0.12"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetName="NotesOverlay"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="0.55" Duration="0:0:0.18"/>
                                                        <DoubleAnimation Storyboard.TargetName="NotesBd"
                                                                        Storyboard.TargetProperty="Opacity"
                                                                        To="1" Duration="0:0:0.18"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Divider between notes and jump sections -->
                        <Border Height="1" Background="{DynamicResource BorderBrush}" Opacity="0.5"/>

                        <!-- QuickJump handle section (surface) -->
                        <Border x:Name="QuickJumpHandle"
                                Background="{DynamicResource SurfaceBrush}"
                                Padding="4,12"
                                Cursor="Hand"
                                MouseEnter="QuickJumpHandle_MouseEnter">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusInProgressBrush}" Margin="0,2"/>
                                <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusOnDeckBrush}" Margin="0,2"/>
                                <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusNotReadyBrush}" Margin="0,2"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Now Playing Mini-Player (Collapsible - rises from bottom) -->
        <Border x:Name="NowPlayingSection" Grid.Row="4"
                Background="Transparent"
                BorderThickness="0"
            Margin="0,-20,0,0"
            Panel.ZIndex="300"
                Visibility="{Binding ShowNowPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
            <Grid>
                <StackPanel>
                <!-- Full Album Art Player (collapsible - rises from bottom) -->
                <Border x:Name="NowPlayingContent"
                        Visibility="Collapsed"
                        MouseEnter="NowPlayingContent_MouseEnter"
                        MouseLeave="NowPlayingContent_MouseLeave">
                    <Grid>
                        <!-- Album Art Background -->
                        <Border CornerRadius="0"
                                Background="{DynamicResource SurfaceBrush}"
                                Height="{Binding ElementName=WidgetRoot, Path=ActualWidth, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.88}"
                                MinHeight="200"
                                MaxHeight="300">
                            <Grid x:Name="PlayerExpandedGrid">
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="Grid.MouseEnter">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PlayerControlsPanel"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PlayerGradientOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.2">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PlayerTrackInfoPanel"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.25">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="Grid.MouseLeave">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="PlayerControlsPanel"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0" Duration="0:0:0.35" BeginTime="0:0:1">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PlayerGradientOverlay"
                                                                 Storyboard.TargetProperty="Opacity"
                                                                 To="0.3" Duration="0:0:0.35" BeginTime="0:0:1">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="PlayerTrackInfoPanel"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="80" Duration="0:0:0.35" BeginTime="0:0:1">
                                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <!-- Dominant color tint background -->
                                <Border x:Name="DominantColorBg" CornerRadius="0" Opacity="0.25"/>

                                <!-- Blurred album art background — fills letterbox gaps -->
                                <Image x:Name="AlbumArtBlurredBg"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="LowQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Opacity="0.55">
                                    <Image.Effect>
                                        <BlurEffect Radius="32" KernelType="Gaussian"/>
                                    </Image.Effect>
                                </Image>

                                <!-- Album Art - old image for crossfade -->
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="False">
                                    <Image x:Name="AlbumArtImageOld"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Opacity="0"/>

                                    <!-- Album Art - current -->
                                    <Image x:Name="AlbumArtImage"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Grid>

                                <!-- Placeholder when no art -->
                                <TextBlock x:Name="AlbumArtPlaceholder"
                                           Text="🎵"
                                           FontSize="64"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Opacity="0.3"/>

                                <!-- Gradient overlay: transparent top → near-black bottom -->
                                <Border x:Name="PlayerGradientOverlay" Opacity="0.3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#08000000" Offset="0.25"/>
                                            <GradientStop Color="#55000000" Offset="0.5"/>
                                            <GradientStop Color="#BB000000" Offset="0.72"/>
                                            <GradientStop Color="#EE000000" Offset="0.88"/>
                                            <GradientStop Color="#F8000000" Offset="1.0"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>

                                <!-- Track Info + Progress + Controls overlaid at bottom -->
                                <StackPanel VerticalAlignment="Bottom" Margin="18,0,18,14">

                                    <StackPanel x:Name="PlayerTrackInfoPanel">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform Y="80"/>
                                        </StackPanel.RenderTransform>
                                    <!-- Track Title -->
                                    <TextBlock x:Name="TrackTitleText"
                                               Text="Not Playing"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextWrapping="Wrap">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="1" Color="Black"/>
                                        </TextBlock.Effect>
                                    </TextBlock>

                                    <!-- Artist · Album row -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock x:Name="ArtistNameText"
                                                   Text=""
                                                   FontSize="12"
                                                   Foreground="#DDFFFFFF"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Effect>
                                                <DropShadowEffect ShadowDepth="0" BlurRadius="2" Opacity="1" Color="Black"/>
                                            </TextBlock.Effect>
                                        </TextBlock>
                                        <TextBlock x:Name="AlbumDeviceText"
                                                   Text=""
                                                   FontSize="11"
                                                   Foreground="#99FFFFFF"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="6,0,0,0"
                                                   Visibility="Collapsed"/>
                                    </StackPanel>
                                    </StackPanel>

                                    <StackPanel x:Name="PlayerControlsPanel" Opacity="0">
                                    <!-- Progress Bar -->
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TrackPositionText"
                                                   Grid.Column="0"
                                                   Text="0:00"
                                                   FontSize="9"
                                                   Foreground="#AAFFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0"/>
                                        <Grid x:Name="ProgressTrackContainer" Grid.Column="1" Height="16" VerticalAlignment="Center"
                                              Cursor="Hand" Background="Transparent"
                                              MouseLeftButtonDown="ProgressTrack_MouseLeftButtonDown">
                                            <Grid VerticalAlignment="Center" Height="3">
                                                <Border Background="#44FFFFFF" CornerRadius="1.5"/>
                                                <Border x:Name="ProgressBarFill"
                                                        Background="{DynamicResource PrimaryLightBrush}"
                                                        CornerRadius="1.5"
                                                        HorizontalAlignment="Left"
                                                        Width="0"/>
                                            </Grid>
                                        </Grid>
                                        <TextBlock x:Name="TrackDurationText"
                                                   Grid.Column="2"
                                                   Text="0:00"
                                                   FontSize="9"
                                                   Foreground="#AAFFFFFF"
                                                   VerticalAlignment="Center"
                                                   Margin="8,0,0,0"/>
                                    </Grid>

                                    <!-- Controls Row -->
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Left: Shuffle + Repeat -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border x:Name="ShuffleIndicatorWrapper"
                                                    Background="Transparent" Padding="4,2">
                                                <TextBlock x:Name="ShuffleIndicator"
                                                           Text="🔀"
                                                           FontSize="12"
                                                           Foreground="#AAFFFFFF"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"
                                                           ToolTip="Shuffle Off"/>
                                            </Border>
                                            <Border x:Name="RepeatIndicatorWrapper"
                                                    Background="Transparent" Padding="4,2" Margin="2,0,0,0">
                                                <TextBlock x:Name="RepeatIndicator"
                                                           Text="🔁"
                                                           FontSize="12"
                                                           Foreground="#AAFFFFFF"
                                                           VerticalAlignment="Center"
                                                           Opacity="0.7"
                                                           ToolTip="Repeat Off"/>
                                            </Border>
                                        </StackPanel>

                                        <!-- Center: Transport controls -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Button x:Name="VolumeDownButton"
                                                    Content="🔉" Click="VolumeDown_Click"
                                                    Background="Transparent" Foreground="#CCFFFFFF"
                                                    BorderThickness="0" FontSize="13"
                                                    Width="30" Height="30" Cursor="Hand" ToolTip="Volume Down">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="PrevButton"
                                                    Content="⏮" Click="PrevTrack_Click"
                                                    Background="Transparent" Foreground="White"
                                                    BorderThickness="0" FontSize="16"
                                                    Width="36" Height="36" Cursor="Hand" ToolTip="Previous" Margin="2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="PlayPauseButton"
                                                    Content="▶" Click="PlayPause_Click"
                                                    Background="{DynamicResource PrimaryBrush}" Foreground="White"
                                                    BorderThickness="0" FontSize="14"
                                                    Width="44" Height="44" Margin="4,0" Cursor="Hand" ToolTip="Play/Pause">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Foreground" Value="White"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="22">
                                                                        <TextBlock x:Name="Icon"
                                                                                   Text="{TemplateBinding Content}"
                                                                                   Foreground="{TemplateBinding Foreground}"
                                                                                   FontFamily="Segoe UI Symbol"
                                                                                   FontSize="{TemplateBinding FontSize}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryDarkBrush}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Opacity" Value="0.8"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="NextButton"
                                                    Content="⏭" Click="NextTrack_Click"
                                                    Background="Transparent" Foreground="White"
                                                    BorderThickness="0" FontSize="16"
                                                    Width="36" Height="36" Cursor="Hand" ToolTip="Next" Margin="2,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="18">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsPressed" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="VolumeUpButton"
                                                    Content="🔊" Click="VolumeUp_Click"
                                                    Background="Transparent" Foreground="#CCFFFFFF"
                                                    BorderThickness="0" FontSize="13"
                                                    Width="30" Height="30" Cursor="Hand" ToolTip="Volume Up">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>

                                        <!-- Right: Like + History -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="LikeButton"
                                                    Content="♡" Click="LikeTrack_Click"
                                                    Background="Transparent" Foreground="#AAFFFFFF"
                                                    BorderThickness="0" FontSize="14"
                                                    Width="30" Height="30" Cursor="Hand" ToolTip="Like this track">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button x:Name="HistoryButton"
                                                    Content="📋" Click="HistoryButton_Click"
                                                    Background="Transparent" Foreground="#AAFFFFFF"
                                                    BorderThickness="0" FontSize="13"
                                                    Width="30" Height="30" Cursor="Hand" ToolTip="Recently Played">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="15">
                                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    </StackPanel>
                                </StackPanel>

                                <!-- ControlBar stub -->
                                <Border x:Name="ControlBar" Visibility="Collapsed"/>

                                <!-- Recently Played Popup -->
                                <Popup x:Name="HistoryPopup"
                                       PlacementTarget="{Binding ElementName=HistoryButton}"
                                       Placement="Top"
                                       StaysOpen="False"
                                       AllowsTransparency="True"
                                       PopupAnimation="Fade">
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource RadiusMd}"
                                            Padding="8"
                                            MaxHeight="300"
                                            MinWidth="220">
                                        <Border.Effect>
                                            <DropShadowEffect ShadowDepth="2" BlurRadius="12" Opacity="0.3"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="Recently Played"
                                                       FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="4,0,0,6"/>
                                            <ItemsControl x:Name="HistoryList" MaxHeight="250">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="4,3" Margin="0,1" CornerRadius="{DynamicResource RadiusXs}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="28" Height="28"
                                                                        CornerRadius="{DynamicResource RadiusXs}"
                                                                        Background="{DynamicResource PrimaryLightBrush}"
                                                                        Margin="0,0,8,0" ClipToBounds="True">
                                                                    <Image Source="{Binding AlbumArt}" Stretch="UniformToFill"
                                                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                </Border>
                                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <TextBlock Text="{Binding Artist}" FontSize="9"
                                                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </Popup>

                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Collapsed Mini-Bar -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderThickness="0"
                        Padding="0"
                        ToolTip="Click to expand">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Mini Progress Bar (thin strip at top) -->
                        <Grid Grid.Row="0" Height="2">
                            <Border Background="{DynamicResource PrimaryLightBrush}" Opacity="0.2"/>
                            <Border x:Name="MiniProgressBarFill"
                                    Background="{DynamicResource AccentBrush}"
                                    HorizontalAlignment="Left" Width="0"/>
                        </Grid>

                        <!-- Mini-bar content -->
                        <Grid Grid.Row="1" Margin="12,7,12,7"
                              Cursor="Hand"
                              MouseLeftButtonDown="NowPlayingHeader_Click">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Accent stripe (tinted by dominant color) -->
                            <Border x:Name="MiniBarAccentStripe" Grid.Column="0"
                                    Width="3"
                                    Background="{DynamicResource AccentBrush}"
                                    Margin="0,2,10,2"
                                    VerticalAlignment="Stretch"
                                    CornerRadius="1.5"
                                    Opacity="0.8"/>

                            <!-- Album Art Thumbnail -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource PrimaryLightBrush}"
                                    CornerRadius="4"
                                    Width="32" Height="32"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    ClipToBounds="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Width" Value="32"/>
                                        <Setter Property="Height" Value="32"/>
                                        <Style.Triggers>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding ElementName="WidgetRoot"
                                                             Path="ActualWidth"
                                                             Converter="{StaticResource LessThanConverter}"
                                                             ConverterParameter="360"/>
                                                </DataTrigger.Binding>
                                                <Setter Property="Width" Value="28"/>
                                                <Setter Property="Height" Value="28"/>
                                            </DataTrigger>
                                            <DataTrigger Value="True">
                                                <DataTrigger.Binding>
                                                    <Binding ElementName="WidgetRoot"
                                                             Path="ActualWidth"
                                                             Converter="{StaticResource LessThanConverter}"
                                                             ConverterParameter="330"/>
                                                </DataTrigger.Binding>
                                                <Setter Property="Width" Value="24"/>
                                                <Setter Property="Height" Value="24"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <!-- Animated Equalizer Bars -->
                                    <Canvas x:Name="EqualizerPanel" Width="14" Height="12"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=NowPlayingContent, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Rectangle x:Name="EqBar1" Canvas.Left="0" Canvas.Bottom="0" Width="3" Height="12"
                                                   Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                                   RenderTransformOrigin="0.5,1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleY="1"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="EqBar2" Canvas.Left="5" Canvas.Bottom="0" Width="3" Height="12"
                                                   Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                                   RenderTransformOrigin="0.5,1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleY="0.6"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                        <Rectangle x:Name="EqBar3" Canvas.Left="10" Canvas.Bottom="0" Width="3" Height="12"
                                                   Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                                   RenderTransformOrigin="0.5,1">
                                            <Rectangle.RenderTransform>
                                                <ScaleTransform ScaleY="0.8"/>
                                            </Rectangle.RenderTransform>
                                        </Rectangle>
                                    </Canvas>
                                    <TextBlock x:Name="MusicIcon" Text="♪" FontSize="13"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Viewbox Stretch="Uniform">
                                        <Viewbox.Style>
                                            <Style TargetType="Viewbox">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ElementName=NowPlayingContent, Path=Visibility}" Value="Visible">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Viewbox.Style>
                                        <Image x:Name="MiniAlbumArt"
                                               RenderOptions.BitmapScalingMode="HighQuality"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                    </Viewbox>
                                </Grid>
                            </Border>

                            <!-- Center: Track Info -->
                            <Grid Grid.Column="2" Margin="0,0,8,0" ClipToBounds="True" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="NowPlayingHeaderText"
                                           Grid.Column="0"
                                           Text="NOW PLAYING"
                                           FontSize="8"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"
                                           Opacity="0.7"/>

                                <!-- Scrolling track info -->
                                <Canvas x:Name="MarqueeContainer" Grid.Column="1" Height="28" Visibility="Collapsed" ClipToBounds="True">
                                    <StackPanel x:Name="MarqueeContent" Orientation="Horizontal" Canvas.Top="0">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="MarqueeTransform" X="0"/>
                                        </StackPanel.RenderTransform>
                                        <StackPanel>
                                            <TextBlock x:Name="CollapsedTrackTitle"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       LineHeight="15"
                                                       LineStackingStrategy="BlockLineHeight"/>
                                            <TextBlock x:Name="CollapsedArtistName"
                                                       FontSize="10"
                                                       LineHeight="13"
                                                       LineStackingStrategy="BlockLineHeight"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock x:Name="MarqueeSpacer" Text="          " FontSize="12"/>
                                    </StackPanel>
                                </Canvas>
                            </Grid>

                            <!-- Mini Play/Pause -->
                            <Button x:Name="MiniPlayPauseButton" Grid.Column="3"
                                    Content="▶"
                                    Click="PlayPause_Click"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="0"
                                    FontSize="11"
                                    Width="28" Height="28"
                                    Cursor="Hand"
                                    ToolTip="Play/Pause"
                                    VerticalAlignment="Center"
                                    Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="MiniPlayBd" Background="Transparent"
                                                            CornerRadius="14">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="MiniPlayBd" Property="Background" Value="{DynamicResource PrimaryLightBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <!-- Chevron toggle -->
                            <TextBlock x:Name="NowPlayingToggleIcon" Grid.Column="4"
                                       Text="▲"
                                       FontSize="8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Opacity="0.6"/>
                        </Grid>
                    </Grid>
                </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Undo Bar (shows when undo is available) -->
        <Border Grid.Row="5"
                Background="{DynamicResource AccentBrush}"
                Padding="12,8"
                Visibility="{Binding UndoAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UndoMessage}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               FontSize="11"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Content="Undo"
                            Command="{Binding UndoAsyncCommand}"
                            Padding="12,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Background="{DynamicResource TextOnAccentBrush}"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource RadiusMd}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <!-- Countdown indicator -->
                <TextBlock Text="{Binding UndoSecondsRemaining, StringFormat='({0}s)'}"
                           Foreground="{DynamicResource TextOnOverlayDimBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <TextBlock x:Name="StatusMessageText" Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,-2,0,-2">
                    <Button Click="OpenSettings_Click"
                            Style="{DynamicResource MarathonBtnIcon}"
                            ToolTip="Settings"
                            Width="28" Height="28"
                            Margin="0,0,2,0">
                        <!-- Sliders icon: three horizontal bars with offset knobs -->
                        <Canvas Width="14" Height="14">
                            <Line X1="1" Y1="3" X2="13" Y2="3" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="1" Y1="7" X2="13" Y2="7" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="1" Y1="11" X2="13" Y2="11" Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Ellipse Canvas.Left="3" Canvas.Top="1" Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/>
                            <Ellipse Canvas.Left="8" Canvas.Top="5" Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/>
                            <Ellipse Canvas.Left="5" Canvas.Top="9" Width="4" Height="4" Fill="{DynamicResource AccentBrush}"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="ThemeToggleButton"
                            Click="ThemeToggle_Click"
                            Style="{DynamicResource MarathonBtnIcon}"
                            ToolTip="Toggle Light/Dark Mode"
                            Width="28" Height="28"
                            Margin="0,0,2,0">
                        <!-- Half-circle contrast icon -->
                        <Canvas x:Name="ThemeToggleIcon" Width="14" Height="14">
                            <Path Data="M 7,1 A 6,6 0 1 1 7,13 A 6,6 0 0 1 7,1 Z"
                                  Stroke="{DynamicResource TextTertiaryBrush}" StrokeThickness="1.3"
                                  Fill="Transparent"/>
                            <Path Data="M 7,1 A 6,6 0 0 1 7,13 Z"
                                  Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Canvas>
                    </Button>
                    <Button x:Name="ExportImportMenuButton"
                            Click="ExportImportMenu_Click"
                            Style="{DynamicResource MarathonBtnIcon}"
                            ToolTip="Export/Import Options"
                            Width="28" Height="28">
                        <!-- Vertical three-dot menu icon -->
                        <Canvas Width="14" Height="14">
                            <Ellipse Canvas.Left="5.5" Canvas.Top="1.5" Width="3" Height="3" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Ellipse Canvas.Left="5.5" Canvas.Top="5.5" Width="3" Height="3" Fill="{DynamicResource TextTertiaryBrush}"/>
                            <Ellipse Canvas.Left="5.5" Canvas.Top="9.5" Width="3" Height="3" Fill="{DynamicResource TextTertiaryBrush}"/>
                        </Canvas>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ExportImportMenu">
                                <MenuItem Header="📄 Export to CSV"
                                          Command="{Binding ExportToCsvCommand}"
                                          InputGestureText="Ctrl+Shift+E"
                                          ToolTip="Export items to CSV format"/>
                                <MenuItem Header="📋 Export to JSON"
                                          Command="{Binding ExportToJsonCommand}"
                                          InputGestureText="Ctrl+Shift+J"
                                          ToolTip="Export items to JSON format"/>
                                <Separator/>
                                <MenuItem Header="📥 Import from CSV"
                                          Command="{Binding ImportFromCsvCommand}"
                                          InputGestureText="Ctrl+Shift+I"
                                          ToolTip="Import items from CSV file"/>
                                <Separator/>
                                <MenuItem Header="🔧 Repair Archive Data"
                                          Command="{Binding RepairArchivedItemsCommand}"
                                          ToolTip="Move completed items that got stuck in the active list to the archive"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Notes Side Drawer Overlay — slides in over the header + orders list (keeps player visible) -->
        <Grid x:Name="NotesDrawerOverlay" Grid.RowSpan="4" Panel.ZIndex="200" Visibility="Collapsed">
            <!-- Scrim: darkens the content behind the drawer -->
            <Border x:Name="NotesScrim"
                    Background="#CC000000"
                    Opacity="0"
                    MouseLeftButtonDown="NotesScrim_Click"/>

            <!-- Drawer panel -->
            <Border x:Name="NotesDrawer"
                    HorizontalAlignment="Stretch"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="NotesDrawerTransform" X="600"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.55" Color="#000000"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Drawer header -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SurfaceHoverBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Amber left accent bar -->
                            <Border Grid.Column="0"
                                    Background="{DynamicResource WarningBrush}"
                                    Width="4"/>

                            <!-- Title area -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="12,12,8,12">
                                <TextBlock Text="NOTES"
                                           FontSize="12" FontWeight="Bold"
                                           VerticalAlignment="Center"/>
                                <Border CornerRadius="8" Background="{DynamicResource WarningBrush}"
                                        Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Center"
                                        Visibility="{Binding StickyNotes.Count, Converter={StaticResource IntToVisibilityConverter}}">
                                    <TextBlock Text="{Binding StickyNotes.Count}"
                                               FontSize="10" FontWeight="Bold"
                                               Foreground="#1A1A1A"/>
                                </Border>
                            </StackPanel>

                            <!-- Actions: add + close -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        VerticalAlignment="Center" Margin="0,0,6,0">
                                <Button Click="AddBlankNote_Click"
                                        Style="{DynamicResource MarathonBtnIcon}"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="Add new note">
                                    <TextBlock Text="+" FontSize="18" FontWeight="Light"
                                               Foreground="{DynamicResource WarningBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Button>
                                <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}"
                                        VerticalAlignment="Center" Margin="2,0" Opacity="0.6"/>
                                <Button x:Name="NotesDrawerCloseButton"
                                        Click="NotesDrawerClose_Click"
                                        Style="{DynamicResource MarathonBtnIcon}"
                                        Width="32" Height="32" Padding="0"
                                        ToolTip="Close">
                                    <TextBlock Text="✕" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsHitTestVisible="False"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable notes list -->
                    <ScrollViewer Grid.Row="1" Style="{StaticResource WidgetScrollViewerStyle}" Padding="0,4,0,4">
                        <StackPanel x:Name="NotesSection" Margin="0,0,0,8">
                            <ItemsControl ItemsSource="{Binding StickyNotes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Margin" Value="0,0,0,10"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StickyNoteTemplate}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty state -->
                            <Border Margin="8,4,8,8" Padding="20,24"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="{DynamicResource RadiusLg}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StickyNotes.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="📝" FontSize="28" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                    <TextBlock Text="No notes yet"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBlock Text="Add a note above to get started"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextTertiaryBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

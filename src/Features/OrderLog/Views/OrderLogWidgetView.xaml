<UserControl x:Class="SOUP.Features.OrderLog.Views.OrderLogWidgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:models="clr-namespace:SOUP.Features.OrderLog.Models"
             xmlns:converters="clr-namespace:SOUP.Features.OrderLog.Converters"
             xmlns:commonConverters="clr-namespace:SOUP.Converters"
             xmlns:vm="clr-namespace:SOUP.Features.OrderLog.ViewModels"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:behaviors="clr-namespace:SOUP.Features.OrderLog.Behaviors"
             KeyDown="UserControl_KeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <!-- Marathon Design System — deep space neon HUD -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/Marathon/MarathonTheme.xaml"/>
                <ResourceDictionary Source="../Themes/OrderLogWidgetTheme.xaml"/>
                <ResourceDictionary Source="../Themes/ModernHeaderStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <commonConverters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <commonConverters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StatusToCardBrushConverter x:Key="StatusToCardBrushConverter"/>
        <converters:ShowForOrdersConverter x:Key="ShowForOrdersConverter"/>
        <converters:ShowForNotesConverter x:Key="ShowForNotesConverter"/>
        <converters:LinkedGroupToVisibilityConverter x:Key="LinkedGroupToVisibilityConverter"/>
        <converters:HexToBrushConverter x:Key="HexToBrushConverter"/>
        <converters:HexToColorConverter x:Key="HexToColorConverter"/>
        <converters:XamlToPlainTextConverter x:Key="XamlToPlainTextConverter"/>
        <converters:IsLinkSourceToBrushConverter x:Key="IsLinkSourceToBrushConverter"/>
        <converters:IsLinkSourceToThicknessConverter x:Key="IsLinkSourceToThicknessConverter"/>

        <!-- Status-coloured ComboBox item style: tinted hover background per status -->
        <Style x:Key="StatusComboBoxItemStyle" TargetType="ComboBoxItem" BasedOn="{StaticResource MarathonComboBoxItemStyle}">
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.NotReady}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#22DD0025"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.OnDeck}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#22D97000"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.InProgress}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#22008035"/>
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="{x:Static models:OrderItem+OrderStatus.Done}"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="#22888888"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Modern Editable Field Style - Clean inline editing with focus indicator -->
        <Style x:Key="ModernEditableFieldStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="SelectionOpacity" Value="0.4"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border x:Name="FocusIndicator"
                                    BorderThickness="0,0,0,2"
                                    BorderBrush="{DynamicResource AccentBrush}"
                                    Opacity="0"
                                    SnapsToDevicePixels="True"/>
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusIndicator"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.6" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="FocusIndicator"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Copy Button Style - Enhanced for better UX -->
        <Style x:Key="FieldCopyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="Copy to clipboard"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="4">
                            <Border.Effect>
                                <DropShadowEffect x:Name="Shadow"
                                                  Color="#000000"
                                                  BlurRadius="0"
                                                  ShadowDepth="0"
                                                  Opacity="0"/>
                            </Border.Effect>
                            <Path x:Name="Icon"
                                  Data="M16,1H4C2.9,1,2,1.9,2,3v14h2V3h12V1z M19,5H8C6.9,5,6,5.9,6,7v14c0,1.1,0.9,2,2,2h11c1.1,0,2-0.9,2-2V7C21,5.9,20.1,5,19,5z M19,21H8V7h11V21z"
                                  Fill="{DynamicResource TextSecondaryBrush}"
                                  Stretch="Uniform"
                                  Width="13"
                                  Height="13"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                                </Path.RenderTransform>
                            </Path>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource TextPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0.1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="4" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="Opacity"
                                                           To="0" Duration="0:0:0.15"/>
                                            <DoubleAnimation Storyboard.TargetName="Shadow"
                                                           Storyboard.TargetProperty="BlurRadius"
                                                           To="0" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource TextOnPrimaryBrush}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="0.95" Duration="0:0:0.05"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="0.95" Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleX"
                                                           To="1" Duration="0:0:0.1"/>
                                            <DoubleAnimation Storyboard.TargetName="IconScale"
                                                           Storyboard.TargetProperty="ScaleY"
                                                           To="1" Duration="0:0:0.1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Note Toolbar Button Style -->
        <Style x:Key="NoteToolbarButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceActiveBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

                <DataTemplate x:Key="OrderItemTemplate" DataType="{x:Type models:OrderItem}">
                    <!-- Outer border for link mode highlighting -->
                    <Border x:Name="LinkHighlightBorder" Margin="6" CornerRadius="4" Padding="2"
                            MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                        <Border.BorderBrush>
                            <MultiBinding Converter="{StaticResource IsLinkSourceToBrushConverter}">
                                <Binding Path="."/>
                                <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Border.BorderBrush>
                        <Border.BorderThickness>
                            <MultiBinding Converter="{StaticResource IsLinkSourceToThicknessConverter}">
                                <Binding Path="."/>
                                <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                            </MultiBinding>
                        </Border.BorderThickness>
                    <Border Style="{StaticResource OrderLogWidgetElevatedCardStyle}" ClipToBounds="True"
                            MouseLeftButtonDown="Card_MouseLeftButtonDown" KeyDown="Card_KeyDown" Focusable="True">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="Set Status">
                                    <MenuItem Header="Not Ready" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}"/>
                                    <MenuItem Header="On Deck" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}"/>
                                    <MenuItem Header="In Progress" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}"/>
                                </MenuItem>
                                <MenuItem Header="Reset Timer">
                                    <MenuItem Header="Reset In Progress Timer" Click="ResetInProgressTimer_Click"/>
                                    <MenuItem Header="Reset On Deck Timer" Click="ResetOnDeckTimer_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Reset All Timers" Click="ResetAllTimers_Click"/>
                                </MenuItem>
                                <Separator/>
                                <MenuItem Header="Change Color..." Click="ChangeColor_Click" CommandParameter="{Binding}"/>
                                <MenuItem Header="Unlink" Click="Unlink_Click" ToolTip="Remove this order from its linked group"/>
                                <Separator/>
                                <MenuItem Header="Archive" Click="QuickArchive_Click" InputGestureText="Del"/>
                                <MenuItem Header="Delete" Click="DeleteNote_Click" Foreground="{DynamicResource DangerBrush}" InputGestureText="Ctrl+Del"/>
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Height="{StaticResource CardColorBarHeight}" CornerRadius="4,4,0,0"
                            Background="{Binding Status, Converter={StaticResource StatusToColorConverter}}" MouseLeftButtonDown="ColorBar_Click"/>

                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10" Margin="0" MinHeight="36" Panel.ZIndex="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Multi-select checkbox (visible when multi-select mode is active) -->
                            <CheckBox Grid.Column="0"
                                      Tag="{Binding}"
                                      Margin="0,0,12,0"
                                      VerticalAlignment="Center"
                                      Visibility="Collapsed"/>

                            <!-- Link Count Badge -->
                            <Border Grid.Column="1"
                                    Background="{DynamicResource PrimaryBrush}"
                                    CornerRadius="3"
                                    Padding="8,4"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    ToolTip="This order is linked with other orders"
                                    Visibility="{Binding LinkedItemCount, Converter={StaticResource IntToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔗" FontSize="11" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding LinkedItemCount}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <!-- Vendor Name Display -->
                            <Grid Grid.Column="2">
                                <TextBlock Text="Vendor name..."
                                           FontSize="{DynamicResource CardFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextDisabledBrush}"
                                           FontStyle="Italic"
                                           IsHitTestVisible="False"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding VendorName}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding VendorName}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding VendorName, UpdateSourceTrigger=LostFocus}"
                                         Style="{StaticResource ModernEditableFieldStyle}"
                                         FontSize="{DynamicResource CardFontSize}"
                                         FontWeight="SemiBold"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         VerticalAlignment="Center"
                                         TabIndex="0"
                                         GotFocus="EditableField_GotFocus"
                                         LostFocus="EditableField_LostFocus">
                                    <i:Interaction.Behaviors>
                                        <behaviors:VendorAutocompleteBehavior/>
                                    </i:Interaction.Behaviors>
                                </TextBox>
                            </Grid>

                            <!-- Status ComboBox -->
                            <ComboBox Grid.Column="3"
                                      HorizontalAlignment="Right"
                                      SelectedValue="{Binding Status, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="StatusComboBox_SelectionChanged"
                                      TabIndex="1"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Padding="8,6"
                                      MinHeight="28"
                                      MinWidth="120"
                                      Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                      Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="Not Ready" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="On Deck" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="In Progress" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="Done" Tag="{x:Static models:OrderItem+OrderStatus.Done}" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                            </ComboBox>

                            <!-- Link Button -->
                            <Button Grid.Column="4" Click="LinkButton_Click" ToolTip="Link with another order" IsTabStop="False"
                                    VerticalAlignment="Center" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="Opacity" Value="0.5"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="🔗" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="16,12">
                        <!-- Editable Transfer Numbers -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                    Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}" IsTabStop="False"/>
                            <TextBlock Grid.Column="1" Text="Transfer #s..."
                                       FontSize="{DynamicResource CardFontSize}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Text="{Binding TransferNumbers, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernEditableFieldStyle}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="{DynamicResource CardFontSize}"
                                     TabIndex="2"
                                     GotFocus="EditableField_GotFocus"
                                     LostFocus="EditableField_LostFocus"/>
                        </Grid>

                        <!-- Editable WHS Shipment Numbers -->
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                    Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}" IsTabStop="False"/>
                            <TextBlock Grid.Column="1" Text="WHS #s..."
                                       FontSize="{DynamicResource CardFontSize}"
                                       Foreground="{DynamicResource TextDisabledBrush}"
                                       FontStyle="Italic"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Grid.Column="1"
                                     Text="{Binding WhsShipmentNumbers, UpdateSourceTrigger=LostFocus}"
                                     Style="{StaticResource ModernEditableFieldStyle}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     FontSize="{DynamicResource CardFontSize}"
                                     TabIndex="3"
                                     GotFocus="EditableField_GotFocus"
                                     LostFocus="EditableField_LostFocus"/>
                        </Grid>

                        <!-- TimeInProgress Display -->
                        <TextBlock Text="{Binding TimeInProgressDisplay}"
                                   Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   FontFamily="Consolas"
                                   Margin="0,6,0,0"/>

                        <!-- TimeOnDeck Display -->
                        <TextBlock Text="{Binding TimeOnDeckDisplay}"
                                   Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}"
                                   FontSize="{DynamicResource CardFontSize}"
                                   FontFamily="Consolas"
                                   FontWeight="SemiBold"
                                   Margin="0,2,0,0"/>

                        <!-- Created timestamp -->
                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                   FontSize="10"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   HorizontalAlignment="Right"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
            </Border>
        </DataTemplate>

        <!-- Modern Sticky Note Template - Clean, minimal design with inline toolbar -->
        <DataTemplate x:Key="StickyNoteTemplate" DataType="{x:Type models:OrderItem}">
            <Border x:Name="NoteCard" Margin="0,0,0,1" CornerRadius="0" Padding="0">
                <Border.Background>
                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" Opacity="0.15"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{Binding ColorHex, Converter={StaticResource HexToColorConverter}}" Opacity="0.4"/>
                </Border.BorderBrush>
                <Border.BorderThickness>1.5</Border.BorderThickness>
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.1" Direction="270" Color="#000000"/>
                </Border.Effect>
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Change Color..." Click="ChangeColor_Click" CommandParameter="{Binding}"/>
                        <Separator/>
                        <MenuItem Header="Archive" Click="ArchiveNote_Click"/>
                        <MenuItem Header="Delete" Click="DeleteNote_Click" Foreground="{DynamicResource DangerBrush}"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Color accent bar -->
                    <Border Grid.Row="0" Height="3" CornerRadius="4,4,0,0"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>

                    <!-- Note content area -->
                    <Grid Grid.Row="1" Margin="16,12,16,8" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <!-- Placeholder text -->
                        <TextBlock Grid.Column="0"
                                   Text="Write your note..."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontStyle="Italic"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Top"
                                   TextWrapping="Wrap"
                                   Margin="2,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NoteContent}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NoteContent}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- RichTextBox for formatted note content -->
                        <RichTextBox x:Name="NoteRichTextBox"
                                     Grid.Column="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                     FontSize="13"
                                     Padding="0"
                                     MinHeight="60"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     Focusable="True"
                                     IsReadOnly="False"
                                     IsUndoEnabled="True"
                                     VerticalScrollBarVisibility="Auto"
                                     SpellCheck.IsEnabled="True"
                                     PreviewMouseLeftButtonDown="NoteContent_PreviewMouseLeftButtonDown"
                                     PreviewKeyDown="NoteContent_PreviewKeyDown"
                                     Loaded="NoteContent_Loaded"
                                     LostFocus="NoteContent_LostFocus"
                                     GotFocus="EditableField_GotFocus"
                                     Cursor="IBeam">
                            <RichTextBox.InputBindings>
                                <KeyBinding Key="B" Modifiers="Control" Command="EditingCommands.ToggleBold"/>
                                <KeyBinding Key="I" Modifiers="Control" Command="EditingCommands.ToggleItalic"/>
                                <KeyBinding Key="U" Modifiers="Control" Command="EditingCommands.ToggleUnderline"/>
                                <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo"/>
                                <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo"/>
                            </RichTextBox.InputBindings>
                        </RichTextBox>

                        <!-- Floating action buttons (separate column, not overlapping) -->
                        <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Top" Margin="4,0,0,0">
                            <!-- Archive button -->
                            <Button Click="QuickArchive_Click" ToolTip="Archive" Cursor="Hand" Margin="0,0,0,4" Focusable="False">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="6"/>
                                        <Setter Property="Opacity" Value="0.4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="1"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Compact formatting toolbar -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource SurfaceBrush}"
                            CornerRadius="0,0,4,4"
                            Padding="8,7,8,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Formatting buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <!-- Bold -->
                                <Button Click="FormatBold_Click" Tag="{Binding}" ToolTip="Bold (Ctrl+B)" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="B" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <!-- Italic -->
                                <Button Click="FormatItalic_Click" Tag="{Binding}" ToolTip="Italic (Ctrl+I)" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="I" FontStyle="Italic" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <!-- Underline -->
                                <Button Click="FormatUnderline_Click" Tag="{Binding}" ToolTip="Underline (Ctrl+U)" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="U" TextDecorations="Underline" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                
                                <Border Width="1" Height="14" Background="{DynamicResource BorderBrush}" Margin="6,0"/>

                                <!-- Bullet -->
                                <Button Click="InsertBullet_Click" Tag="{Binding}" ToolTip="Bullet List" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="•" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,-2,0,0"/>
                                </Button>
                                <!-- Checkbox -->
                                <Button Click="InsertCheckbox_Click" Tag="{Binding}" ToolTip="Checkbox" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="☐" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Button>
                                <!-- Timestamp -->
                                <Button Click="InsertTimestamp_Click" Tag="{Binding}" ToolTip="Insert Timestamp" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                    <TextBlock Text="⏱" FontSize="11"/>
                                </Button>
                            </StackPanel>

                            <!-- Color picker button -->
                            <Button Grid.Column="1" Click="ChangeColor_Click" CommandParameter="{Binding}" ToolTip="Change Color" Focusable="False" Style="{StaticResource NoteToolbarButton}">
                                <Border Width="16" Height="16" CornerRadius="4" 
                                        Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"
                                        BorderThickness="1" BorderBrush="{DynamicResource BorderBrush}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for archived Order cards -->
        <DataTemplate x:Key="ArchivedOrderItemTemplate" DataType="{x:Type models:OrderItem}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Restore" Click="UnarchiveNote_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="DeleteArchivedNote_Click" Foreground="{DynamicResource DangerBrush}" InputGestureText="Ctrl+Del"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Color Bar (Done status = muted gray) -->
                    <Border Grid.Row="0" CornerRadius="4,4,0,0" Height="{StaticResource CardColorBarHeight}"
                            Background="{DynamicResource TextTertiaryBrush}"/>

                    <!-- Header -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10" Margin="0" MinHeight="36" Panel.ZIndex="50">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical" Grid.Column="0">
                                <TextBox Text="{Binding VendorName}" FontSize="{DynamicResource CardFontSize}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                         Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam"
                                         Padding="0" Margin="0"/>
                            </StackPanel>

                            <!-- Restore Button -->
                            <Button Grid.Column="1" Click="QuickArchive_Click" ToolTip="Restore" Cursor="Hand" Margin="4,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="↩️ Restore" FontSize="{DynamicResource CardFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <StackPanel Grid.Row="2" Margin="16,14">
                        <TextBox Text="{Binding TransferNumbers}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource CardFontSize}" Margin="0,0,0,4"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        <TextBox Text="{Binding WhsShipmentNumbers}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource CardFontSize}" Margin="0,0,0,4"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        <TextBox Text="{Binding TimeInProgressDisplay}" Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}" FontSize="{DynamicResource CardFontSize}" FontFamily="Consolas"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        <TextBox Text="{Binding TimeOnDeckDisplay}" Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}" FontSize="{DynamicResource CardFontSize}" FontFamily="Consolas" FontWeight="SemiBold" Margin="0,4,0,0"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                    </StackPanel>
                    
                    <!-- Footer with timestamp -->
                    <TextBlock Grid.Row="3" Text="{Binding CreatedAtDisplay}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Right" Margin="0,4,16,8"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for archived Sticky Note cards -->
        <!-- Template for archived Sticky Note - fluid body-only design -->
        <DataTemplate x:Key="ArchivedStickyNoteTemplate" DataType="{x:Type models:OrderItem}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0" Opacity="0.7">
                <Border.ContextMenu>
                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                        <MenuItem Header="Restore" Click="UnarchiveNote_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete" Click="DeleteArchivedNote_Click" Foreground="{DynamicResource DangerBrush}" InputGestureText="Ctrl+Del"/>
                    </ContextMenu>
                </Border.ContextMenu>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="6"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Thin color accent bar -->
                    <Border Grid.Row="0" CornerRadius="4,4,0,0" Height="6" Margin="-16,-12,-16,0"
                            Background="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>

                    <!-- Note content area (read-only for archived) -->
                    <Grid Grid.Row="1" Margin="14,12,14,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0"
                                  Tag="{Binding}"
                                  Margin="0,0,12,0"
                                  VerticalAlignment="Center"
                                  Visibility="Collapsed"/>

                        <TextBox Grid.Column="1" Text="{Binding NoteContent, Converter={StaticResource XamlToPlainTextConverter}}" 
                                 Foreground="{DynamicResource TextSecondaryBrush}" 
                                 FontSize="{DynamicResource CardFontSize}" 
                                 TextWrapping="Wrap" 
                                 MaxHeight="80"
                                 Background="Transparent" BorderThickness="0" IsReadOnly="True" IsReadOnlyCaretVisible="False" Cursor="IBeam" Padding="0"/>
                        
                        <!-- Restore button (show on hover) -->
                        <Button Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0"
                                Click="QuickArchive_Click" ToolTip="Restore" Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="5"/>
                                    <Setter Property="Opacity" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                    <TextBlock Text="↩️" FontSize="11" Opacity="0.8"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=2}, Path=IsMouseOver}" Value="True">
                                            <DataTrigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.EnterActions>
                                            <DataTrigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </DataTrigger.ExitActions>
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <!-- Footer with timestamp -->
                    <TextBlock Grid.Row="2" Text="{Binding CreatedAtDisplay}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                               HorizontalAlignment="Right" Margin="0,4,12,8"/>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Template for merged order cards in widget view (vertical stacking) -->
        <DataTemplate x:Key="OrderItemGroupMergedTemplate" DataType="{x:Type vm:OrderItemGroup}">
            <!-- Outer border for link mode highlighting -->
            <Border x:Name="LinkHighlightBorder" Margin="0" CornerRadius="4" Padding="2"
                    MouseEnter="Card_MouseEnter" MouseLeave="Card_MouseLeave">
                <Border.BorderBrush>
                    <MultiBinding Converter="{StaticResource IsLinkSourceToBrushConverter}">
                        <Binding Path="."/>
                        <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <MultiBinding Converter="{StaticResource IsLinkSourceToThicknessConverter}">
                        <Binding Path="."/>
                        <Binding Path="DataContext.LinkModeSource" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                        <Binding Path="DataContext.IsLinkMode" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                    </MultiBinding>
                </Border.BorderThickness>
            <Border Style="{DynamicResource OrderLogWidgetElevatedCardStyle}" ClipToBounds="True"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown" KeyDown="Card_KeyDown" Focusable="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Unified Color Bar -->
                    <Border Grid.Row="0" Height="{StaticResource CardColorBarHeight}" CornerRadius="4,4,0,0"
                            Background="{Binding First.Status, Converter={StaticResource StatusToColorConverter}}"/>

                    <!-- Unified Header Section -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}"
                            Padding="14,10" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="{DynamicResource CardFontSize}" Margin="0,0,6,0"/>
                                <TextBlock Text="Merged"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="3"
                                        Padding="5,2"
                                        Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} orders'}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Unified Status ComboBox -->
                            <ComboBox Grid.Column="1"
                                      SelectedValue="{Binding First.Status, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      SelectionChanged="UnifiedStatusComboBox_SelectionChanged"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Padding="8,6"
                                      MinHeight="28"
                                      MinWidth="120"
                                      Margin="0,0,8,0"
                                      Foreground="{Binding First.Status, Converter={StaticResource StatusToColorConverter}}"
                                      Style="{StaticResource ModernComboBoxStyle}">
                                <ComboBoxItem Content="Not Ready" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="On Deck" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="In Progress" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                <ComboBoxItem Content="Done" Tag="{x:Static models:OrderItem+OrderStatus.Done}" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Order Sections (Vertical Stack) -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}"
                                        Padding="14,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <!-- Remove bottom border on last section -->
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <!-- Section Header with unlink button -->
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding VendorName, TargetNullValue='Order'}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                       VerticalAlignment="Center"/>
                                            <!-- Unlink this item button -->
                                            <Button Grid.Column="1" Click="UnlinkSingleItem_Click" ToolTip="Remove from group" IsTabStop="False"
                                                    VerticalAlignment="Center">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Setter Property="BorderThickness" Value="0"/>
                                                        <Setter Property="Padding" Value="4"/>
                                                        <Setter Property="Cursor" Value="Hand"/>
                                                        <Setter Property="Opacity" Value="0.4"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="Button">
                                                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                                                                        <TextBlock Text="🔗" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>

                                        <!-- Editable VendorName -->
                                        <Grid>
                                            <TextBlock Text="Vendor name..."
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding VendorName}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding VendorName}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Text="{Binding VendorName, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource ModernEditableFieldStyle}"
                                                     FontSize="{DynamicResource CardFontSize}"
                                                     FontWeight="SemiBold"
                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                     GotFocus="EditableField_GotFocus"
                                                     LostFocus="EditableField_LostFocus">
                                                <i:Interaction.Behaviors>
                                                    <behaviors:VendorAutocompleteBehavior/>
                                                </i:Interaction.Behaviors>
                                            </TextBox>
                                        </Grid>

                                        <!-- Editable Transfer Numbers -->
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                    Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}"/>
                                            <TextBlock Grid.Column="1" Text="Transfer #s..."
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding TransferNumbers}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding TransferNumbers, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource ModernEditableFieldStyle}"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="{DynamicResource CardFontSize}"
                                                     GotFocus="EditableField_GotFocus"
                                                     LostFocus="EditableField_LostFocus"/>
                                        </Grid>

                                        <!-- Editable WHS Shipment Numbers -->
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}" 
                                                    Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}"/>
                                            <TextBlock Grid.Column="1" Text="WHS #s..."
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       Foreground="{DynamicResource TextDisabledBrush}"
                                                       FontStyle="Italic"
                                                       IsHitTestVisible="False"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding WhsShipmentNumbers, UpdateSourceTrigger=LostFocus}"
                                                     Style="{StaticResource ModernEditableFieldStyle}"
                                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                                     FontSize="{DynamicResource CardFontSize}"
                                                     GotFocus="EditableField_GotFocus"
                                                     LostFocus="EditableField_LostFocus"/>
                                        </Grid>

                                        <!-- TimeInProgress Display -->
                                        <TextBlock Text="{Binding TimeInProgressDisplay}"
                                                   Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="{DynamicResource CardFontSize}"
                                                   FontFamily="Consolas"
                                                   Margin="0,6,0,0"/>

                                        <!-- TimeOnDeck Display -->
                                        <TextBlock Text="{Binding TimeOnDeckDisplay}"
                                                   Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="{DynamicResource CardFontSize}"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>

                                        <!-- Created timestamp -->
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            </Border>
        </DataTemplate>

        <!-- Template for ARCHIVED merged order cards (no status dropdown, has restore button) -->
        <DataTemplate x:Key="ArchivedOrderItemGroupMergedTemplate" DataType="{x:Type vm:OrderItemGroup}">
            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Restore All" Click="UnarchiveGroup_Click"/>
                        <Separator/>
                        <MenuItem Header="Delete All" Click="DeleteArchivedGroup_Click" Foreground="{DynamicResource DangerBrush}"/>
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Unified Color Bar (Done status color) -->
                    <Border Grid.Row="0" Height="{StaticResource CardColorBarHeight}" CornerRadius="4,4,0,0"
                            Background="{DynamicResource TextTertiaryBrush}"/>

                    <!-- Unified Header Section -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}"
                            Padding="14,10" Margin="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔗" FontSize="{DynamicResource CardFontSize}" Margin="0,0,6,0"/>
                                <TextBlock Text="Merged"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource AccentBrush}"
                                        CornerRadius="3"
                                        Padding="5,2"
                                        Margin="6,0,0,0">
                                    <TextBlock Text="{Binding Count, StringFormat='{}{0} orders'}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextOnPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- Restore Button instead of Status -->
                            <Button Grid.Column="1" Click="RestoreGroup_Click" ToolTip="Restore All" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                        <TextBlock Text="↩️ Restore" FontSize="{DynamicResource CardFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Order Sections (Vertical Stack) -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Members}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" Padding="14,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <StackPanel>
                                        <TextBlock Text="{Binding VendorName, TargetNullValue='Order'}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                   Margin="0,0,0,4"/>
                                        <TextBlock Text="{Binding TransferNumbers}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource CardFontSize}"/>
                                        <TextBlock Text="{Binding WhsShipmentNumbers}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{DynamicResource CardFontSize}" Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding TimeInProgressDisplay}"
                                                   Foreground="{Binding InProgressColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="{DynamicResource CardFontSize}"
                                                   FontFamily="Consolas"
                                                   Margin="0,4,0,0"/>

                                        <TextBlock Text="{Binding TimeOnDeckDisplay}"
                                                   Foreground="{Binding OnDeckColorHex, Converter={StaticResource HexToBrushConverter}}"
                                                   FontSize="{DynamicResource CardFontSize}"
                                                   FontFamily="Consolas"
                                                   FontWeight="SemiBold"
                                                   Margin="0,2,0,0"/>

                                        <!-- Created timestamp -->
                                        <TextBlock Text="{Binding CreatedAtDisplay}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Right"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.Style>
            <Style TargetType="Grid">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsLinkMode}" Value="True">
                        <Setter Property="Cursor" Value="Cross"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Grid.Style>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Marathon Toolbar — frosted dark header with neon accent border -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderThickness="0,0,0,1">
            <Border.BorderBrush>
                <SolidColorBrush Color="{DynamicResource BorderAccentColor}" Opacity="0.6"/>
            </Border.BorderBrush>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Marathon Tabs (only show when ShowArchived is true) -->
                <Border Grid.Row="0" Margin="16,14,16,0"
                        Visibility="{Binding ShowArchived, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource SurfaceSunkenBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="3"
                            Height="38">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Active Tab —  Marathon angular style -->
                            <Button x:Name="ActiveTabButton"
                                    Click="ActiveTab_Click"
                                    Style="{StaticResource WidgetTabButtonActiveStyle}"
                                    Height="32"
                                    Margin="0,0,2,0">
                                <TextBlock Text="ACTIVE"
                                           FontFamily="{DynamicResource FontMono}"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>

                            <!-- Archived Tab -->
                            <Button x:Name="ArchivedTabButton"
                                    Grid.Column="1"
                                    Click="ArchivedTab_Click"
                                    Style="{StaticResource WidgetTabButtonStyle}"
                                    Height="32"
                                    Margin="2,0,0,0">
                                <TextBlock Text="ARCHIVED"
                                           FontFamily="{DynamicResource FontMono}"
                                           FontSize="10" FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            </Button>
                        </Grid>
                    </Border>
                </Border>

                <!-- Row 1.5: Marathon Search Bar -->
                <Border Grid.Row="1" Padding="16,12,16,6"
                        Visibility="{Binding NotesOnlyMode, Converter={StaticResource InverseBoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Angular Marathon Search Box -->
                        <Border Grid.Column="0"
                                CornerRadius="3"
                                Height="36"
                                Margin="0,0,8,0"
                                BorderThickness="1"
                                Cursor="IBeam"
                                MouseLeftButtonDown="SearchBorder_MouseLeftButtonDown">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource SurfaceHoverColor}" Opacity="0.92"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource BorderColor}"/>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="0" Opacity="0.3"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Search Icon -->
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Margin="10,0,8,0" VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextSecondaryBrush}"
                                          IsHitTestVisible="False"/>

                                <!-- Search Input -->
                                <TextBox x:Name="SearchBox"
                                        Grid.Column="1"
                                        Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0,8"
                                        FontSize="13"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        CaretBrush="{DynamicResource AccentBrush}"
                                        VerticalAlignment="Center"
                                        IsEnabled="True"
                                        Focusable="True"
                                        KeyboardNavigation.IsTabStop="True"
                                        Panel.ZIndex="10">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <Grid>
                                                            <TextBlock Text="Search orders..."
                                                                      FontStyle="Italic"
                                                                      Foreground="{DynamicResource TextDisabledBrush}"
                                                                      IsHitTestVisible="False"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <ScrollViewer x:Name="PART_ContentHost" 
                                                                          Margin="0" 
                                                                          VerticalAlignment="Center"
                                                                          HorizontalScrollBarVisibility="Hidden"
                                                                          VerticalScrollBarVisibility="Hidden"/>
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Clear Search Button -->
                                <Button Grid.Column="2" Command="{Binding ClearSearchCommand}"
                                        Visibility="{Binding IsSearchActive, Converter={StaticResource BoolToVis}}"
                                        Width="24" Height="24" Margin="4,0,6,0"
                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                        ToolTip="Clear search">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="3">
                                                            <TextBlock Text="✕" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                      Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Modern Filter Button - Hidden -->
                        <Button Grid.Column="1"
                                Width="48" Height="48"
                                ToolTip="Advanced Filters"
                                Click="ShowFilters_Click"
                                Visibility="Collapsed"
                                Style="{StaticResource ModernIconButtonStyle}">
                            <Border CornerRadius="4"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    Width="48" Height="48">
                                <Border.Effect>
                                    <DropShadowEffect Color="#20000000" BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>
                                <TextBlock Text="⚙" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </Button>
                    </Grid>
                </Border>

                <!-- Row 2: Action Bar (only show on Active tab) -->
                <Grid Grid.Row="2" x:Name="AddButtonsPanel" Margin="16,6,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Marathon: Add Order button -->
                    <Button Click="AddBlankOrder_Click" Grid.Column="0"
                            Visibility="{Binding NotesOnlyMode, Converter={StaticResource InverseBoolToVis}}"
                            Style="{StaticResource ModernPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontFamily="{DynamicResource FontMono}"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="ORDER" FontFamily="{DynamicResource FontMono}"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Marathon: Add Note button (normal mode) -->
                    <Button Click="AddBlankNote_Click" Grid.Column="2"
                            Visibility="{Binding NotesOnlyMode, Converter={StaticResource InverseBoolToVis}}"
                            Style="{StaticResource ModernPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontFamily="{DynamicResource FontMono}"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="NOTE" FontFamily="{DynamicResource FontMono}"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Marathon: Add Note button (notes-only mode) -->
                    <Button Click="AddBlankNote_Click" Grid.Column="0" Grid.ColumnSpan="3"
                            Visibility="{Binding NotesOnlyMode, Converter={StaticResource BoolToVis}}"
                            Style="{StaticResource ModernPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="+" FontFamily="{DynamicResource FontMono}"
                                       FontSize="14" FontWeight="Bold" Margin="0,0,6,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="NOTE" FontFamily="{DynamicResource FontMono}"
                                       FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Button>

                    <!-- Modern Sort direction toggle button - Hidden -->
                    <Button Grid.Column="4" Click="SortToggle_Click" ToolTip="Toggle sort direction"
                            Visibility="Collapsed"
                            Style="{StaticResource ModernIconButtonStyle}">
                        <Border CornerRadius="3"
                                Background="{DynamicResource SurfaceHoverBrush}"
                                Width="40" Height="40">
                            <TextBlock x:Name="SortSymbol" FontSize="18" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="↑"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SortStatusDescending}" Value="True">
                                                <Setter Property="Text" Value="↓"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Button>

                    <!-- Multi-select removed: toggle button omitted -->

                    
                </Grid>

                <!-- Multi-select removed -->

                <!-- Row 3: Notes Header — Marathon accent stripe -->
                <Border Grid.Row="3"
                        Padding="16,0,16,10"
                        x:Name="NotesHeaderPanel">
                    <Border Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="3"
                            Padding="12,7"
                            Cursor="Hand"
                            MouseLeftButtonDown="NotesHeader_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="2" Height="12" CornerRadius="0" Background="{DynamicResource WarningBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="Notes" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding StickyNotes.Count}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="3" x:Name="NotesArrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- Notes List with bottom fade overlay -->
        <Grid Grid.Row="3">
            <ScrollViewer x:Name="MainScrollViewer" Padding="0,4,0,4" Style="{StaticResource WidgetScrollViewerStyle}">
                <Grid>
                    <!-- Active Notes Panel -->
                    <StackPanel x:Name="ActiveItemsPanel">

                    <!-- Add Order Card (Inline) -->
                    <Border x:Name="AddOrderCard"
                            Visibility="Collapsed"
                            Style="{StaticResource OrderLogWidgetElevatedCardStyle}"
                            Background="{DynamicResource SurfaceBrush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Header -->
                            <Border Grid.Row="0"
                                    Background="{DynamicResource SurfaceHoverBrush}"
                                    Padding="14,10"
                                    CornerRadius="4,4,0,0">
                                <Grid>
                                    <TextBlock Text="Add New Order"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <Button Content="✕"
                                            HorizontalAlignment="Right"
                                            Click="CancelAddOrder_Click"
                                            Style="{DynamicResource MarathonBtnIcon}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            Width="28"
                                            Height="28"
                                            FontSize="12"
                                            Padding="0"/>
                                </Grid>
                            </Border>

                            <!-- Form -->
                            <StackPanel Grid.Row="1" Margin="14,14,14,16">
                                <!-- Vendor Name -->
                                <TextBlock Text="Vendor Name"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="InlineVendorNameBox"
                                         Background="{DynamicResource SurfaceActiveBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderAccentBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         Margin="0,0,0,10">
                                    <i:Interaction.Behaviors>
                                        <behaviors:VendorAutocompleteBehavior/>
                                    </i:Interaction.Behaviors>
                                </TextBox>

                                <!-- Transfer Numbers -->
                                <TextBlock Text="Transfer Numbers (Optional)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="InlineTransferNumbersBox"
                                         Background="{DynamicResource SurfaceActiveBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderAccentBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         Margin="0,0,0,10"/>

                                <!-- Warehouse Shipment Numbers -->
                                <TextBlock Text="Warehouse Shipment Numbers (Optional)"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <TextBox x:Name="InlineWhsShipmentNumbersBox"
                                         Background="{DynamicResource SurfaceActiveBrush}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         BorderBrush="{DynamicResource BorderAccentBrush}"
                                         BorderThickness="1"
                                         Padding="10,6"
                                         FontSize="13"
                                         Margin="0,0,0,10"/>

                                <!-- Status -->
                                <TextBlock Text="Status"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0,0,0,4"/>
                                <ComboBox x:Name="InlineStatusComboBox"
                                          Style="{DynamicResource ModernComboBoxStyle}"
                                          Background="{DynamicResource SurfaceActiveBrush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderAccentBrush}"
                                          BorderThickness="1"
                                          Padding="10,6"
                                          FontSize="13"
                                          Margin="0,0,0,14"
                                        SelectedValuePath="Tag"
                                        SelectedValue="{x:Static models:OrderItem+OrderStatus.NotReady}">
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" IsSelected="True">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WidgetStatusNotReadyBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="Not Ready" Foreground="{DynamicResource WidgetStatusNotReadyBrush}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WidgetStatusOnDeckBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="On Deck" Foreground="{DynamicResource WidgetStatusOnDeckBrush}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="{x:Static models:OrderItem+OrderStatus.InProgress}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Fill="{DynamicResource WidgetStatusInProgressBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="In Progress" Foreground="{DynamicResource WidgetStatusInProgressBrush}"/>
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>

                                <!-- Buttons -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="Cancel"
                                            Click="CancelAddOrder_Click"
                                            Style="{DynamicResource MarathonBtn}"
                                            Padding="0,8"/>

                                    <Button Grid.Column="2"
                                            Content="Add Order"
                                            Click="ConfirmAddOrder_Click"
                                            Style="{DynamicResource MarathonBtnPrimary}"
                                            Padding="0,8"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Notes Section -->
                    <Grid x:Name="NotesSection" Margin="0,0,0,8">
                        <ItemsControl ItemsSource="{Binding StickyNotes}" Margin="0,0,0,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource StickyNoteTemplate}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <TextBlock Text="No notes yet. Click 'Add Note' to create one."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextDisabledBrush}"
                                   FontStyle="Italic"
                                   Margin="12,8"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StickyNotes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Flat List View (hidden - status headers always visible) -->
                    <ListBox x:Name="ActiveItemsListBox" ItemsSource="{Binding DisplayItems}" BorderThickness="0" Background="Transparent"
                             Visibility="Collapsed"
                             VirtualizingStackPanel.IsVirtualizing="False"
                             VirtualizingStackPanel.VirtualizationMode="Standard"
                             ScrollViewer.CanContentScroll="False">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,14"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <!-- Replace the default template to eliminate selection visuals entirely -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Background="Transparent"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <!-- Default: Display single item -->
                                        <Setter Property="ContentTemplate">
                                            <Setter.Value>
                                                <DataTemplate>
                                                    <ContentControl Content="{Binding First}">
                                                        <ContentControl.ContentTemplate>
                                                                <DataTemplate>
                                                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <!-- ORDER MENU ITEMS -->
                                        <MenuItem Header="Set Status" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                            <MenuItem Header="Not Ready" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}"/>
                                            <MenuItem Header="On Deck" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}"/>
                                            <MenuItem Header="In Progress" Click="SetStatus_Click" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}"/>
                                        </MenuItem>
                                        <MenuItem Header="Reset Timer" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                            <MenuItem Header="Reset In Progress Timer" Click="ResetInProgressTimer_Click"/>
                                            <MenuItem Header="Reset On Deck Timer" Click="ResetOnDeckTimer_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Reset All Timers" Click="ResetAllTimers_Click"/>
                                        </MenuItem>
                                        <MenuItem Header="Move Up" Click="MoveUp_Click" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <MenuItem Header="Move Down" Click="MoveDown_Click" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <Separator Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <MenuItem Header="Unlink" Click="Unlink_Click" Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"/>
                                        <!-- NOTE MENU ITEMS -->
                                        <MenuItem Header="Change Color..." Click="ChangeColor_Click" CommandParameter="{Binding}" Visibility="{Binding NoteType, Converter={StaticResource ShowForNotesConverter}}"/>
                                        <!-- COMMON MENU ITEMS -->
                                        <Separator/>
                                        <MenuItem Header="Done (Archive)" Click="ArchiveNote_Click" FontWeight="SemiBold"/>
                                        <MenuItem Header="Delete" Click="DeleteNote_Click" Foreground="{DynamicResource DangerBrush}"/>
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="8"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Color Bar -->
                                    <Border Grid.Row="0" CornerRadius="4,4,0,0"
                                            Cursor="Hand"
                                            MouseLeftButtonDown="ColorBar_Click"
                                            Height="{StaticResource CardColorBarHeight}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding NoteType}" Value="{x:Static models:NoteType.StickyNote}">
                                                        <Setter Property="Background" Value="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <!-- Header (Vendor/Note title on left, Status + Drag handle on right) - HIDDEN FOR NOTES -->
                                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10" Margin="0" MinHeight="36" Panel.ZIndex="50"
                                            Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: Vendor name (orders) or Note title (notes) -->
                                            <StackPanel Orientation="Vertical">
                                                <Grid Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                                    <TextBlock Text="Vendor name..."
                                                               FontSize="{DynamicResource CardFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextDisabledBrush}"
                                                               FontStyle="Italic"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding VendorName}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding VendorName}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding VendorName, UpdateSourceTrigger=LostFocus}"
                                                             Background="Transparent"
                                                             BorderThickness="0"
                                                             FontSize="{DynamicResource CardFontSize}"
                                                             FontWeight="SemiBold"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             SelectionBrush="{DynamicResource AccentBrush}"
                                                             Padding="0">
                                                        <i:Interaction.Behaviors>
                                                            <behaviors:VendorAutocompleteBehavior/>
                                                        </i:Interaction.Behaviors>
                                                    </TextBox>
                                                </Grid>

                                                <Grid Visibility="{Binding NoteType, Converter={StaticResource ShowForNotesConverter}}">
                                                    <TextBlock Text="Note title..."
                                                               FontSize="{DynamicResource CardFontSize}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextDisabledBrush}"
                                                               FontStyle="Italic"
                                                               IsHitTestVisible="False"
                                                               VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding NoteTitle}" Value="">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding NoteTitle}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox x:Name="NoteTitleBoxHeader"
                                                             Text="{Binding NoteTitle, UpdateSourceTrigger=LostFocus}"
                                                             Style="{StaticResource ModernEditableFieldStyle}"
                                                             FontSize="{DynamicResource CardFontSize}"
                                                             FontWeight="SemiBold"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- Right: Status (col 1) and Drag Handle (col 2) -->
                                            <ComboBox Grid.Column="1" HorizontalAlignment="Right" Margin="0,0,8,0"
                                                      SelectedValue="{Binding Status, Mode=TwoWay}"
                                                      SelectedValuePath="Tag"
                                                      SelectionChanged="StatusComboBox_SelectionChanged"
                                                      FontSize="11"
                                                      FontWeight="SemiBold"
                                                      Padding="8,6"
                                                      MinHeight="28"
                                                      MinWidth="120"
                                                      Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}"
                                                      Foreground="{Binding Status, Converter={StaticResource StatusToColorConverter}}"
                                                      Style="{DynamicResource ModernComboBoxStyle}">
                                                <ComboBoxItem Content="Not Ready" Tag="{x:Static models:OrderItem+OrderStatus.NotReady}" Foreground="{DynamicResource DangerBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                                <ComboBoxItem Content="On Deck" Tag="{x:Static models:OrderItem+OrderStatus.OnDeck}" Foreground="{DynamicResource WarningBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                                <ComboBoxItem Content="In Progress" Tag="{x:Static models:OrderItem+OrderStatus.InProgress}" Foreground="{DynamicResource SuccessBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                                <ComboBoxItem Content="Done" Tag="{x:Static models:OrderItem+OrderStatus.Done}" Foreground="{DynamicResource TextTertiaryBrush}" Style="{StaticResource StatusComboBoxItemStyle}"/>
                                            </ComboBox>
                                        </Grid>
                                    </Border>

                                    <!-- Content -->
                                    <StackPanel Grid.Row="2" Margin="16,14">
                                        <TextBlock Text="🔗" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Visibility="{Binding LinkedItemCount, Converter={StaticResource IntToVisibilityConverter}}"/>
                                        <!-- Vendor/title moved into header; remove duplicate fields from body -->

                                        <!-- ORDER FIELDS (hidden for sticky notes) -->
                                        <StackPanel Visibility="{Binding NoteType, Converter={StaticResource ShowForOrdersConverter}}">
                                            
                                            <!-- Editable Transfer Numbers with inline drag handle (moved here for single-item cards) -->
                                            <Grid Margin="0,6,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}" 
                                                        Click="CopyTransferNumbers_Click" Tag="{Binding TransferNumbers}"/>

                                                <TextBlock Grid.Column="1" Text="Transfer #s..." 
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding TransferNumbers}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding TransferNumbers}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <TextBox Grid.Column="1"
                                                         Text="{Binding TransferNumbers, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource ModernEditableFieldStyle}"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="{DynamicResource CardFontSize}"
                                                         GotFocus="EditableField_GotFocus"
                                                         LostFocus="EditableField_LostFocus"/>
                                            </Grid>

                                            <!-- Editable WHS Shipment Numbers -->
                                            <Grid Margin="0,3,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}" 
                                                        Click="CopyWhsNumbers_Click" Tag="{Binding WhsShipmentNumbers}"/>
                                                <TextBlock Grid.Column="1" Text="WHS #s..." 
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding WhsShipmentNumbers}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBox Grid.Column="1"
                                                         Text="{Binding WhsShipmentNumbers, UpdateSourceTrigger=LostFocus}"
                                                         Style="{StaticResource ModernEditableFieldStyle}"
                                                         Foreground="{DynamicResource TextSecondaryBrush}"
                                                         FontSize="{DynamicResource CardFontSize}"
                                                         GotFocus="EditableField_GotFocus"
                                                         LostFocus="EditableField_LostFocus"/>
                                            </Grid>

                                            <TextBlock Text="{Binding TimeInProgressDisplay}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       FontFamily="Consolas"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                        
                                        <!-- STICKY NOTE CONTENT (visible only for sticky notes, with placeholder) -->
                                        <Grid Margin="0,-6,0,0">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding NoteType}" Value="{x:Static models:NoteType.StickyNote}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>

                                            <!-- Note content -->
                                            <Grid MinHeight="60">
                                                <TextBlock Text="Write your note..."
                                                           FontSize="{DynamicResource CardFontSize}"
                                                           Foreground="{DynamicResource TextDisabledBrush}"
                                                           FontStyle="Italic"
                                                           IsHitTestVisible="False"
                                                           VerticalAlignment="Top"
                                                           Margin="4,4,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NoteContent}" Value="">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding NoteContent}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <RichTextBox Background="Transparent"
                                                             BorderThickness="0"
                                                             Foreground="{DynamicResource TextPrimaryBrush}"
                                                             CaretBrush="{DynamicResource AccentBrush}"
                                                             FontSize="{DynamicResource CardFontSize}"
                                                             Padding="4"
                                                             MinHeight="40"
                                                             MinWidth="200"
                                                             HorizontalAlignment="Stretch"
                                                             AcceptsReturn="True"
                                                             IsDocumentEnabled="True"
                                                             VerticalScrollBarVisibility="Auto"
                                                             PreviewKeyDown="NoteContent_PreviewKeyDown"
                                                             Loaded="NoteContent_Loaded"
                                                             LostFocus="NoteContent_LostFocus"
                                                             GotFocus="EditableField_GotFocus"
                                                             Cursor="IBeam"/>
                                                
                                                <!-- Floating action buttons (always visible with good contrast) -->
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-4,0">
                                                    <Button Click="QuickArchive_Click" ToolTip="Archive" Cursor="Hand">
                                                        <Button.Style>
                                                            <Style TargetType="Button">
                                                                <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                <Setter Property="BorderThickness" Value="0"/>
                                                                <Setter Property="Padding" Value="6"/>
                                                                <Setter Property="Opacity" Value="0.7"/>
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="Button">
                                                                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                                <TextBlock Text="✓" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"/>
                                                                            </Border>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Opacity" Value="1"/>
                                                                        <Setter Property="Background" Value="{DynamicResource SuccessBrush}"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                    
                                    <!-- Footer with timestamp -->
                                    <TextBlock Grid.Row="3" 
                                               Text="{Binding CreatedAtDisplay}" 
                                               FontSize="10" 
                                               Foreground="{DynamicResource TextDisabledBrush}" 
                                               HorizontalAlignment="Right" 
                                               Margin="0,4,16,8"/>
                                </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ContentControl.ContentTemplate>
                                                    </ContentControl>
                                                </DataTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <!-- When IsGroup is true, use merged template -->
                                            <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- Grouped Status View (always visible) -->
                    <StackPanel x:Name="GroupedStatusPanel" Visibility="Visible">

                        <!-- In Progress Section -->
                        <Expander x:Name="InProgressExpander" IsExpanded="{Binding InProgressGroupExpanded, Mode=TwoWay}" Margin="0,0,0,8">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="{TemplateBinding Background}">
                                                    <DockPanel>
                                                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeaderBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="12,10" Margin="6,0"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Status accent stripe -->
                                                                            <Border Width="3" Height="16" Background="{DynamicResource WidgetStatusInProgressBrush}" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="IN PROGRESS" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                            <!-- Count badge -->
                                                                            <Border Grid.Column="2" Background="{DynamicResource WidgetStatusInProgressBgBrush}" CornerRadius="3" Padding="8,3" Margin="8,0,10,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DataContext.InProgressCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetStatusInProgressBrush}" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="3" x:Name="Arrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding InProgressItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="0,0,0,8">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                                            <Setter Property="Content" Value="{Binding First}"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OrderItemTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- On Deck Section -->
                        <Expander x:Name="OnDeckExpander" IsExpanded="{Binding OnDeckGroupExpanded, Mode=TwoWay}" Margin="0,0,0,8">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="{TemplateBinding Background}">
                                                    <DockPanel>
                                                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeaderBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="12,10" Margin="6,0"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Status accent stripe -->
                                                                            <Border Width="3" Height="16" Background="{DynamicResource WidgetStatusOnDeckBrush}" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="ON DECK" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                            <!-- Count badge -->
                                                                            <Border Grid.Column="2" Background="{DynamicResource WidgetStatusOnDeckBgBrush}" CornerRadius="3" Padding="8,3" Margin="8,0,10,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DataContext.OnDeckCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetStatusOnDeckBrush}" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="3" x:Name="Arrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding OnDeckItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="0,0,0,8">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                                            <Setter Property="Content" Value="{Binding First}"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OrderItemTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Not Ready Section -->
                        <Expander x:Name="NotReadyExpander" IsExpanded="{Binding NotReadyGroupExpanded, Mode=TwoWay}" Margin="0,0,0,48">
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <Border Background="{TemplateBinding Background}">
                                                    <DockPanel>
                                                        <ToggleButton DockPanel.Dock="Top" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                      Background="Transparent" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Border x:Name="HeaderBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Padding="12,10" Margin="6,0"
                                                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <!-- Status accent stripe -->
                                                                            <Border Width="3" Height="16" Background="{DynamicResource WidgetStatusNotReadyBrush}" CornerRadius="1.5" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                                                            <TextBlock Grid.Column="1" Text="NOT READY" FontSize="11" FontWeight="SemiBold" FontFamily="{DynamicResource FontMono}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                                            <!-- Count badge -->
                                                                            <Border Grid.Column="2" Background="{DynamicResource WidgetStatusNotReadyBgBrush}" CornerRadius="3" Padding="8,3" Margin="8,0,10,0" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding DataContext.NotReadyCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                                           FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WidgetStatusNotReadyBrush}" HorizontalAlignment="Center"/>
                                                                            </Border>
                                                                            <TextBlock Grid.Column="3" x:Name="Arrow" Text="▼" FontSize="9" Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center"/>
                                                                        </Grid>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="False">
                                                                            <Setter TargetName="Arrow" Property="Text" Value="▶"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter x:Name="ExpanderContent" DockPanel.Dock="Bottom" Visibility="Collapsed"/>
                                                    </DockPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="ExpanderContent" Property="Visibility" Value="Visible"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>
                            <ItemsControl ItemsSource="{Binding NotReadyItems}" Margin="0,8,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Vertical"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ContentControl Margin="0,0,0,8">
                                            <ContentControl.Style>
                                                <Style TargetType="ContentControl">
                                                    <Setter Property="Content" Value="{Binding}"/>
                                                    <Setter Property="ContentTemplate" Value="{StaticResource OrderItemGroupMergedTemplate}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Count}" Value="1">
                                                            <Setter Property="Content" Value="{Binding First}"/>
                                                            <Setter Property="ContentTemplate" Value="{StaticResource OrderItemTemplate}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </ContentControl.Style>
                                        </ContentControl>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Empty State: No Active Orders -->
                        <Border Margin="6,40,6,40" Padding="32,24"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding InProgressCount}" Value="0"/>
                                                <Condition Binding="{Binding OnDeckCount}" Value="0"/>
                                                <Condition Binding="{Binding NotReadyCount}" Value="0"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="📋" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                                <TextBlock Text="No Orders Yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="Create your first order to get started"
                                           FontSize="13"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>

                <!-- Archived Notes Panel (separate tab) -->
                <StackPanel x:Name="ArchivedItemsPanel" Visibility="Collapsed">
                    <!-- Archived Sort Header -->
                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="3" Margin="6,0,6,10" Padding="10,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Archived Items" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Click="ArchivedSortToggle_Click" ToolTip="Click to cycle sort mode"
                                    Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="8,4">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="⇅" FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="SortLabel" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="Date"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ArchivedSortModeEnum}" Value="VendorName">
                                                                    <Setter Property="Text" Value="Vendor"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                    <ListBox x:Name="ArchivedListBox"
                             ItemsSource="{Binding DisplayArchivedItems}"
                             BorderThickness="0"
                             Background="Transparent"
                             VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"
                             ScrollViewer.CanContentScroll="True"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,14"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl">
                                            <!-- Default: single archived item -->
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                <!-- Archived item card -->
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" CornerRadius="0" Margin="0,0,0,0" Padding="0">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy" Click="Copy_Click" DataContext="{Binding First}" InputGestureText="Ctrl+C"/>
                                            <MenuItem Header="Paste" Click="Paste_Click" DataContext="{Binding First}" InputGestureText="Ctrl+V"/>
                                            <MenuItem Header="Duplicate" Click="Duplicate_Click" DataContext="{Binding First}" InputGestureText="Ctrl+D"/>
                                            <Separator/>
                                            <MenuItem Header="Restore" Click="QuickArchive_Click" DataContext="{Binding First}"/>
                                            <Separator/>
                                            <MenuItem Header="Delete" Click="DeleteArchivedNote_Click" DataContext="{Binding First}" Foreground="{DynamicResource DangerBrush}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="8"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Color Bar (muted for archived) -->
                                        <Border Grid.Row="0" CornerRadius="4,4,0,0" Height="8"
                                                Background="{DynamicResource TextTertiaryBrush}"/>

                                        <!-- Header -->
                                        <Border Grid.Row="1" Background="{DynamicResource SurfaceHoverBrush}" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox Grid.Column="0"
                                                          Tag="{Binding First}"
                                                          Margin="0,0,12,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="Collapsed"/>
                                                <TextBlock Grid.Column="1" Text="{Binding First.VendorName, FallbackValue='Archived'}"
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Button Grid.Column="2" Click="QuickArchive_Click" DataContext="{Binding First}"
                                                    ToolTip="Restore" Cursor="Hand"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Center">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderThickness" Value="0"/>
                                                            <Setter Property="Padding" Value="8,4"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <TextBlock Text="↩ Restore" FontSize="{DynamicResource CardFontSize}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                        </Border>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </Grid>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Row="2" Margin="16,14">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                            Click="CopyTransferNumbers_Click" Tag="{Binding First.TransferNumbers}" IsTabStop="False"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding First.TransferNumbers}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource CardFontSize}"
                                                               Margin="0,0,0,4"/>
                                                </Grid>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Grid.Column="0" Style="{StaticResource FieldCopyButtonStyle}"
                                                            Click="CopyWhsNumbers_Click" Tag="{Binding First.WhsShipmentNumbers}" IsTabStop="False"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding First.WhsShipmentNumbers}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               FontSize="{DynamicResource CardFontSize}"
                                                               Margin="0,0,0,4"/>
                                                </Grid>
                                            <TextBlock Text="{Binding First.TimeInProgressDisplay}"
                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                       FontSize="{DynamicResource CardFontSize}"
                                                       FontFamily="Consolas"/>
                                        </StackPanel>
                                        <!-- Footer with timestamp -->
                                        <TextBlock Grid.Row="3" Text="{Binding First.CreatedAtDisplay}" FontSize="10" Foreground="{DynamicResource TextDisabledBrush}"
                                                   HorizontalAlignment="Right" Margin="0,4,16,8"/>
                                    </Grid>
                                </Border>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <!-- When IsGroup is true, use archived merged template -->
                                                <DataTrigger Binding="{Binding IsGroup}" Value="True">
                                                    <Setter Property="ContentTemplate" Value="{StaticResource ArchivedOrderItemGroupMergedTemplate}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty State: No Archived Orders -->
                    <Border Margin="6,40,6,40" Padding="32,24"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ArchivedItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="No Archived Orders"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <TextBlock Text="Archived orders will appear here"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
            
            <!-- Top fade/shadow overlay -->
            <Border VerticalAlignment="Top" Height="24" IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#AA000000" Offset="0"/>
                        <GradientStop Color="#00000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            
            <!-- Bottom fade/shadow overlay (subtle shadow under NowPlaying) -->
            <Border VerticalAlignment="Bottom" Height="18" IsHitTestVisible="False" Panel.ZIndex="49">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#00000000" Offset="0"/>
                        <GradientStop Color="#66000000" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
            
            <!-- Floating Quick Jump − side-tuck tab -->
            <Grid x:Name="QuickJumpPanel"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Right"
                  Panel.ZIndex="100">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="14"/>
                </Grid.ColumnDefinitions>

                <!-- Collapsible jump buttons panel -->
                <Border x:Name="QuickJumpContent"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1,1,0,1"
                        CornerRadius="3,0,0,3"
                        Padding="4,8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.35" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <!-- In Progress Jump -->
                        <Button x:Name="JumpInProgressBtn" Click="JumpToInProgress_Click"
                                ToolTip="Jump to In Progress"
                                Width="28" Height="28" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                                        <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource WidgetStatusInProgressBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- On Deck Jump -->
                        <Button x:Name="JumpOnDeckBtn" Click="JumpToOnDeck_Click"
                                ToolTip="Jump to On Deck"
                                Width="28" Height="28" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                                        <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource WidgetStatusOnDeckBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Not Ready Jump -->
                        <Button x:Name="JumpNotReadyBtn" Click="JumpToNotReady_Click"
                                ToolTip="Jump to Not Ready"
                                Width="28" Height="28" Padding="0" Cursor="Hand"
                                Background="Transparent" BorderThickness="0">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="2">
                                        <Border Width="8" Height="8" CornerRadius="1" Background="{DynamicResource WidgetStatusNotReadyBrush}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Always-visible handle strip -->
                <Border x:Name="QuickJumpHandle"
                        Grid.Column="1"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="0,3,3,0"
                        Cursor="Hand"
                        Padding="2,10"
                        MouseLeftButtonDown="QuickJumpHandle_Click">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.2" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusInProgressBrush}" Margin="0,2"/>
                        <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusOnDeckBrush}" Margin="0,2"/>
                        <Border Width="6" Height="6" CornerRadius="1" Background="{DynamicResource WidgetStatusNotReadyBrush}" Margin="0,2"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Now Playing Mini-Player (Collapsible - rises from bottom) -->
        <Border x:Name="NowPlayingSection" Grid.Row="4"
                Background="Transparent"
                BorderThickness="0"
            Margin="0,-20,0,0"
            Panel.ZIndex="50"
                Visibility="{Binding ShowNowPlaying, Converter={StaticResource BoolToVis}, FallbackValue=Visible}">
            <Grid>
                <StackPanel>
                <!-- Full Album Art Player (collapsible - rises from bottom) -->
                <Border x:Name="NowPlayingContent" 
                        Visibility="Collapsed"
                        MouseEnter="NowPlayingContent_MouseEnter"
                        MouseLeave="NowPlayingContent_MouseLeave">
                    <Grid>
                        <!-- Album Art Background -->
                        <Border CornerRadius="0" 
                                Background="{DynamicResource SurfaceBrush}"
                                MinHeight="180"
                                MaxHeight="280">
                            <Grid>
                                <!-- Album Art (fills entire area) -->
                                <Image x:Name="AlbumArtImage" 
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                
                                <!-- Hidden blurred background reference (for code-behind compatibility) -->
                                <Image x:Name="AlbumArtBlurredBg" 
                                       Visibility="Collapsed"/>
                                
                                <!-- Placeholder when no art -->
                                <TextBlock x:Name="AlbumArtPlaceholder"
                                           Text="🎵" 
                                           FontSize="64" 
                                           HorizontalAlignment="Center" 
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Opacity="0.3"/>
                                
                                <!-- Gradient overlay for text readability -->
                                <Border>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#00000000" Offset="0.0"/>
                                            <GradientStop Color="#33000000" Offset="0.4"/>
                                            <GradientStop Color="#CC000000" Offset="0.85"/>
                                            <GradientStop Color="#EE000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                
                                <!-- Track Info + Controls overlaid at bottom -->
                                <StackPanel VerticalAlignment="Bottom" Margin="16,0,16,14">
                                    <!-- Track Title -->
                                    <TextBlock x:Name="TrackTitleText"
                                               Text="Not Playing"
                                               FontSize="15"
                                               FontWeight="Bold"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="4" Opacity="0.6"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                    
                                    <!-- Artist Name -->
                                    <TextBlock x:Name="ArtistNameText"
                                               Text=""
                                               FontSize="12"
                                               Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0">
                                        <TextBlock.Effect>
                                            <DropShadowEffect ShadowDepth="1" BlurRadius="3" Opacity="0.4"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </StackPanel>
                                
                                <!-- Playback Control Bar -->
                                <Border x:Name="ControlBar"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Background="#E8000000"
                                        CornerRadius="2"
                                        Padding="10,6"
                                        Opacity="0">
                                    <Border.Effect>
                                        <DropShadowEffect ShadowDepth="0" BlurRadius="24" Opacity="0.6" Color="#00FF88"/>
                                    </Border.Effect>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <!-- Previous Button -->
                                        <Button x:Name="PrevButton"
                                                Content="⏮"
                                                Click="PrevTrack_Click"
                                                Background="Transparent"
                                                Foreground="#00FF88"
                                                BorderThickness="0"
                                                FontSize="18"
                                                Width="42"
                                                Height="42"
                                                Cursor="Hand"
                                                ToolTip="Previous">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#2200FF88"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#4400FF88"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        
                                        <!-- Play/Pause Button -->
                                        <Button x:Name="PlayPauseButton"
                                                Content="▶"
                                                Click="PlayPause_Click"
                                                Background="#00FF88"
                                                Foreground="#0A0A0A"
                                                BorderThickness="0"
                                                FontSize="18"
                                                Width="44"
                                                Height="44"
                                                Margin="4,0"
                                                Cursor="Hand"
                                                ToolTip="Play/Pause">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" CornerRadius="2">
                                                                    <Border.Effect>
                                                                        <DropShadowEffect ShadowDepth="0" BlurRadius="12" Opacity="0.7" Color="#00FF88"/>
                                                                    </Border.Effect>
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#66FFB8"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#00CC70"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        
                                        <!-- Next Button -->
                                        <Button x:Name="NextButton"
                                                Content="⏭"
                                                Click="NextTrack_Click"
                                                Background="Transparent"
                                                Foreground="#00FF88"
                                                BorderThickness="0"
                                                FontSize="18"
                                                Width="42"
                                                Height="42"
                                                Cursor="Hand"
                                                ToolTip="Next">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">
                                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#2200FF88"/>
                                                                    </Trigger>
                                                                    <Trigger Property="IsPressed" Value="True">
                                                                        <Setter TargetName="ButtonBorder" Property="Background" Value="#4400FF88"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                
                <!-- Collapsed Mini-Bar (sleek bottom strip) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="0,7,12,7"
                        Cursor="Hand"
                        MouseLeftButtonDown="NowPlayingHeader_Click"
                        ToolTip="Click to expand • Double-click to open Spotify">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Accent left stripe -->
                        <Border Grid.Column="0"
                                Width="2"
                                Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0"
                                VerticalAlignment="Stretch"/>

                        <!-- Equalizer / Music Icon -->
                        <Border Grid.Column="1"
                                Background="#1800FF88"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Width="22" Height="22"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Animated Equalizer Bars -->
                                <Canvas x:Name="EqualizerPanel" Width="14" Height="12" Visibility="Collapsed"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Rectangle x:Name="EqBar1" Canvas.Left="0" Canvas.Bottom="0" Width="3" Height="12"
                                               Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                               RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleY="1"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="EqBar2" Canvas.Left="5" Canvas.Bottom="0" Width="3" Height="12"
                                               Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                               RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleY="0.6"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle x:Name="EqBar3" Canvas.Left="10" Canvas.Bottom="0" Width="3" Height="12"
                                               Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                                               RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform>
                                            <ScaleTransform ScaleY="0.8"/>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                </Canvas>
                                <!-- Static music icon when not playing -->
                                <TextBlock x:Name="MusicIcon" Text="♪" FontSize="11"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        
                        <!-- Center: Track Info -->
                        <Grid Grid.Column="2" Margin="0,0,8,0" ClipToBounds="True" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Static label -->
                            <TextBlock x:Name="NowPlayingHeaderText"
                                       Grid.Column="0"
                                       Text="NOW PLAYING"
                                       FontSize="9"
                                       FontFamily="{DynamicResource FontMono}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <!-- Scrolling track info -->
                            <Canvas x:Name="MarqueeContainer" Grid.Column="1" Height="18" Visibility="Collapsed" ClipToBounds="True">
                                <StackPanel x:Name="MarqueeContent" Orientation="Horizontal" Canvas.Top="0">
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform x:Name="MarqueeTransform" X="0"/>
                                    </StackPanel.RenderTransform>
                                    <TextBlock x:Name="CollapsedTrackTitle"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="  ·  "
                                               FontSize="12"
                                               Foreground="{DynamicResource TextTertiaryBrush}"/>
                                    <TextBlock x:Name="CollapsedArtistName"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <!-- Spacer for seamless loop -->
                                    <TextBlock x:Name="MarqueeSpacer" Text="          " FontSize="12"/>
                                </StackPanel>
                            </Canvas>
                        </Grid>
                        
                        <!-- Right: Chevron toggle -->
                        <Border Grid.Column="3"
                                Background="#1800FF88"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                CornerRadius="2"
                                Width="18" Height="18"
                                VerticalAlignment="Center">
                            <TextBlock x:Name="NowPlayingToggleIcon"
                                       Text="▲"
                                       FontSize="8"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </Grid>
                </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Undo Bar (shows when undo is available) -->
        <Border Grid.Row="5"
                Background="{DynamicResource AccentBrush}"
                Padding="12,8"
                Visibility="{Binding UndoAvailable, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding UndoMessage}"
                               Foreground="{DynamicResource TextOnPrimaryBrush}"
                               FontSize="11"
                               FontWeight="Medium"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <Button Content="Undo"
                            Command="{Binding UndoAsyncCommand}"
                            Padding="12,4"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Background="{DynamicResource TextOnAccentBrush}"
                            Foreground="{DynamicResource AccentBrush}"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="4"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                
                <!-- Countdown indicator -->
                <TextBlock Text="{Binding UndoSecondsRemaining, StringFormat='({0}s)'}"
                           Foreground="{DynamicResource TextOnOverlayDimBrush}"
                           FontSize="10"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Status Bar -->
        <Border Grid.Row="6"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Grid>
                <TextBlock Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="OpenSettings_Click"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            ToolTip="Settings"
                            Margin="0,0,4,0">
                        <TextBlock Text="&#x2699;" FontFamily="Segoe UI Symbol" FontSize="15" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ThemeToggleButton"
                            Click="ThemeToggle_Click"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            ToolTip="Toggle Light/Dark Mode"
                            Margin="0,0,4,0">
                        <TextBlock x:Name="ThemeToggleIcon" Text="&#x25D1;" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                    <Button x:Name="ExportImportMenuButton"
                            Click="ExportImportMenu_Click"
                            Style="{StaticResource WidgetIconButtonStyle}"
                            ToolTip="Export/Import Options"
                            Margin="0,0,0,0">
                        <TextBlock Text="&#x2191;" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ExportImportMenu">
                                <MenuItem Header="📄 Export to CSV"
                                          Command="{Binding ExportToCsvCommand}"
                                          InputGestureText="Ctrl+Shift+E"
                                          ToolTip="Export items to CSV format"/>
                                <MenuItem Header="📋 Export to JSON"
                                          Command="{Binding ExportToJsonCommand}"
                                          InputGestureText="Ctrl+Shift+J"
                                          ToolTip="Export items to JSON format"/>
                                <Separator/>
                                <MenuItem Header="📥 Import from CSV"
                                          Command="{Binding ImportFromCsvCommand}"
                                          InputGestureText="Ctrl+Shift+I"
                                          ToolTip="Import items from CSV file"/>
                                <Separator/>
                                <MenuItem Header="🔧 Repair Archive Data"
                                          Command="{Binding RepairArchivedItemsCommand}"
                                          ToolTip="Move completed items that got stuck in the active list to the archive"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

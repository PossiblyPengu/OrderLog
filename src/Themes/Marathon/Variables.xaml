<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ═══════════════════════════════════════════════════════════════════════════
       MARATHON 2026 DESIGN SYSTEM — Variables / Dark Mode Tokens
       Dark industrial · Viridian green HUD · Derelict colony · Tau Ceti IV
       Inspired by Marathon 2026 (Bungie) — extraction FPS military aesthetic
  ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- ─── Typography ──────────────────────────────────────────────────────── -->
  <FontFamily x:Key="FontMain">Inter, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="FontMono">JetBrains Mono, Cascadia Code, Consolas, Courier New, monospace</FontFamily>

  <!-- ─── Spacing ──────────────────────────────────────────────────────────── -->
  <sys:Double x:Key="Sp2xs">2</sys:Double>
  <sys:Double x:Key="SpXs">4</sys:Double>
  <sys:Double x:Key="SpSm">8</sys:Double>
  <sys:Double x:Key="SpMd">16</sys:Double>
  <sys:Double x:Key="SpLg">24</sys:Double>
  <sys:Double x:Key="SpXl">32</sys:Double>
  <sys:Double x:Key="Sp2xl">48</sys:Double>
  <sys:Double x:Key="Sp3xl">64</sys:Double>

  <!-- ─── Border radii (angular/aggressive) ───────────────────────────────── -->
  <CornerRadius x:Key="RadiusXs">2</CornerRadius>
  <CornerRadius x:Key="RadiusSm">3</CornerRadius>
  <CornerRadius x:Key="RadiusMd">4</CornerRadius>
  <CornerRadius x:Key="RadiusLg">6</CornerRadius>
  <!-- Backwards-compat aliases used by existing widget templates -->
  <CornerRadius x:Key="XSmallCornerRadius">2</CornerRadius>
  <CornerRadius x:Key="SmallCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="MediumCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="LargeCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="NavItemCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="BadgeCornerRadius">3</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="WindowCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="TitleBarCornerRadius">6,6,0,0</CornerRadius>

  <!-- ─── Card / Widget specific dims ─────────────────────────────────────── -->
  <sys:Double x:Key="CardColorBarHeight">3</sys:Double>
  <sys:Double x:Key="CardFontSize">12</sys:Double>

  <!-- ─── Color Tokens — Dark Mode (dark base · vibrant highlights) ──────────── -->

  <!-- Backgrounds — pure neutral dark, no green cast -->
  <Color x:Key="BackgroundColor">#0A0A0A</Color>
  <Color x:Key="SurfaceColor">#141414</Color>
  <Color x:Key="SurfaceHoverColor">#1E1E1E</Color>
  <Color x:Key="SurfaceActiveColor">#282828</Color>
  <Color x:Key="SurfaceSunkenColor">#080808</Color>
  <Color x:Key="SolidBackgroundFillColorBase">#0A0A0A</Color>
  <Color x:Key="SolidBackgroundFillColorSecondary">#141414</Color>
  <Color x:Key="SolidBackgroundFillColorTertiary">#1E1E1E</Color>

  <!-- Text — crisp white primary, neutral grey secondary, reserved green for accent only -->
  <Color x:Key="TextPrimaryColor">#F2F2F2</Color>
  <Color x:Key="TextSecondaryColor">#888888</Color>
  <Color x:Key="TextTertiaryColor">#505050</Color>
  <Color x:Key="TextDisabledColor">#303030</Color>
  <Color x:Key="TextFillColorPrimary">#F2F2F2</Color>
  <Color x:Key="TextFillColorSecondary">#888888</Color>
  <Color x:Key="TextFillColorTertiary">#505050</Color>
  <Color x:Key="TextFillColorDisabled">#303030</Color>
  <Color x:Key="TextFillColorOnAccent">#0A0A0A</Color>
  <Color x:Key="TextOnPrimaryColor">#0A0A0A</Color>

  <!-- Borders — subtle dark separators, accent on focus only -->
  <Color x:Key="BorderColor">#2A2A2A</Color>
  <Color x:Key="BorderLightColor">#1E1E1E</Color>
  <Color x:Key="BorderAccentColor">#7700FF88</Color>
  <Color x:Key="DividerStrokeColorDefault">#2A2A2A</Color>

  <!-- Primary / Accent — pure maximum neon green -->
  <Color x:Key="PrimaryColor">#00FF88</Color>
  <Color x:Key="PrimaryHoverColor">#80FFB8</Color>
  <Color x:Key="PrimaryDarkColor">#00CC70</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#4000FF88</Color>
  <Color x:Key="AccentColor">#00FF88</Color>
  <Color x:Key="AccentColorPrimary">#00FF88</Color>

  <!-- Status / Semantic — maximum saturation scanner palette -->
  <Color x:Key="SuccessColor">#00FF88</Color>
  <Color x:Key="WarningColor">#FFD000</Color>
  <Color x:Key="DangerColor">#FF1050</Color>
  <Color x:Key="InfoColor">#00E5FF</Color>
  <Color x:Key="SuccessDarkColor">#00CC70</Color>
  <Color x:Key="WarningDarkColor">#E0A000</Color>
  <Color x:Key="DangerDarkColor">#CC0040</Color>
  <Color x:Key="InfoDarkColor">#00AACE</Color>
  <Color x:Key="SystemCriticalColor">#FF1050</Color>
  <Color x:Key="SystemCautionColor">#FFD000</Color>
  <Color x:Key="SystemSuccessColor">#00FF88</Color>
  <Color x:Key="SystemAttentionColor">#00E5FF</Color>

  <!-- Header / Tab -->
  <Color x:Key="HeaderBgColor">#F2141414</Color>
  <Color x:Key="TabBgColor">#F5141414</Color>
  <Color x:Key="TabActiveBgColor">#2200FF88</Color>

  <!-- Overlay -->
  <Color x:Key="OverlayBgColor">#C00A0A0A</Color>
  <Color x:Key="OverlayHeavyColor">#E00A0A0A</Color>

  <!-- Widget Status Colors — vivid punchy accents on dark cards -->
  <Color x:Key="WidgetStatusNotReadyColor">#FF1050</Color>
  <Color x:Key="WidgetStatusOnDeckColor">#FFD000</Color>
  <Color x:Key="WidgetStatusInProgressColor">#00FF88</Color>
  <Color x:Key="WidgetStatusDoneColor">#00CC70</Color>
  <Color x:Key="WidgetStatusNotReadyBgColor">#20FF1050</Color>
  <Color x:Key="WidgetStatusOnDeckBgColor">#20FFD000</Color>
  <Color x:Key="WidgetStatusInProgressBgColor">#1500FF88</Color>
  <Color x:Key="WidgetStatusDoneBgColor">#1200CC70</Color>

  <!-- Widget Note Colors — barely-perceptible dark tints -->
  <Color x:Key="WidgetNoteYellowColor">#141000</Color>
  <Color x:Key="WidgetNotePinkColor">#140008</Color>
  <Color x:Key="WidgetNoteBlueColor">#000E1A</Color>
  <Color x:Key="WidgetNoteGreenColor">#001208</Color>
  <Color x:Key="WidgetNotePurpleColor">#0C0014</Color>

  <!-- Card backgrounds — flat neutral dark, status shown via accent badge/bar -->
  <SolidColorBrush x:Key="OrderLogCardNotReadyBrush"  Color="#141414"/>
  <SolidColorBrush x:Key="OrderLogCardOnDeckBrush"    Color="#141414"/>
  <SolidColorBrush x:Key="OrderLogCardInProgressBrush" Color="#141414"/>
  <SolidColorBrush x:Key="OrderLogCardDoneBrush"      Color="#141414"/>
  <SolidColorBrush x:Key="OrderLogCardNoteBrush"      Color="#141414"/>

  <!-- ─── Brushes ──────────────────────────────────────────────────────────── -->

  <!-- Backgrounds -->
  <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}"/>
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}"/>

  <!-- Text -->
  <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush"  Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>
  <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

  <!-- Borders -->
  <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderLightBrush"   Color="{StaticResource BorderLightColor}"/>
  <SolidColorBrush x:Key="BorderDarkBrush"    Color="{StaticResource BorderLightColor}"/>
  <SolidColorBrush x:Key="BorderAccentBrush"  Color="{StaticResource BorderAccentColor}"/>

  <!-- Primary / Accent -->
  <SolidColorBrush x:Key="PrimaryBrush"       Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"  Color="{StaticResource PrimaryHoverColor}"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"   Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"  Color="#2200FF88"/>
  <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentDarkBrush"    Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="AccentLightBrush"   Color="{StaticResource PrimaryHoverColor}"/>

  <!-- Status -->
  <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="SuccessDarkBrush"   Color="{StaticResource SuccessDarkColor}"/>
  <SolidColorBrush x:Key="SuccessLightBrush"  Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="WarningDarkBrush"   Color="{StaticResource WarningDarkColor}"/>
  <SolidColorBrush x:Key="WarningLightBrush"  Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DangerDarkBrush"    Color="{StaticResource DangerDarkColor}"/>
  <SolidColorBrush x:Key="DangerLightBrush"   Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="InfoDarkBrush"      Color="{StaticResource InfoDarkColor}"/>
  <SolidColorBrush x:Key="InfoLightBrush"     Color="{StaticResource InfoColor}"/>

  <!-- Widget Status Brushes -->
  <SolidColorBrush x:Key="WidgetStatusNotReadyBrush"     Color="{StaticResource WidgetStatusNotReadyColor}"/>
  <SolidColorBrush x:Key="WidgetStatusOnDeckBrush"       Color="{StaticResource WidgetStatusOnDeckColor}"/>
  <SolidColorBrush x:Key="WidgetStatusInProgressBrush"   Color="{StaticResource WidgetStatusInProgressColor}"/>
  <SolidColorBrush x:Key="WidgetStatusDoneBrush"         Color="{StaticResource WidgetStatusDoneColor}"/>
  <SolidColorBrush x:Key="WidgetStatusNotReadyBgBrush"   Color="{StaticResource WidgetStatusNotReadyBgColor}"/>
  <SolidColorBrush x:Key="WidgetStatusOnDeckBgBrush"     Color="{StaticResource WidgetStatusOnDeckBgColor}"/>
  <SolidColorBrush x:Key="WidgetStatusInProgressBgBrush" Color="{StaticResource WidgetStatusInProgressBgColor}"/>
  <SolidColorBrush x:Key="WidgetStatusDoneBgBrush"       Color="{StaticResource WidgetStatusDoneBgColor}"/>

  <!-- Overlay -->
  <SolidColorBrush x:Key="OverlayBrush"       Color="{StaticResource OverlayBgColor}"/>
  <SolidColorBrush x:Key="OverlayHeavyBrush"  Color="{StaticResource OverlayHeavyColor}"/>

  <!-- ─── Drop-shadow effects — dark resting, vivid neon on hover/focus ────────── -->
  <DropShadowEffect x:Key="ShadowCard"
                    BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
  <DropShadowEffect x:Key="ShadowCardHover"
                    BlurRadius="28" ShadowDepth="0" Opacity="0.9" Color="#00FF88"/>
  <DropShadowEffect x:Key="ShadowNeon"
                    BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#00FF88"/>
  <DropShadowEffect x:Key="ShadowGlow"
                    BlurRadius="24" ShadowDepth="0" Opacity="0.7" Color="#00FF88"/>
  <DropShadowEffect x:Key="ShadowFocus"
                    BlurRadius="18" ShadowDepth="0" Opacity="0.8" Color="#00FF88"/>

  <DropShadowEffect x:Key="WidgetCardShadow"
                    BlurRadius="10" ShadowDepth="0" Opacity="0.8" Color="#000000"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow"
                    BlurRadius="28" ShadowDepth="0" Opacity="0.9" Color="#00FF88"/>
  <DropShadowEffect x:Key="WidgetCardDragShadow"
                    BlurRadius="36" ShadowDepth="0" Opacity="1.0" Color="#000000"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"
                    BlurRadius="14" ShadowDepth="0" Opacity="0.6" Color="#00FF88"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"
                    BlurRadius="26" ShadowDepth="0" Opacity="0.85" Color="#00FF88"/>

  <!-- ─── Legacy module color aliases ─────────────────────────────────────────────── -->
  <Color x:Key="ExpireWiseColor">#FFD000</Color>
  <Color x:Key="AllocationBuddyColor">#00FF88</Color>
  <Color x:Key="EssentialsBuddyColor">#00FF88</Color>
  <Color x:Key="SwiftLabelColor">#FF1050</Color>
  <SolidColorBrush x:Key="ExpireWiseBrush"        Color="{StaticResource ExpireWiseColor}"/>
  <SolidColorBrush x:Key="AllocationBuddyBrush"   Color="{StaticResource AllocationBuddyColor}"/>
  <SolidColorBrush x:Key="EssentialsBuddyBrush"   Color="{StaticResource EssentialsBuddyColor}"/>
  <SolidColorBrush x:Key="SwiftLabelBrush"         Color="{StaticResource SwiftLabelColor}"/>

  <!-- TextLink -->
  <Color x:Key="TextLinkColor">#00FF88</Color>
  <SolidColorBrush x:Key="TextLinkBrush" Color="{StaticResource TextLinkColor}"/>

  <!-- ─── Title Bar ────────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="TitleBarBackgroundBrush"     Color="#0A0A0A"/>
  <SolidColorBrush x:Key="TitleBarTextBrush"           Color="#F2F2F2"/>
  <SolidColorBrush x:Key="TitleBarInactiveBrush"       Color="#0A0A0A"/>
  <SolidColorBrush x:Key="TitleBarInactiveTextBrush"   Color="#505050"/>

  <!-- ─── Misc aliases used by legacy code ───────────────────────────────── -->
  <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#141414"/>
  <SolidColorBrush x:Key="ControlStrokeBrush"          Color="#2A2A2A"/>
  <SolidColorBrush x:Key="ControlStrokeSecondaryBrush" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="DividerStrokeBrush"          Color="#2A2A2A"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"       Color="#00FF88"/>
  <SolidColorBrush x:Key="FocusStrokeInnerBrush"       Color="#0A0A0A"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"           Color="#0A0A0A"/>
  <SolidColorBrush x:Key="SubtleFillBrush"             Color="#0F0F0F"/>
  <SolidColorBrush x:Key="SubtleFillTertiaryBrush"     Color="#181818"/>
  <SolidColorBrush x:Key="LayerFillBrush"              Color="#141414"/>
  <SolidColorBrush x:Key="SidebarBackgroundBrush"      Color="#0A0A0A"/>
  <SolidColorBrush x:Key="SidebarHoverBrush"           Color="#1E1E1E"/>
  <SolidColorBrush x:Key="SidebarActiveBrush"          Color="#282828"/>
  <SolidColorBrush x:Key="CloseButtonHoverBrush"       Color="#CC1020"/>
  <SolidColorBrush x:Key="AccentHoverBrush"            Color="{StaticResource PrimaryHoverColor}"/>

</ResourceDictionary>
<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       COLOUR PALETTE — Cyan · Dark Mode
       Ice #00E5FF — cryo scanner on deep-space dark
  ═══════════════════════════════════════════════════════════════════════ -->

  <Color x:Key="PrimaryColor">#00E5FF</Color>
  <Color x:Key="PrimaryHoverColor">#66EEFF</Color>
  <Color x:Key="PrimaryDarkColor">#00AACC</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#4000E5FF</Color>
  <Color x:Key="AccentColor">#00E5FF</Color>
  <Color x:Key="AccentColorPrimary">#00E5FF</Color>
  <Color x:Key="BorderAccentColor">#7700E5FF</Color>
  <Color x:Key="TabActiveBgColor">#2200E5FF</Color>
  <Color x:Key="TextLinkColor">#00E5FF</Color>

  <SolidColorBrush x:Key="PrimaryBrush"             Color="#00E5FF"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"        Color="#66EEFF"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"         Color="#00AACC"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#2200E5FF"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush"      Color="#4400E5FF"/>
  <SolidColorBrush x:Key="AccentBrush"              Color="#00E5FF"/>
  <SolidColorBrush x:Key="AccentDarkBrush"          Color="#00AACC"/>
  <SolidColorBrush x:Key="AccentLightBrush"         Color="#66EEFF"/>
  <SolidColorBrush x:Key="AccentHoverBrush"         Color="#66EEFF"/>
  <SolidColorBrush x:Key="BorderAccentBrush"        Color="#7700E5FF"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"    Color="#00E5FF"/>
  <SolidColorBrush x:Key="TextLinkBrush"            Color="#00E5FF"/>
  <SolidColorBrush x:Key="HighVisibilityCaretBrush" Color="#00E5FF"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"        Color="#0A0A0A"/>

  <DropShadowEffect x:Key="ShadowCardHover"      BlurRadius="22" ShadowDepth="0" Opacity="0.70" Color="#00E5FF"/>
  <DropShadowEffect x:Key="ShadowNeon"           BlurRadius="22" ShadowDepth="0" Opacity="0.75" Color="#00E5FF"/>
  <DropShadowEffect x:Key="ShadowGlow"           BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#00E5FF"/>
  <DropShadowEffect x:Key="ShadowFocus"          BlurRadius="16" ShadowDepth="0" Opacity="0.70" Color="#00E5FF"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.70" Color="#00E5FF"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"   BlurRadius="12" ShadowDepth="0" Opacity="0.50" Color="#00E5FF"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"     BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#00E5FF"/>

</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       COLOUR PALETTE — Red · Light Mode
       Deep #CC0030 — alert red on white canvas
  ═══════════════════════════════════════════════════════════════════════ -->

  <Color x:Key="PrimaryColor">#CC0030</Color>
  <Color x:Key="PrimaryHoverColor">#E0003A</Color>
  <Color x:Key="PrimaryDarkColor">#990020</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#18CC0030</Color>
  <Color x:Key="AccentColor">#CC0030</Color>
  <Color x:Key="AccentColorPrimary">#CC0030</Color>
  <Color x:Key="BorderAccentColor">#80CC0030</Color>
  <Color x:Key="TabActiveBgColor">#18CC0030</Color>
  <Color x:Key="TextLinkColor">#CC0030</Color>

  <SolidColorBrush x:Key="PrimaryBrush"             Color="#CC0030"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"        Color="#E0003A"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"         Color="#990020"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#18CC0030"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush"      Color="#30CC0030"/>
  <SolidColorBrush x:Key="AccentBrush"              Color="#CC0030"/>
  <SolidColorBrush x:Key="AccentDarkBrush"          Color="#990020"/>
  <SolidColorBrush x:Key="AccentLightBrush"         Color="#E0003A"/>
  <SolidColorBrush x:Key="AccentHoverBrush"         Color="#E0003A"/>
  <SolidColorBrush x:Key="BorderAccentBrush"        Color="#80CC0030"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"    Color="#CC0030"/>
  <SolidColorBrush x:Key="TextLinkBrush"            Color="#CC0030"/>
  <SolidColorBrush x:Key="HighVisibilityCaretBrush" Color="#CC0030"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"        Color="#FFFFFF"/>

  <DropShadowEffect x:Key="ShadowCardHover"      BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#CC0030"/>
  <DropShadowEffect x:Key="ShadowNeon"           BlurRadius="20" ShadowDepth="0" Opacity="0.50" Color="#CC0030"/>
  <DropShadowEffect x:Key="ShadowGlow"           BlurRadius="16" ShadowDepth="0" Opacity="0.40" Color="#CC0030"/>
  <DropShadowEffect x:Key="ShadowFocus"          BlurRadius="12" ShadowDepth="0" Opacity="0.50" Color="#CC0030"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#CC0030"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"   BlurRadius="12" ShadowDepth="0" Opacity="0.30" Color="#CC0030"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"     BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#CC0030"/>

</ResourceDictionary>

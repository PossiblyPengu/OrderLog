<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       COLOUR PALETTE — Amber · Light Mode
       Warm #B05500 — burnt orange on white canvas
  ═══════════════════════════════════════════════════════════════════════ -->

  <Color x:Key="PrimaryColor">#B05500</Color>
  <Color x:Key="PrimaryHoverColor">#CC6A00</Color>
  <Color x:Key="PrimaryDarkColor">#7A3800</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#18B05500</Color>
  <Color x:Key="AccentColor">#B05500</Color>
  <Color x:Key="AccentColorPrimary">#B05500</Color>
  <Color x:Key="BorderAccentColor">#80B05500</Color>
  <Color x:Key="TabActiveBgColor">#18B05500</Color>
  <Color x:Key="TextLinkColor">#B05500</Color>

  <SolidColorBrush x:Key="PrimaryBrush"             Color="#B05500"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"        Color="#CC6A00"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"         Color="#7A3800"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#18B05500"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush"      Color="#30B05500"/>
  <SolidColorBrush x:Key="AccentBrush"              Color="#B05500"/>
  <SolidColorBrush x:Key="AccentDarkBrush"          Color="#7A3800"/>
  <SolidColorBrush x:Key="AccentLightBrush"         Color="#CC6A00"/>
  <SolidColorBrush x:Key="AccentHoverBrush"         Color="#CC6A00"/>
  <SolidColorBrush x:Key="BorderAccentBrush"        Color="#80B05500"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"    Color="#B05500"/>
  <SolidColorBrush x:Key="TextLinkBrush"            Color="#B05500"/>
  <SolidColorBrush x:Key="HighVisibilityCaretBrush" Color="#B05500"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"        Color="#FFFFFF"/>

  <DropShadowEffect x:Key="ShadowCardHover"      BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#B05500"/>
  <DropShadowEffect x:Key="ShadowNeon"           BlurRadius="20" ShadowDepth="0" Opacity="0.50" Color="#B05500"/>
  <DropShadowEffect x:Key="ShadowGlow"           BlurRadius="16" ShadowDepth="0" Opacity="0.40" Color="#B05500"/>
  <DropShadowEffect x:Key="ShadowFocus"          BlurRadius="12" ShadowDepth="0" Opacity="0.50" Color="#B05500"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow" BlurRadius="18" ShadowDepth="0" Opacity="0.45" Color="#B05500"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"   BlurRadius="12" ShadowDepth="0" Opacity="0.30" Color="#B05500"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"     BlurRadius="20" ShadowDepth="0" Opacity="0.55" Color="#B05500"/>

</ResourceDictionary>

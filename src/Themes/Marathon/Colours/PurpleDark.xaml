<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       COLOUR PALETTE — Purple · Dark Mode
       Aeon #C060FF — violet plasma on deep-space dark
  ═══════════════════════════════════════════════════════════════════════ -->

  <Color x:Key="PrimaryColor">#C060FF</Color>
  <Color x:Key="PrimaryHoverColor">#D48CFF</Color>
  <Color x:Key="PrimaryDarkColor">#8A35E0</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#40C060FF</Color>
  <Color x:Key="AccentColor">#C060FF</Color>
  <Color x:Key="AccentColorPrimary">#C060FF</Color>
  <Color x:Key="BorderAccentColor">#77C060FF</Color>
  <Color x:Key="TabActiveBgColor">#22C060FF</Color>
  <Color x:Key="TextLinkColor">#C060FF</Color>

  <SolidColorBrush x:Key="PrimaryBrush"             Color="#C060FF"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"        Color="#D48CFF"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"         Color="#8A35E0"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#22C060FF"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush"      Color="#44C060FF"/>
  <SolidColorBrush x:Key="AccentBrush"              Color="#C060FF"/>
  <SolidColorBrush x:Key="AccentDarkBrush"          Color="#8A35E0"/>
  <SolidColorBrush x:Key="AccentLightBrush"         Color="#D48CFF"/>
  <SolidColorBrush x:Key="AccentHoverBrush"         Color="#D48CFF"/>
  <SolidColorBrush x:Key="BorderAccentBrush"        Color="#77C060FF"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"    Color="#C060FF"/>
  <SolidColorBrush x:Key="TextLinkBrush"            Color="#C060FF"/>
  <SolidColorBrush x:Key="HighVisibilityCaretBrush" Color="#C060FF"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"        Color="#0A0A0A"/>

  <DropShadowEffect x:Key="ShadowCardHover"      BlurRadius="22" ShadowDepth="0" Opacity="0.70" Color="#C060FF"/>
  <DropShadowEffect x:Key="ShadowNeon"           BlurRadius="22" ShadowDepth="0" Opacity="0.75" Color="#C060FF"/>
  <DropShadowEffect x:Key="ShadowGlow"           BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#C060FF"/>
  <DropShadowEffect x:Key="ShadowFocus"          BlurRadius="16" ShadowDepth="0" Opacity="0.70" Color="#C060FF"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.70" Color="#C060FF"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"   BlurRadius="12" ShadowDepth="0" Opacity="0.50" Color="#C060FF"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"     BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#C060FF"/>

</ResourceDictionary>

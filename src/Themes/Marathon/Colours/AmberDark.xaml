<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       COLOUR PALETTE — Amber · Dark Mode
       Solar #FFD000 — scanner-yellow on deep-space dark
  ═══════════════════════════════════════════════════════════════════════ -->

  <Color x:Key="PrimaryColor">#FFD000</Color>
  <Color x:Key="PrimaryHoverColor">#FFE566</Color>
  <Color x:Key="PrimaryDarkColor">#CC9900</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#40FFD000</Color>
  <Color x:Key="AccentColor">#FFD000</Color>
  <Color x:Key="AccentColorPrimary">#FFD000</Color>
  <Color x:Key="BorderAccentColor">#77FFD000</Color>
  <Color x:Key="TabActiveBgColor">#22FFD000</Color>
  <Color x:Key="TextLinkColor">#FFD000</Color>

  <SolidColorBrush x:Key="PrimaryBrush"             Color="#FFD000"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"        Color="#FFE566"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"         Color="#CC9900"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"        Color="#22FFD000"/>
  <SolidColorBrush x:Key="PrimaryPressedBrush"      Color="#44FFD000"/>
  <SolidColorBrush x:Key="AccentBrush"              Color="#FFD000"/>
  <SolidColorBrush x:Key="AccentDarkBrush"          Color="#CC9900"/>
  <SolidColorBrush x:Key="AccentLightBrush"         Color="#FFE566"/>
  <SolidColorBrush x:Key="AccentHoverBrush"         Color="#FFE566"/>
  <SolidColorBrush x:Key="BorderAccentBrush"        Color="#77FFD000"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"    Color="#FFD000"/>
  <SolidColorBrush x:Key="TextLinkBrush"            Color="#FFD000"/>
  <SolidColorBrush x:Key="HighVisibilityCaretBrush" Color="#FFD000"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"        Color="#0A0A0A"/>

  <DropShadowEffect x:Key="ShadowCardHover"      BlurRadius="22" ShadowDepth="0" Opacity="0.70" Color="#FFD000"/>
  <DropShadowEffect x:Key="ShadowNeon"           BlurRadius="22" ShadowDepth="0" Opacity="0.75" Color="#FFD000"/>
  <DropShadowEffect x:Key="ShadowGlow"           BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#FFD000"/>
  <DropShadowEffect x:Key="ShadowFocus"          BlurRadius="16" ShadowDepth="0" Opacity="0.70" Color="#FFD000"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow" BlurRadius="22" ShadowDepth="0" Opacity="0.70" Color="#FFD000"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"   BlurRadius="12" ShadowDepth="0" Opacity="0.50" Color="#FFD000"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"     BlurRadius="20" ShadowDepth="0" Opacity="0.65" Color="#FFD000"/>

</ResourceDictionary>

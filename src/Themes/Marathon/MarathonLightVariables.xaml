<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- ═══════════════════════════════════════════════════════════════════════════
       MARATHON 2026 DESIGN SYSTEM — Variables / Light Mode Tokens
       White canvas · Clean neutrals · Vibrant accent highlights
       Daylight operations — white surfaces, neon green accent identity
  ═══════════════════════════════════════════════════════════════════════════ -->

  <!-- ─── Color Tokens — Light Mode (White Canvas · Vibrant Accents) ────── -->

  <!-- Backgrounds — clean white/neutral paper -->
  <Color x:Key="BackgroundColor">#F4F4F4</Color>
  <Color x:Key="SurfaceColor">#FFFFFF</Color>
  <Color x:Key="SurfaceHoverColor">#EBEBEB</Color>
  <Color x:Key="SurfaceActiveColor">#E0E0E0</Color>
  <Color x:Key="SurfaceSunkenColor">#EEEEEE</Color>
  <Color x:Key="SolidBackgroundFillColorBase">#F4F4F4</Color>
  <Color x:Key="SolidBackgroundFillColorSecondary">#EBEBEB</Color>
  <Color x:Key="SolidBackgroundFillColorTertiary">#FFFFFF</Color>

  <!-- Text — near-black on white, neutral greys -->
  <Color x:Key="TextPrimaryColor">#0D0D0D</Color>
  <Color x:Key="TextSecondaryColor">#505050</Color>
  <Color x:Key="TextTertiaryColor">#909090</Color>
  <Color x:Key="TextDisabledColor">#C0C0C0</Color>
  <Color x:Key="TextFillColorPrimary">#0D0D0D</Color>
  <Color x:Key="TextFillColorSecondary">#505050</Color>
  <Color x:Key="TextFillColorTertiary">#909090</Color>
  <Color x:Key="TextFillColorDisabled">#C0C0C0</Color>
  <Color x:Key="TextFillColorOnAccent">#FFFFFF</Color>
  <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

  <!-- Borders — subtle neutral strokes -->
  <Color x:Key="BorderColor">#D8D8D8</Color>
  <Color x:Key="BorderLightColor">#E8E8E8</Color>
  <Color x:Key="BorderAccentColor">#8000AA44</Color>
  <Color x:Key="DividerStrokeColorDefault">#E0E0E0</Color>

  <!-- Primary / Accent — vibrant green, pops on white -->
  <Color x:Key="PrimaryColor">#00AA44</Color>
  <Color x:Key="PrimaryHoverColor">#00CC55</Color>
  <Color x:Key="PrimaryDarkColor">#007830</Color>
  <Color x:Key="PrimaryLightColor_Alpha">#1800AA44</Color>
  <Color x:Key="AccentColor">#00AA44</Color>
  <Color x:Key="AccentColorPrimary">#00AA44</Color>

  <!-- Status / Semantic — saturated on white -->
  <Color x:Key="SuccessColor">#008035</Color>
  <Color x:Key="WarningColor">#D97000</Color>
  <Color x:Key="DangerColor">#DD0025</Color>
  <Color x:Key="InfoColor">#0055CC</Color>
  <Color x:Key="SuccessDarkColor">#006028</Color>
  <Color x:Key="WarningDarkColor">#B05500</Color>
  <Color x:Key="DangerDarkColor">#A80018</Color>
  <Color x:Key="InfoDarkColor">#003FA0</Color>
  <Color x:Key="SystemCriticalColor">#DD0025</Color>
  <Color x:Key="SystemCautionColor">#D97000</Color>
  <Color x:Key="SystemSuccessColor">#008035</Color>
  <Color x:Key="SystemAttentionColor">#0055CC</Color>

  <!-- Header / Tab -->
  <Color x:Key="HeaderBgColor">#EBEBEB</Color>
  <Color x:Key="TabBgColor">#F0F0F0</Color>
  <Color x:Key="TabActiveBgColor">#1800AA44</Color>

  <!-- Overlay -->
  <Color x:Key="OverlayBgColor">#80FFFFFF</Color>
  <Color x:Key="OverlayHeavyColor">#C0F0F0F0</Color>

  <!-- Widget Status Colors — vivid on white canvas -->
  <Color x:Key="WidgetStatusNotReadyColor">#DD0025</Color>
  <Color x:Key="WidgetStatusOnDeckColor">#D97000</Color>
  <Color x:Key="WidgetStatusInProgressColor">#008035</Color>
  <Color x:Key="WidgetStatusDoneColor">#006028</Color>
  <Color x:Key="WidgetStatusNotReadyBgColor">#18DD0025</Color>
  <Color x:Key="WidgetStatusOnDeckBgColor">#18D97000</Color>
  <Color x:Key="WidgetStatusInProgressBgColor">#18008035</Color>
  <Color x:Key="WidgetStatusDoneBgColor">#14006028</Color>

  <!-- Note Colors — vivid pastels on white -->
  <Color x:Key="WidgetNoteYellowColor">#FFF5CC</Color>
  <Color x:Key="WidgetNotePinkColor">#FFE0EA</Color>
  <Color x:Key="WidgetNoteBlueColor">#D8EEFF</Color>
  <Color x:Key="WidgetNoteGreenColor">#D0FFE8</Color>
  <Color x:Key="WidgetNotePurpleColor">#EAD8FF</Color>

  <!-- Card backgrounds — white with subtle status tints -->
  <SolidColorBrush x:Key="OrderLogCardNotReadyBrush"    Color="#FFF8F8"/>
  <SolidColorBrush x:Key="OrderLogCardOnDeckBrush"      Color="#FFFDF5"/>
  <SolidColorBrush x:Key="OrderLogCardInProgressBrush"  Color="#F8FFFC"/>
  <SolidColorBrush x:Key="OrderLogCardDoneBrush"        Color="#F5FFF8"/>
  <SolidColorBrush x:Key="OrderLogCardNoteBrush"        Color="#FDFDF8"/>

  <!-- ─── Brushes ──────────────────────────────────────────────────────────── -->

  <SolidColorBrush x:Key="BackgroundBrush"    Color="{StaticResource BackgroundColor}"/>
  <SolidColorBrush x:Key="SurfaceBrush"       Color="{StaticResource SurfaceColor}"/>
  <SolidColorBrush x:Key="SurfaceHoverBrush"  Color="{StaticResource SurfaceHoverColor}"/>
  <SolidColorBrush x:Key="SurfaceActiveBrush" Color="{StaticResource SurfaceActiveColor}"/>
  <SolidColorBrush x:Key="SurfaceSunkenBrush" Color="{StaticResource SurfaceSunkenColor}"/>

  <SolidColorBrush x:Key="TextPrimaryBrush"   Color="{StaticResource TextPrimaryColor}"/>
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>
  <SolidColorBrush x:Key="TextTertiaryBrush"  Color="{StaticResource TextTertiaryColor}"/>
  <SolidColorBrush x:Key="TextDisabledBrush"  Color="{StaticResource TextDisabledColor}"/>
  <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="{StaticResource TextOnPrimaryColor}"/>

  <SolidColorBrush x:Key="BorderBrush"        Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderLightBrush"   Color="{StaticResource BorderLightColor}"/>
  <SolidColorBrush x:Key="BorderDarkBrush"    Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="BorderAccentBrush"  Color="{StaticResource BorderAccentColor}"/>

  <SolidColorBrush x:Key="PrimaryBrush"       Color="{StaticResource PrimaryColor}"/>
  <SolidColorBrush x:Key="PrimaryHoverBrush"  Color="{StaticResource PrimaryHoverColor}"/>
  <SolidColorBrush x:Key="PrimaryDarkBrush"   Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="PrimaryLightBrush"  Color="#1800AA44"/>
  <SolidColorBrush x:Key="AccentBrush"        Color="{StaticResource AccentColor}"/>
  <SolidColorBrush x:Key="AccentDarkBrush"    Color="{StaticResource PrimaryDarkColor}"/>
  <SolidColorBrush x:Key="AccentLightBrush"   Color="{StaticResource PrimaryHoverColor}"/>

  <SolidColorBrush x:Key="SuccessBrush"       Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="SuccessDarkBrush"   Color="{StaticResource SuccessDarkColor}"/>
  <SolidColorBrush x:Key="SuccessLightBrush"  Color="{StaticResource SuccessColor}"/>
  <SolidColorBrush x:Key="WarningBrush"       Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="WarningDarkBrush"   Color="{StaticResource WarningDarkColor}"/>
  <SolidColorBrush x:Key="WarningLightBrush"  Color="{StaticResource WarningColor}"/>
  <SolidColorBrush x:Key="DangerBrush"        Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="DangerDarkBrush"    Color="{StaticResource DangerDarkColor}"/>
  <SolidColorBrush x:Key="DangerLightBrush"   Color="{StaticResource DangerColor}"/>
  <SolidColorBrush x:Key="InfoBrush"          Color="{StaticResource InfoColor}"/>
  <SolidColorBrush x:Key="InfoDarkBrush"      Color="{StaticResource InfoDarkColor}"/>
  <SolidColorBrush x:Key="InfoLightBrush"     Color="{StaticResource InfoColor}"/>

  <SolidColorBrush x:Key="WidgetStatusNotReadyBrush"     Color="{StaticResource WidgetStatusNotReadyColor}"/>
  <SolidColorBrush x:Key="WidgetStatusOnDeckBrush"       Color="{StaticResource WidgetStatusOnDeckColor}"/>
  <SolidColorBrush x:Key="WidgetStatusInProgressBrush"   Color="{StaticResource WidgetStatusInProgressColor}"/>
  <SolidColorBrush x:Key="WidgetStatusDoneBrush"         Color="{StaticResource WidgetStatusDoneColor}"/>
  <SolidColorBrush x:Key="WidgetStatusNotReadyBgBrush"   Color="{StaticResource WidgetStatusNotReadyBgColor}"/>
  <SolidColorBrush x:Key="WidgetStatusOnDeckBgBrush"     Color="{StaticResource WidgetStatusOnDeckBgColor}"/>
  <SolidColorBrush x:Key="WidgetStatusInProgressBgBrush" Color="{StaticResource WidgetStatusInProgressBgColor}"/>
  <SolidColorBrush x:Key="WidgetStatusDoneBgBrush"       Color="{StaticResource WidgetStatusDoneBgColor}"/>

  <SolidColorBrush x:Key="OverlayBrush"       Color="{StaticResource OverlayBgColor}"/>
  <SolidColorBrush x:Key="OverlayHeavyBrush"  Color="{StaticResource OverlayHeavyColor}"/>

  <!-- ─── Drop-shadow effects — crisp neutral + accent glow on white ─────── -->
  <DropShadowEffect x:Key="ShadowCard"
                    BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
  <DropShadowEffect x:Key="ShadowCardHover"
                    BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#00AA44"/>
  <DropShadowEffect x:Key="ShadowNeon"
                    BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#00AA44"/>
  <DropShadowEffect x:Key="ShadowGlow"
                    BlurRadius="16" ShadowDepth="0" Opacity="0.45" Color="#00AA44"/>
  <DropShadowEffect x:Key="ShadowFocus"
                    BlurRadius="12" ShadowDepth="0" Opacity="0.55" Color="#00AA44"/>

  <DropShadowEffect x:Key="WidgetCardShadow"
                    BlurRadius="10" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
  <DropShadowEffect x:Key="WidgetCardHoverShadow"
                    BlurRadius="18" ShadowDepth="0" Opacity="0.5" Color="#00AA44"/>
  <DropShadowEffect x:Key="WidgetCardDragShadow"
                    BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
  <DropShadowEffect x:Key="WidgetButtonShadow"
                    BlurRadius="12" ShadowDepth="0" Opacity="0.35" Color="#00AA44"/>
  <DropShadowEffect x:Key="WidgetAccentGlow"
                    BlurRadius="20" ShadowDepth="0" Opacity="0.6" Color="#00AA44"/>

  <!-- ─── Title Bar ────────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="TitleBarBackgroundBrush"     Color="#1E1E1E"/>
  <SolidColorBrush x:Key="TitleBarTextBrush"           Color="#F2F2F2"/>
  <SolidColorBrush x:Key="TitleBarInactiveBrush"       Color="#2A2A2A"/>
  <SolidColorBrush x:Key="TitleBarInactiveTextBrush"   Color="#888888"/>

  <!-- ─── Misc aliases ─────────────────────────────────────────────────────── -->
  <SolidColorBrush x:Key="CardBackgroundBrush"         Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ControlStrokeBrush"          Color="{StaticResource BorderColor}"/>
  <SolidColorBrush x:Key="ControlStrokeSecondaryBrush" Color="{StaticResource BorderLightColor}"/>
  <SolidColorBrush x:Key="DividerStrokeBrush"          Color="{StaticResource DividerStrokeColorDefault}"/>
  <SolidColorBrush x:Key="FocusStrokeOuterBrush"       Color="#00AA44"/>
  <SolidColorBrush x:Key="FocusStrokeInnerBrush"       Color="#FFFFFF"/>
  <SolidColorBrush x:Key="TextOnAccentBrush"           Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SubtleFillBrush"             Color="#0A000000"/>
  <SolidColorBrush x:Key="SubtleFillTertiaryBrush"     Color="#14000000"/>
  <SolidColorBrush x:Key="LayerFillBrush"              Color="#FFFFFF"/>
  <SolidColorBrush x:Key="SidebarBackgroundBrush"      Color="#F0F0F0"/>
  <SolidColorBrush x:Key="SidebarHoverBrush"           Color="#E6E6E6"/>
  <SolidColorBrush x:Key="SidebarActiveBrush"          Color="#DCDCDC"/>
  <SolidColorBrush x:Key="TextLinkBrush"               Color="#007830"/>
  <SolidColorBrush x:Key="CloseButtonHoverBrush"       Color="#CC0020"/>
  <SolidColorBrush x:Key="AccentHoverBrush"            Color="{StaticResource PrimaryHoverColor}"/>

</ResourceDictionary>

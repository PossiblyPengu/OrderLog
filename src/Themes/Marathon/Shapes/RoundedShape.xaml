<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       SHAPE PROFILE — Rounded (Fluent / WinUI-inspired)
       Soft, approachable aesthetic.
       Generous radii · Smooth curves · Modern feel.
  ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ─── Semantic scale ───────────────────────────────────────────────── -->
  <CornerRadius x:Key="RadiusXs">4</CornerRadius>
  <CornerRadius x:Key="RadiusSm">6</CornerRadius>
  <CornerRadius x:Key="RadiusMd">8</CornerRadius>
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>

  <!-- ─── Compat aliases ───────────────────────────────────────────────── -->
  <CornerRadius x:Key="XSmallCornerRadius">4</CornerRadius>
  <CornerRadius x:Key="SmallCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="MediumCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="LargeCornerRadius">12</CornerRadius>

  <!-- ─── Component-specific ───────────────────────────────────────────── -->
  <CornerRadius x:Key="ControlCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="NavItemCornerRadius">6</CornerRadius>
  <CornerRadius x:Key="BadgeCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">12</CornerRadius>

  <!-- ─── Window chrome ────────────────────────────────────────────────── -->
  <CornerRadius x:Key="WindowCornerRadius">10</CornerRadius>
  <CornerRadius x:Key="TitleBarCornerRadius">10,10,0,0</CornerRadius>
  <CornerRadius x:Key="SidebarCornerRadius">0,0,0,10</CornerRadius>

  <!-- ─── Decorative ───────────────────────────────────────────────────── -->
  <CornerRadius x:Key="IconCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="AppLogoCornerRadius">12</CornerRadius>
  <CornerRadius x:Key="SplashIconCornerRadius">20</CornerRadius>

</ResourceDictionary>

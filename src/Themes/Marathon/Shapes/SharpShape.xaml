<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       SHAPE PROFILE — Sharp (Brutalist / Flat)
       Zero-tolerance aesthetic.
       No radii · Hard corners · Raw brutalist feel.
  ═══════════════════════════════════════════════════════════════════════ -->

  <!-- ─── Semantic scale ───────────────────────────────────────────────── -->
  <CornerRadius x:Key="RadiusXs">0</CornerRadius>
  <CornerRadius x:Key="RadiusSm">0</CornerRadius>
  <CornerRadius x:Key="RadiusMd">0</CornerRadius>
  <CornerRadius x:Key="RadiusLg">0</CornerRadius>

  <!-- ─── Compat aliases ───────────────────────────────────────────────── -->
  <CornerRadius x:Key="XSmallCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="SmallCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="MediumCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="LargeCornerRadius">0</CornerRadius>

  <!-- ─── Component-specific ───────────────────────────────────────────── -->
  <CornerRadius x:Key="ControlCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="CardCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="NavItemCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="BadgeCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="OverlayCornerRadius">0</CornerRadius>

  <!-- ─── Window chrome ────────────────────────────────────────────────── -->
  <CornerRadius x:Key="WindowCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="TitleBarCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="SidebarCornerRadius">0</CornerRadius>

  <!-- ─── Decorative ───────────────────────────────────────────────────── -->
  <CornerRadius x:Key="IconCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="AppLogoCornerRadius">0</CornerRadius>
  <CornerRadius x:Key="SplashIconCornerRadius">0</CornerRadius>

</ResourceDictionary>

<Window x:Class="OrderLog.Views.Marathon.SampleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Marathon Sample" Height="520" Width="820"
        WindowStartupLocation="CenterOwner">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="../../Themes/Marathon/MarathonTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <TextBlock FontFamily="{StaticResource FontMono}" FontSize="18" Text="MARATHON UI" Foreground="{StaticResource PrimaryBrush}"/>
      <Button Style="{StaticResource MarathonPrimaryButton}" Content="Primary Action"/>
    </StackPanel>

    <Border Grid.Row="1" Style="{StaticResource MarathonCard}" Margin="0,16,0,0">
      <StackPanel>
        <TextBlock FontFamily="{StaticResource FontMono}" FontSize="14" Text="Card Title"/>
        <TextBlock Foreground="{StaticResource TextBrush}" Margin="0,8,0,0">This is a sample card using the Marathon theme tokens. Extend the theme files in /Themes/Marathon to add more components and resources.</TextBlock>
      </StackPanel>
    </Border>

  </Grid>
</Window>